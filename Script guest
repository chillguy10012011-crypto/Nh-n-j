-- // 6. VÒNG LẶP LOGIC VÀ TÍNH NĂNG ESP
local camera = Workspace.CurrentCamera

-- TRACER & BOX DRAWING VIA DRAWING API OR GUIS
local espFolder = Instance.new("Folder")
espFolder.Name = "ESP_Container"
espFolder.Parent = ScreenGui

RunService.RenderStepped:Connect(function()
    -- 1. AIM TARGET
    if AimTargetToggle and selectedPlayer and selectedPlayer.Character and selectedPlayer.Character:FindFirstChild("HumanoidRootPart") then
        camera.CFrame = CFrame.new(camera.CFrame.Position, selectedPlayer.Character.HumanoidRootPart.Position)
    end

    -- 2. AIM CLOSEST
    if AimClosestToggle and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myHrp = LocalPlayer.Character.HumanoidRootPart
        local closestChar = nil
        local shortestDist = math.huge

        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (p.Character.HumanoidRootPart.Position - myHrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestChar = p.Character.HumanoidRootPart
                end
            end
        end

        if closestChar then
            camera.CFrame = CFrame.new(camera.CFrame.Position, closestChar.Position)
        end
    end

    -- 3. HIGHLIGHT
    if HighlightToggle then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character then
                local hl = p.Character:FindFirstChild("ClientHighlight")
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "ClientHighlight"
                    hl.Parent = p.Character
                end
                if p == LocalPlayer then
                    hl.FillColor = Color3.fromRGB(0, 170, 255) -- Xanh biển cho bản thân
                else
                    hl.FillColor = Color3.fromRGB(255, 0, 0)   -- Đỏ cho người khác
                end
            end
        end
    end

    -- 4. SHOW NAME
    if ShowNameToggle then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                local head = p.Character.Head
                local tag = head:FindFirstChild("NameTag")
                if not tag then
                    tag = Instance.new("BillboardGui")
                    tag.Name = "NameTag"
                    tag.Size = UDim2.new(0, 100, 0, 30)
                    tag.StudsOffset = Vector3.new(0, 2, 0)
                    tag.AlwaysOnTop = true
                    tag.Parent = head

                    local txt = Instance.new("TextLabel")
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.Text = p.DisplayName .. "\n(@" .. p.Name .. ")"
                    txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                    txt.TextStrokeTransparency = 0
                    txt.Font = Enum.Font.SourceSansBold
                    txt.TextSize = 12
                    txt.Parent = tag
                end
            end
        end
    end

    -- 5. BOX ESP & TRACERS (GUI BASED)
    espFolder:ClearAllChildren()
    if BoxEspToggle then
        local viewportSize = camera.ViewportSize
        local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = p.Character.HumanoidRootPart
                local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)

                if onScreen then
                    -- Tracer Line
                    local lineFrame = Instance.new("Frame")
                    local startPos = screenCenter
                    local targetPos = Vector2.new(pos.X, pos.Y)
                    local distance = (targetPos - startPos).Magnitude
                    local angle = math.atan2(targetPos.Y - startPos.Y, targetPos.X - startPos.X)

                    lineFrame.Size = UDim2.new(0, distance, 0, 1)
                    lineFrame.Position = UDim2.new(0, startPos.X, 0, startPos.Y)
                    lineFrame.Rotation = math.deg(angle)
                    lineFrame.AnchorPoint = Vector2.new(0, 0.5)
                    lineFrame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                    lineFrame.BorderSizePixel = 0
                    lineFrame.Parent = espFolder

                    -- Box ESP
                    local boxSize = Vector2.new(2000 / pos.Z, 3000 / pos.Z)
                    local boxFrame = Instance.new("Frame")
                    boxFrame.Size = UDim2.new(0, boxSize.X, 0, boxSize.Y)
                    boxFrame.Position = UDim2.new(0, pos.X - boxSize.X / 2, 0, pos.Y - boxSize.Y / 2)
                    boxFrame.BackgroundTransparency = 1
                    boxFrame.BorderColor3 = Color3.fromRGB(255, 0, 0)
                    boxFrame.BorderSizePixel = 1.5
                    boxFrame.Parent = espFolder
                end
            end
        end
    end
end)

