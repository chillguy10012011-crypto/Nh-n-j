-- // VÒNG LẶP RENDERSTEPPED CẬP NHẬT TẤT CẢ CHỨC NĂNG
RunService.RenderStepped:Connect(function()
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local cam = Workspace.CurrentCamera

    -- 1. AIM TARGET
    if aimTargetToggle and selectedPlayer and selectedPlayer.Character and selectedPlayer.Character:FindFirstChild("HumanoidRootPart") then
        cam.CFrame = CFrame.new(cam.CFrame.Position, selectedPlayer.Character.HumanoidRootPart.Position)
    end

    -- 2. AIM NEAREST
    if aimNearestToggle and myHrp then
        local closestHrp = nil
        local shortestDist = math.huge

        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (p.Character.HumanoidRootPart.Position - myHrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestHrp = p.Character.HumanoidRootPart
                end
            end
        end

        if closestHrp then
            cam.CFrame = CFrame.new(cam.CFrame.Position, closestHrp.Position)
        end
    end

    -- 3. HIGHLIGHT
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then
            local hl = p.Character:FindFirstChild("ClientHighlight")
            if highlightToggle then
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "ClientHighlight"
                    hl.Parent = p.Character
                end
                if p == LocalPlayer then
                    hl.FillColor = Color3.fromRGB(0, 170, 255) -- Xanh biển cho bản thân
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                else
                    hl.FillColor = Color3.fromRGB(255, 0, 0)     -- Đỏ cho người chơi khác
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                end
            else
                if hl then hl:Destroy() end
            end
        end
    end

    -- 4. TRACERS
    tracersFolder:ClearAllChildren()
    if tracersToggle and myHrp then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local targetHrp = p.Character.HumanoidRootPart
                local screenPos, onScreen = cam:WorldToViewportPoint(targetHrp.Position)

                if onScreen then
                    local line = Instance.new("Frame")
                    line.BorderSizePixel = 0
                    line.BackgroundColor3 = Color3.fromRGB(255, 0, 0)

                    local startPos = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                    local endPos = Vector2.new(screenPos.X, screenPos.Y)
                    local distance = (endPos - startPos).Magnitude

                    line.Size = UDim2.new(0, distance, 0, 1.5)
                    line.Position = UDim2.new(0, startPos.X, 0, startPos.Y)
                    line.AnchorPoint = Vector2.new(0, 0.5)
                    line.Rotation = math.deg(math.atan2(endPos.Y - startPos.Y, endPos.X - startPos.X))
                    line.Parent = tracersFolder
                end
            end
        end
    end

    -- 5. SHOW NAME
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
            local head = p.Character.Head
            local bb = head:FindFirstChild("ClientNameTag")

            if showNameToggle then
                if not bb then
                    bb = Instance.new("BillboardGui")
                    bb.Name = "ClientNameTag"
                    bb.Size = UDim2.new(0, 200, 0, 30)
                    bb.StudsOffset = Vector3.new(0, 2, 0)
                    bb.AlwaysOnTop = true

                    local txt = Instance.new("TextLabel")
                    txt.Name = "NameLabel"
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                    txt.TextStrokeTransparency = 0
                    txt.Font = Enum.Font.SourceSansBold
                    txt.TextSize = 14
                    txt.Parent = bb

                    bb.Parent = head
                end
                bb.NameLabel.Text = p.DisplayName .. " (@" .. p.Name .. ")"
            else
                if bb then bb:Destroy() end
            end
        end
    end
end)
