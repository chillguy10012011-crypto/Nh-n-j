-- CORE AIMLOCK LOGIC
local function GetClosestTarget()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closestPlayer = nil
    local shortestDistance = Config.FovRadius

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local part = player.Character:FindFirstChild(Config.TargetPart) or player.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    -- Kiểm tra che khuất (Raycast visibility check)
                    local raycastParams = RaycastParams.new()
                    raycastParams.FilterType = RaycastFilterType.Exclude
                    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, player.Character}
                    
                    local rayResult = Workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, raycastParams)
                    
                    if not rayResult then -- Không bị vật cản/tường chắn
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if dist < shortestDistance then
                            shortestDistance = dist
                            closestPlayer = player
                        end
                    end
                end
            end
        end
    end
    return closestPlayer
end

-- RenderStepped Update Loop
RunService.RenderStepped:Connect(function()
    -- Cập nhật tâm FOV theo giữa màn hình (Shiftlock center)
    local centerScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Position = centerScreen

    if not Config.AimlockEnabled then return end

    -- Quản lý thời gian Khóa Target
    if CurrentTarget then
        -- Kiểm tra điều kiện sống / khoảng thời gian khóa
        local char = CurrentTarget.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local isExpired = (tick() - LockStartTime) > Config.LockDuration

        if not char or not hum or hum.Health <= 0 or isExpired then
            CurrentTarget = nil
            FOVCircle.Color = Color3.fromRGB(0, 255, 0) -- Trở lại Xanh lá
        end
    end

    -- Tìm mục tiêu mới nếu chưa có
    if not CurrentTarget then
        local target = GetClosestTarget()
        if target then
            CurrentTarget = target
            LockStartTime = tick()
        end
    end

    -- Khóa và Xử lý Aim/Prediction
    if CurrentTarget and CurrentTarget.Character then
        local targetPart = CurrentTarget.Character:FindFirstChild(Config.TargetPart) or CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
        
        if targetPart then
            -- Đổi màu FOV sang ĐỎ báo hiệu đang trong tâm khóa
            FOVCircle.Color = Color3.fromRGB(255, 0, 0)

            -- Tính toán Vận tốc & Lead Prediction
            local predictedPos = targetPart.Position
            if Config.PredictionEnabled then
                local velocity = targetPart.AssemblyLinearVelocity or targetPart.Velocity
                predictedPos = targetPart.Position + (velocity * Config.PredictionFactor)
            end

            -- Điều hướng Camera / Shiftlock
            local targetCFrame = CFrame.new(Camera.CFrame.Position, predictedPos)
            if Config.SmoothnessEnabled then
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Config.SmoothnessAmount)
            else
                Camera.CFrame = targetCFrame
            end
        end
    else
        FOVCircle.Color = Color3.fromRGB(0, 255, 0) -- Màu xanh lá mặc định khi không tìm thấy target
    end
end)
