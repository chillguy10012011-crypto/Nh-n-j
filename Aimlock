-- Helper Tạo TextBox/Option trong Settings
local function CreateSettingInput(label, defaultVal, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -5, 0, 32)
    frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Parent = frame
    stroke.Color = Color3.fromRGB(255, 0, 50)
    stroke.Thickness = 1.2

    local lbl = Instance.new("TextLabel")
    lbl.Parent = frame
    lbl.Size = UDim2.new(0.6, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = " " .. label
    lbl.TextColor3 = Color3.fromRGB(10, 10, 10)
    lbl.Font = Enum.Font.SourceSansBold
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local box = Instance.new("TextBox")
    box.Parent = frame
    box.Size = UDim2.new(0.38, -5, 0.8, 0)
    box.Position = UDim2.new(0.6, 0, 0.1, 0)
    box.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
    box.Text = tostring(defaultVal)
    box.TextColor3 = Color3.fromRGB(0, 0, 0)
    box.Font = Enum.Font.SourceSansBold
    box.TextSize = 13

    box.FocusLost:Connect(function()
        callback(box.Text)
    end)

    frame.Parent = SettingsPanel
    return box
end

local function CreateSettingToggle(label, defaultState, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -5, 0, 32)
    frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Parent = frame
    stroke.Color = Color3.fromRGB(255, 0, 50)
    stroke.Thickness = 1.2

    local btn = Instance.new("TextButton")
    btn.Parent = frame
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = label .. ": " .. (defaultState and "ON" or "OFF")
    btn.TextColor3 = Color3.fromRGB(10, 10, 10)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13

    local state = defaultState
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = label .. ": " .. (state and "ON" or "OFF")
        callback(state)
    end)

    frame.Parent = SettingsPanel
end

