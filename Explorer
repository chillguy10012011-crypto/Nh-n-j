-- Hàm cập nhật danh sách các vật thể trong Game
local function refreshExplorer()
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end

	local function addInstanceTree(parentInstance, depth)
		for _, child in ipairs(parentInstance:GetChildren()) do
			local itemLabel = Instance.new("TextLabel")
			itemLabel.Size = UDim2.new(1, 0, 0, 20)
			itemLabel.BackgroundTransparency = 1
			itemLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
			itemLabel.TextXAlignment = Enum.TextXAlignment.Left
			itemLabel.Font = Enum.Font.SourceSans
			itemLabel.TextSize = 13
			
			local indent = string.rep("   ", depth)
			itemLabel.Text = indent .. "📄 " .. child.Name .. " (" .. child.ClassName .. ")"
			itemLabel.Parent = scrollFrame
			
			-- Duyệt tiếp các vật thể con bên trong (tối đa 2 cấp độ để tránh lag)
			if depth < 2 then
				addInstanceTree(child, depth + 1)
			end
		end
	end

	-- Thêm các thư mục gốc chính của Game
	local mainServices = {game.Workspace, game.Players, game.Lighting, game.ReplicatedStorage}
	for _, service in ipairs(mainServices) do
		local serviceLabel = Instance.new("TextLabel")
		serviceLabel.Size = UDim2.new(1, 0, 0, 22)
		serviceLabel.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		serviceLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
		serviceLabel.TextXAlignment = Enum.TextXAlignment.Left
		serviceLabel.Font = Enum.Font.SourceSansBold
		serviceLabel.TextSize = 14
		serviceLabel.Text = " 📁 " .. service.Name
		serviceLabel.Parent = scrollFrame
		
		addInstanceTree(service, 1)
	end
	
	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, uiListLayout.AbsoluteContentSize.Y)
end

-- Xử lý sự kiện Ẩn/Hiện Menu chính
toggleButton.MouseButton1Click:Connect(function()
	mainFrame.Visible = not mainFrame.Visible
end)

-- Xử lý sự kiện Bật/Tắt Explorer
explorerButton.MouseButton1Click:Connect(function()
	explorerFrame.Visible = not explorerFrame.Visible
	if explorerFrame.Visible then
		refreshExplorer()
	end
end)
