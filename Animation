--StarterCharacter
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local torso = character:WaitForChild("Torso")
local rootPart = character:WaitForChild("HumanoidRootPart")
-- Tắt kịch bản hoạt họa di chuyển mặc định của hệ thống Roblox
local animateScript = character:FindFirstChild("Animate")
if animateScript then
animateScript.Disabled = true
end
-- Lấy các Motor6D chính của R6
local joints = {
["Left Shoulder"] = torso:WaitForChild("Left Shoulder"),
["Left Hip"] = torso:WaitForChild("Left Hip"),
["RootJoint"] = rootPart:WaitForChild("RootJoint"),
["Neck"] = torso:WaitForChild("Neck"),
["Right Hip"] = torso:WaitForChild("Right Hip"),
["Right Shoulder"] = torso:WaitForChild("Right Shoulder")
}
-- Lưu trữ giá trị C0 gốc ban đầu để đưa nhân vật về thế đứng idle mượt mà khi dừng lại
local Original_C0 = {}
for name, joint in pairs(joints) do
Original_C0[name] = joint.C0
end
