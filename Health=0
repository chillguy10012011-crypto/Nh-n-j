local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local function enableZeroHealthWalk(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if not humanoid then return end

    -- Vô hiệu hóa hoàn toàn trạng thái Dead để không bị Respawn hay té ngã[span_1](start_span)[span_1](end_span)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)

    -- Khóa giữ WalkSpeed và JumpPower không bị reset về 0 khi cạn máu
    local defaultSpeed = 16
    local defaultJump = 50

    -- Lắng nghe sự thay đổi máu liên tục
    humanoid.HealthChanged:Connect(function(health)
        if health <= 0 then
            -- Ép thanh máu giữ mốc 0[span_2](start_span)[span_2](end_span)
            humanoid.Health = 0
            
            -- Đảm bảo nhân vật vẫn giữ được khả năng di chuyển
            humanoid.WalkSpeed = defaultSpeed
            humanoid.JumpPower = defaultJump
            humanoid.PlatformStand = false
        end
    end)

    -- Đảm bảo nhân vật duy trì trạng thái đứng thẳng
    RunService.Stepped:Connect(function()
        if humanoid.Health <= 0 then
            humanoid.Health = 0
            if humanoid:GetState() == Enum.HumanoidStateType.Dead then
                humanoid:ChangeState(Enum.HumanoidStateType.Running)
            end
        end
    end)
end

-- Áp dụng cho Character hiện tại
if LocalPlayer.Character then
    enableZeroHealthWalk(LocalPlayer.Character)
end

-- Áp dụng khi nhân vật mới xuất hiện (Respawn)
LocalPlayer.CharacterAdded:Connect(enableZeroHealthWalk)
