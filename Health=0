local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local function keepZeroHealthNoRespawn(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if not humanoid then return end

    -- Tắt tự động hồi máu nếu game có hệ thống hồi máu mặc định
    humanoid.HealthChanged:Connect(function(health)
        if health <= 0 then
            -- Giữ cố định máu ở mức 0 mà không để trạng thái bị Reset
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            
            -- Đặt thuộc tínhBreakJointsOnDeath để nhân vật không bị rã các bộ phận
            character:BreakJoints() -- Bạn có thể bỏ dòng này nếu muốn giữ nguyên dáng đứng
            
            -- Khóa không cho Humanoid chuyển sang dạng chết của Roblox
            humanoid.Health = 0
        end
    end)
end

-- Áp dụng cho Character hiện tại
if LocalPlayer.Character then
    keepZeroHealthNoRespawn(LocalPlayer.Character)
end

-- Áp dụng khi Character mới xuất hiện
LocalPlayer.CharacterAdded:Connect(keepZeroHealthNoRespawn)
