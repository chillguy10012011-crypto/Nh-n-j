local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function disableClientRespawn(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end

    -- Vô hiệu hóa tính năng Reset character từ Menu Roblox
    local SetCore = function()
        pcall(function()
            game:GetService("StarterGui"):SetCore("ResetButtonCallback", false)
        end)
    end
    SetCore()

    -- Ngắt trạng thái Dead và khóa chuyển trạng thái
    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    
    -- Giữ máu ở 0 nhưng liên tục ép trạng thái di chuyển (Running)
    hum.HealthChanged:Connect(function()
        if hum.Health <= 0 then
            hum.Health = 0
            hum:ChangeState(Enum.HumanoidStateType.Running)
            hum.WalkSpeed = 16
            hum.JumpPower = 50
        end
    end)
end

if LocalPlayer.Character then disableClientRespawn(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(disableClientRespawn)
