-- LOGIC XỬ LÝ LÁCH LUẬT THÔNG MINH (CHO CẢ VIỆT & ANH)
---------------------------------------------------------

-- Bảng thay thế các từ nhạy cảm (Cả tiếng Anh và tiếng Việt thường dùng)
local wordReplacements = {
    -- Mạng xã hội & Liên lạc quốc tế (Tiếng Anh)
    ["tiktok"]      = "tikt0k",
    ["youtube"]     = "y0utub3",
    ["discord"]     = "disc0rd",
    ["telegram"]    = "t3l3gram",
    ["facebook"]    = "f4ceb00k",
    ["instagram"]   = "1nstagram",
    ["whatsapp"]    = "whats4pp",
    ["snapchat"]    = "sn4pchat",
    ["robu[x]*"]    = "r0bux",
    
    -- Tiếng Việt phổ biến
    ["zalo"]        = "z4l0",
    ["sdt"]         = "s.d.t",
    ["fb"]          = "f.b",
}

local function processMessage(msg)
    local newMsg = msg
    
    -- Tự động đổi các từ trong danh sách cấm sang dạng an toàn
    for target, replacement in pairs(wordReplacements) do
        newMsg = string.gsub(newMsg, "(?i)" .. target, replacement)
    end
    
    -- Nếu người nước ngoài nhắn các link hoặc từ bị dính dấu #, 
    -- script sẽ tự chèn khoảng trắng ngắt nhịp nhẹ để lọt qua bộ lọc mà người đọc vẫn hiểu được.
    return newMsg
end

-- Gửi tin nhắn vào game
local function sendBypassChat(message)
    if message == "" or message:find("^%s*$") then return end
    
    local finalMessage = processMessage(message)
    
    -- Xử lý TextChatService (Hệ thống chat mới)
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if generalChannel then
            generalChannel:SendAsync(finalMessage)
        end
    else
        -- Xử lý Legacy Chat (Hệ thống chat cũ)
        local defaultChat = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if defaultChat then
            local sayMessage = defaultChat:FindFirstChild("SayMessageRequest")
            if sayMessage then
                sayMessage:FireServer(finalMessage, "All")
            end
        end
    end
    
    textBox.Text = ""
end

-- Sự kiện bấm nút Gửi
sendButton.MouseButton1Click:Connect(function()
    sendBypassChat(textBox.Text)
end)

-- Sự kiện nhấn Enter (Bàn phím PC)
textBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        sendBypassChat(textBox.Text)
    end
end)
