-- [[ EZHUB V1 - PART 2/4: AUTO FARM, STATS, LOOT/SHOP, TELEPORT & ESP ]] --
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

local function attachGameplayModules(EzhubCore)
	local Gameplay = {}

	-- Các mốc vị trí tham khảo theo từng Sea (có thể mở rộng thêm theo map thực tế)
