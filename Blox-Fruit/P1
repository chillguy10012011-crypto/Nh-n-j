local CONFIG_FILE = CONFIG_FOLDER .. "/config_latest.json"
local VISITED_SERVERS_FILE = CONFIG_FOLDER .. "/visited_servers.json"

local EzhubCore = {}
EzhubCore.Threads = {}
EzhubCore.Signals = {}
EzhubCore.Logs = {}
EzhubCore.ToastCallback = nil
EzhubCore.IsPausedByHP = false
EzhubCore.SavedModesBeforeHP = {}
EzhubCore.VisitedServers = {}

-- Cấu hình đầy đủ theo 60 câu hỏi đã chốt
EzhubCore.DefaultConfig = {
	-- Farm & Combat
	AutoFarm = false,
	AutoFarmTargetType = "Mob", -- "Mob" | "Boss"
	AutoStats = false,
	StatBranch = "Melee", -- "Melee" | "Defense" | "Sword" | "Gun" | "Fruit"
	StatPointsPerStep = 1,
	AutoLoot = false,
	AutoBuyBasicItems = false,
	AutoBuyFruit = false,

	-- Teleport
	SelectedSeaTarget = "",
	SavedPosition = nil, -- {x, y, z}

	-- ESP / Visual
	EspPlayer = false,
	EspMobBoss = false,
	EspLootIsland = false,
	EspRefreshOnRespawnJoin = true,
	EspScanInterval = 0.35,

	-- Đai 1-8, Đảo Rồng & Dragon Storm
	BeltQuestEnabled = false,
	BeltTargetStage = "Auto", -- "Auto" hoặc 1..8
	AutoPatrolDragonIsland = false,
	DragonScanInterval = 0.45,
	AutoInteractMission = false,
	AutoClearPathMobs = false,
	DragonStormQuestEnabled = false,

	-- Performance & AFK
	PotatoGraphics = false,
	RestoreEffectsRequested = false,
	AutoHeavyCullInEventSea = true,
	AntiAfk = true,

	-- Server & Reconnect
	AutoReconnect = true,
