local function attachPerfServerAndGui(EzhubCore, Gameplay, DragonBelt)
	local PerfAndGui = {}

	-- Lưu snapshot gốc của đồ họa để có thể khôi phục khi bấm nút khôi phục hiệu ứng
	local SavedLightingState = {
		GlobalShadows = Lighting.GlobalShadows,
		FogEnd = Lighting.FogEnd,
		FogStart = Lighting.FogStart,
		Brightness = Lighting.Brightness,
		EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
		EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
		Captured = false,
	}
	local HiddenEffectInstances = {} -- { [Instance] = { Enabled = bool } }

	local function captureOriginalGraphicsOnce()
		if SavedLightingState.Captured then
			return
		end
		SavedLightingState.GlobalShadows = Lighting.GlobalShadows
		SavedLightingState.FogEnd = Lighting.FogEnd
		SavedLightingState.FogStart = Lighting.FogStart
		SavedLightingState.Brightness = Lighting.Brightness
		SavedLightingState.EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale
		SavedLightingState.EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale
		SavedLightingState.Captured = true
	end

	local function isSeaEventHeavy()
		local eventScore = 0
		for _, obj in ipairs(Workspace:GetChildren()) do
			local lower = string.lower(obj.Name)
			if string.find(lower, "event", 1, true)
				or string.find(lower, "sea", 1, true)
				or string.find(lower, "ship", 1, true)
				or string.find(lower, "terror", 1, true)
				or string.find(lower, "leviathan", 1, true)
				or string.find(lower, "dragon", 1, true)
			then
				eventScore += 1
			end
		end
		local particleCount = 0
		for _, desc in ipairs(Workspace:GetDescendants()) do
			if desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") then
				particleCount += 1
				if particleCount > 180 then
					break
				end
			end
		end
		return (eventScore >= 2) or (particleCount >= 140)
	end

	function PerfAndGui.ApplyPotatoGraphics(heavyEventMode)
		captureOriginalGraphicsOnce()
		EzhubCore.Config.PotatoGraphics = true
		EzhubCore.Config.RestoreEffectsRequested = false

		pcall(function()
			Lighting.GlobalShadows = false
			Lighting.FogEnd = heavyEventMode and 450 or 900
			Lighting.FogStart = 120
			Lighting.Brightness = 1
			Lighting.EnvironmentSpecularScale = 0
			Lighting.EnvironmentDiffuseScale = 0
		end)

		local isCharDescendant = function(inst)
			local char = LocalPlayer.Character
			return char and inst:IsDescendantOf(char)
		end

		for _, desc in ipairs(Workspace:GetDescendants()) do
			if not isCharDescendant(desc) then
				if desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") or desc:IsA("Fire") or desc:IsA("Smoke") or desc:IsA("Sparkles") then
					if HiddenEffectInstances[desc] == nil then
						HiddenEffectInstances[desc] = { Enabled = desc.Enabled }
					end
					pcall(function()
						desc.Enabled = false
					end)
				elseif heavyEventMode and (desc:IsA("Decal") or desc:IsA("Texture")) then
					if HiddenEffectInstances[desc] == nil then
						HiddenEffectInstances[desc] = { Enabled = desc.Transparency }
					end
					pcall(function()
						desc.Transparency = 1
					end)
				elseif heavyEventMode and desc:IsA("BasePart") then
					pcall(function()
						desc.Material = Enum.Material.SmoothPlastic
						desc.CastShadow = false
					end)
				end
			end
		end

		if heavyEventMode then
			EzhubCore.Notify("Potato GFX", "Vùng biển đông sự kiện — Đã tự kích hoạt giảm tải nặng.")
		else
			EzhubCore.Notify("Potato GFX", "Đã bật chế độ đồ họa khoai tây tối ưu FPS.")
		end
	end

	-- Nút khôi phục / bật lại hiệu ứng hiển thị khi cần quan sát rõ
	function PerfAndGui.RestoreVisualEffects()
		captureOriginalGraphicsOnce()
		EzhubCore.Config.RestoreEffectsRequested = true
		EzhubCore.Config.PotatoGraphics = false

		pcall(function()
			Lighting.GlobalShadows = SavedLightingState.GlobalShadows
			Lighting.FogEnd = SavedLightingState.FogEnd
			Lighting.FogStart = SavedLightingState.FogStart
			Lighting.Brightness = SavedLightingState.Brightness
			Lighting.EnvironmentSpecularScale = SavedLightingState.EnvironmentSpecularScale
			Lighting.EnvironmentDiffuseScale = SavedLightingState.EnvironmentDiffuseScale
		end)

		for inst, prev in pairs(HiddenEffectInstances) do
			if inst and inst.Parent then
				pcall(function()
					if typeof(prev.Enabled) == "boolean" then
						inst.Enabled = prev.Enabled
					elseif typeof(prev.Enabled) == "number" then
						inst.Transparency = prev.Enabled
					end
				end)
			end
			HiddenEffectInstances[inst] = nil
		end

		EzhubCore.SaveConfig()
		EzhubCore.Notify("Visuals", "Đã khôi phục hiệu ứng hiển thị để quan sát rõ hơn.")
	end

	-- Luồng đồ họa khoai tây & tự giảm tải vùng biển nhiều sự kiện
	EzhubCore.RegisterThread("PotatoGraphicsLoop", function(isAlive)
		if EzhubCore.Config.RestoreEffectsRequested and not EzhubCore.Config.PotatoGraphics then
			task.wait(0.5)
			return
		end

		local heavySea = EzhubCore.Config.AutoHeavyCullInEventSea and isSeaEventHeavy()
		if EzhubCore.Config.PotatoGraphics or heavySea then
			PerfAndGui.ApplyPotatoGraphics(heavySea)
		end

		task.wait(2.5)
	end)

