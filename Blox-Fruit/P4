	-- Helpers tạo Toggle & Action Button nhanh
	local function addToggle(parent, labelText, configKey, onChanged)
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 32)
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 11
		btn.Parent = parent
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

		local function refreshVisual()
			local active = EzhubCore.Config[configKey] == true
			btn.BackgroundColor3 = active and Color3.fromRGB(0, 95, 90) or Color3.fromRGB(25, 31, 46)
			btn.TextColor3 = active and Color3.fromRGB(120, 255, 225) or Color3.fromRGB(210, 220, 235)
			btn.Text = string.format("%s: %s", labelText, active and "BẬT" or "TẮT")
		end

		refreshVisual()
		btn.MouseButton1Click:Connect(function()
			local nextVal = not (EzhubCore.Config[configKey] == true)
			if nextVal and EzhubCore.Config.EmergencyStopAll then
				EzhubCore.ResumeFromEmergencyStop()
			end
			EzhubCore.Config[configKey] = nextVal
			EzhubCore.SaveConfig()
			refreshVisual()
			if typeof(onChanged) == "function" then
				onChanged(nextVal)
			end
		end)
		return btn
	end

	local function addActionButton(parent, labelText, accentColor, callback)
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 32)
		btn.BackgroundColor3 = accentColor or Color3.fromRGB(32, 48, 82)
		btn.TextColor3 = Color3.fromRGB(245, 250, 255)
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 11
		btn.Text = labelText
		btn.Parent = parent
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
		btn.MouseButton1Click:Connect(function()
			pcall(callback)
		end)
		return btn
	end

	-- Khởi tạo các Tab chính
	addTabButton("Farm & Stats", "Farm")
	addTabButton("Đai / Rồng / Storm", "DragonBelt")
	addTabButton("Teleport & ESP", "TeleEsp")
	addTabButton("GFX / Server / Config", "PerfServer")

	local pFarm = createPage("Farm")
	local pDragon = createPage("DragonBelt")
	local pTeleEsp = createPage("TeleEsp")
	local pPerf = createPage("PerfServer")

	-- Trang 1: Farm, Stats, Loot & Shop
	addToggle(pFarm, "Auto Farm Mục Tiêu", "AutoFarm")
	addActionButton(pFarm, "Đổi Mục Tiêu Farm (Mob / Boss)", Color3.fromRGB(36, 46, 72), function()
		EzhubCore.Config.AutoFarmTargetType = (EzhubCore.Config.AutoFarmTargetType == "Boss") and "Mob" or "Boss"
		EzhubCore.SaveConfig()
		EzhubCore.Notify("Auto Farm", "Chế độ mục tiêu: " .. EzhubCore.Config.AutoFarmTargetType)
	end)
	addToggle(pFarm, "Auto Stats (Theo Nhánh & Điểm)", "AutoStats")
	addActionButton(pFarm, "Đổi Nhánh Stat (Melee/Def/Sword/Gun/Fruit)", Color3.fromRGB(36, 46, 72), function()
		local order = { "Melee", "Defense", "Sword", "Gun", "Fruit" }
		local cur = EzhubCore.Config.StatBranch
		local nextIdx = 1
		for i, v in ipairs(order) do
			if v == cur then
				nextIdx = (i % #order) + 1
				break
			end
		end
		EzhubCore.Config.StatBranch = order[nextIdx]
		EzhubCore.SaveConfig()
		EzhubCore.Notify("Auto Stats", "Nhánh hiện tại: " .. EzhubCore.Config.StatBranch)
	end)
	addToggle(pFarm, "Tự Động Nhặt Item", "AutoLoot")
	addToggle(pFarm, "Tự Mua Vật Phẩm Cơ Bản", "AutoBuyBasicItems")
	addToggle(pFarm, "Tự Động Mua Trái Ác Quỷ", "AutoBuyFruit")

	-- Trang 2: Chuỗi Đai 1-8, Tuần tra Đảo Rồng, Tương tác, Dọn cản & Dragon Storm
	addToggle(pDragon, "Tuần Tra Vòng Vòng Săn Đảo Rồng", "AutoPatrolDragonIsland")
	addToggle(pDragon, "Chuỗi Lấy Đai 1-8", "BeltQuestEnabled")
	addToggle(pDragon, "Chuỗi Lấy Dragon Storm", "DragonStormQuestEnabled")
	addToggle(pDragon, "Tự Tương Tác / Nhận Nhiệm Vụ", "AutoInteractMission")
	addToggle(pDragon, "Tự Đánh / Dọn Mục Tiêu Cản Đường", "AutoClearPathMobs")
	addActionButton(pDragon, "Dò Tìm Đảo Rồng Ngay Lập Tức", Color3.fromRGB(28, 76, 110), function()
		local info = DragonBelt.FindDragonIsland()
		if info then
			EzhubCore.Notify("Dragon Island", "Phát hiện Đảo Rồng: " .. info.Model.Name)
		else
			EzhubCore.Notify("Dragon Island", "Chưa thấy Đảo Rồng trong phạm vi quét.")
		end
	end)

	-- Trang 3: Teleport & ESP (kèm làm mới ESP Player khi Respawn / Join)
	addActionButton(pTeleEsp, "Dịch Chuyển Tới Điểm Đã Chọn (Sea Hiện Tại)", Color3.fromRGB(32, 64, 96), function()
		Gameplay.TeleportToSelectedTarget()
	end)
	addActionButton(pTeleEsp, "Chuyển Sea Tiếp Theo (Khi Đủ Điều Kiện)", Color3.fromRGB(32, 64, 96), function()
		Gameplay.TravelToNextSeaIfEligible()
	end)
	addActionButton(pTeleEsp, "Lưu Vị Trí Hiện Tại (Save Position)", Color3.fromRGB(45, 55, 85), function()
		Gameplay.SaveCurrentPosition()
	end)
	addActionButton(pTeleEsp, "Dịch Chuyển Về Vị Trí Đã Lưu", Color3.fromRGB(45, 55, 85), function()
		Gameplay.TeleportToSavedPosition()
	end)
	addToggle(pTeleEsp, "ESP Player (Tự Làm Mới Respawn/Join)", "EspPlayer")
	addToggle(pTeleEsp, "ESP Boss / Mob", "EspMobBoss")
	addToggle(pTeleEsp, "ESP Fruit / Island", "EspLootIsland")

	-- Trang 4: Đồ họa khoai tây, Khôi phục hiệu ứng, Chống AFK, Server Hop/Reconnect, Stop All & Config
	addToggle(pPerf, "Đồ Họa Khoai Tây (Tối Ưu FPS)", "PotatoGraphics", function(enabled)
		if enabled then
			PerfAndGui.ApplyPotatoGraphics(isSeaEventHeavy())
		else
			PerfAndGui.RestoreVisualEffects()
		end
	end)
	addActionButton(pPerf, "Khôi Phục / Bật Lại Hiệu Ứng Hiển Thị", Color3.fromRGB(25, 92, 74), function()
		PerfAndGui.RestoreVisualEffects()
	end)
	addToggle(pPerf, "Tự Giảm Tải Vùng Biển Nhiều Sự Kiện", "AutoHeavyCullInEventSea")
	addToggle(pPerf, "Chống AFK (Anti-AFK)", "AntiAfk")
	addToggle(pPerf, "Tự Kết Nối Lại (Auto Reconnect)", "AutoReconnect")
	addToggle(pPerf, "Tránh Vào Lặp Server Đã Ghé", "AvoidVisitedServers")
	addToggle(pPerf, "Tự Bật Lại Cấu Hình Sau Khi Đổi Server", "AutoRestoreModesAfterHop")
	addActionButton(pPerf, "Server Hop (Tìm Server Ít Người)", Color3.fromRGB(68, 42, 110), function()
		PerfAndGui.HopToLowPopulationServer()
	end)
	addActionButton(pPerf, "Lưu Nhanh Cấu Hình (Save Config)", Color3.fromRGB(30, 75, 105), function()
		EzhubCore.SaveConfig("quick")
	end)
	addActionButton(pPerf, "Tải Cấu Hình Nhanh (Load Config)", Color3.fromRGB(30, 75, 105), function()
		EzhubCore.LoadConfig("quick")
	end)
	addActionButton(pPerf, "STOP ALL (Dừng Khẩn Cấp Toàn Bộ)", Color3.fromRGB(130, 26, 42), function()
		EzhubCore.StopAllActiveModes()
	end)

	selectPage("Farm")
	EzhubCore.Notify("System", "Đã khởi tạo hoàn tất Ezhub v1 (4/4 module).")

	return PerfAndGui
end

return attachPerfServerAndGui
