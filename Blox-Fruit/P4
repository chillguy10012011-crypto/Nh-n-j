	-- =========================================================================
	-- SERVER HOP (TRÁNH LẶP SERVER CŨ & TỰ BẬT LẠI CẤU HÌNH) + AUTO RECONNECT
	-- =========================================================================
	local function saveHopRestoreSnapshot()
		if not (typeof(writefile) == "function" and typeof(isfolder) == "function" and typeof(makefolder) == "function") then
			return
		end
		local activeSnapshot = {}
		for k, v in pairs(EzhubCore.Config) do
			if type(v) == "boolean" then
				activeSnapshot[k] = v
			end
		end
		pcall(function()
			if not isfolder("EzhubV1") then
				makefolder("EzhubV1")
			end
			writefile(HOP_RESTORE_FILE, HttpService:JSONEncode(activeSnapshot))
		end)
	end

	function PerfAndGui.ApplyPostHopConfigIfNeeded()
		if not EzhubCore.Config.AutoRestoreModesAfterHop then
			return
		end
		if typeof(isfile) == "function" and typeof(readfile) == "function" and isfile(HOP_RESTORE_FILE) then
			local ok, snap = pcall(function()
				return HttpService:JSONDecode(readfile(HOP_RESTORE_FILE))
			end)
			if ok and type(snap) == "table" then
				for k, v in pairs(snap) do
					if type(v) == "boolean" and EzhubCore.DefaultConfig[k] ~= nil then
						EzhubCore.Config[k] = v
					end
				end
				EzhubCore.Config.EmergencyStopAll = false
				EzhubCore.Notify("Server Hop", "Đã tự động bật lại các cấu hình đã chọn trước đó.")
			end
		end
	end

	function PerfAndGui.HopToLowPopulationServer()
		EzhubCore.MarkCurrentServerVisited()
		saveHopRestoreSnapshot()
		EzhubCore.Notify("Server Hop", "Đang tìm server ít người và chưa ghé qua...")

		local cursor = ""
		local chosenJobId = nil
		local lowestPlayers = math.huge

		for _ = 1, 5 do
			local url = string.format(
				"https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
				game.PlaceId,
				cursor ~= "" and ("&cursor=" .. cursor) or ""
			)
			local ok, raw = pcall(function()
				return game:HttpGet(url)
			end)
			if not ok or not raw then
				break
			end
			local parsed = HttpService:JSONDecode(raw)
			if parsed and type(parsed.data) == "table" then
				for _, srv in ipairs(parsed.data) do
					local jobId = tostring(srv.id or "")
					local playing = tonumber(srv.playing) or 0
					local maxPlayers = tonumber(srv.maxPlayers) or 12
					local alreadyVisited = EzhubCore.Config.AvoidVisitedServers and (EzhubCore.VisitedServers[jobId] ~= nil)

					if jobId ~= ""
						and jobId ~= tostring(game.JobId)
						and not alreadyVisited
						and playing > 0
						and playing < maxPlayers
					then
						if EzhubCore.Config.ServerHopMinPlayers then
							if playing < lowestPlayers then
								lowestPlayers = playing
								chosenJobId = jobId
							end
						else
							chosenJobId = jobId
							break
						end
					end
				end
				if chosenJobId and not EzhubCore.Config.ServerHopMinPlayers then
					break
				end
				if parsed.nextPageCursor then
					cursor = tostring(parsed.nextPageCursor)
				else
					break
				end
			else
				break
			end
		end

		if chosenJobId then
			EzhubCore.VisitedServers[chosenJobId] = os.time()
			EzhubCore.MarkCurrentServerVisited()
			pcall(function()
				TeleportService:TeleportToPlaceInstance(game.PlaceId, chosenJobId, LocalPlayer)
			end)
		else
			EzhubCore.Notify("Server Hop", "Không tìm thấy server mới phù hợp — Đang thử kết nối lại.")
			pcall(function()
				TeleportService:Teleport(game.PlaceId, LocalPlayer)
			end)
		end
	end

	-- Tự động vào lại game khi mất mạng / bị ngắt kết nối (Auto Reconnect)
