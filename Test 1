-- Xóa GUI cũ nếu đã chạy trước đó để tránh bị trùng lặp
if game.CoreGui:FindFirstChild("LockSpeedGui") then
    game.CoreGui.LockSpeedGui:Destroy()
end

-- Tạo ScreenGui chính
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "LockSpeedGui"
ScreenGui.Parent = game.CoreGui

-- Tạo Frame chứa nút bấm
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 180, 0, 60)
MainFrame.Position = UDim2.new(0.5, -90, 0.1, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

-- Bo góc cho đẹp
local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = MainFrame

-- Tạo Nút Bật/Tắt
local ToggleButton = Instance.new("TextButton")
ToggleButton.Size = UDim2.new(1, -16, 1, -16)
ToggleButton.Position = UDim2.new(0, 8, 0, 8)
ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.TextSize = 14
ToggleButton.Font = Enum.Font.SourceSansBold
ToggleButton.Text = "Khóa Tốc Độ: TẮT"
ToggleButton.Parent = MainFrame

local ButtonCorner = Instance.new("UICorner")
ButtonCorner.CornerRadius = UDim.new(0, 6)
ButtonCorner.Parent = ToggleButton

-- Biến trạng thái và cấu hình
local lockedSpeed = 16
local isLocked = false
local connection = nil

local player = game.Players.LocalPlayer

-- Hàm xử lý khóa tốc độ
local function updateSpeed()
    local character = player.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            if humanoid.WalkSpeed ~= lockedSpeed then
                humanoid.WalkSpeed = lockedSpeed
            end
        end
    end
end

-- Sự kiện khi bấm nút
ToggleButton.MouseButton1Click:Connect(function()
    isLocked = not isLocked
    
    if isLocked then
        ToggleButton.Text = "Khóa Tốc Độ: BẬT"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        
        -- Kích hoạt liên tục để ép tốc độ luôn về 16 (chống bị game đổi hoặc script khác ghi đè)
        connection = game:GetService("RunService").RenderStepped:Connect(updateSpeed)
    else
        ToggleButton.Text = "Khóa Tốc Độ: TẮT"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        
        -- Ngắt kết nối khi tắt
        if connection then
            connection:Disconnect()
            connection = nil
        end
    end
end)
