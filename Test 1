-- Hàm tạo nút bấm chuẩn
local function createButton(posY, defaultText)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 32)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- Đỏ: Tắt
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = defaultText .. ": OFF"
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13
    btn.Parent = mainFrame
    return btn
end

-- Tạo 3 nút cho 3 cách
local btnWay1 = createButton(40, "Cầm Chế Độ State")
local btnWay2 = createButton(78, "Xóa Value/Attr Stun")
local btnWay3 = createButton(116, "Block Animation")

local stateWay1 = false
local stateWay2 = false
local stateWay3 = false

-- --- CÁCH 1: Khóa Humanoid State / PlatformStanding ---
task.spawn(function()
    while screenGui.Parent do
        if stateWay1 then
            pcall(function()
                local character = localPlayer.Character
                if character and character:FindFirstChild("Humanoid") then
                    local humanoid = character.Humanoid
                    humanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
                    humanoid:SetStateEnabled(Enum.HumanoidStateType.Stunned, false)
                    if humanoid:GetState() == Enum.HumanoidStateType.PlatformStanding then
                        humanoid:ChangeState(Enum.HumanoidStateType.Running)
                    end
                end
            end)
        end
        task.wait(0.05)
    end
end)

btnWay1.MouseButton1Click:Connect(function()
    stateWay1 = not stateWay1
    if stateWay1 then
        btnWay1.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        btnWay1.Text = "Cầm Chế Độ State: ON"
    else
        btnWay1.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        btnWay1.Text = "Cầm Chế Độ State: OFF"
    end
end)

-- --- CÁCH 2: Xóa Value / Attribute Stun ---
task.spawn(function()
    while screenGui.Parent do
        if stateWay2 then
            pcall(function()
                local character = localPlayer.Character
                if character then
                    for _, v in ipairs(character:GetChildren()) do
                        if v:IsA("ValueBase") then
                            local nameLower = v.Name:lower()
                            if nameLower:find("stun") or nameLower:find("lock") or nameLower:find("ragdoll") or nameLower:find("action") then
                                v:Destroy()
                            end
                        end
                    end
                    for attrName, _ in pairs(character:GetAttributes()) do
                        local nameLower = attrName:lower()
                        if nameLower:find("stun") or nameLower:find("lock") or nameLower:find("ragdoll") then
                            character:SetAttribute(attrName, false)
                        end
                    end
                end
            end)
        end
        task.wait(0.05)
    end
end)

btnWay2.MouseButton1Click:Connect(function()
    stateWay2 = not stateWay2
    if stateWay2 then
        btnWay2.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        btnWay2.Text = "Xóa Value/Attr: ON"
    else
        btnWay2.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        btnWay2.Text = "Xóa Value/Attr: OFF"
    end
end)

-- --- CÁCH 3: Chống Stun bằng cách can thiệp Animation ---
task.spawn(function()
    while screenGui.Parent do
        if stateWay3 then
            pcall(function()
                local character = localPlayer.Character
                if character and character:FindFirstChild("Humanoid") then
                    local animator = character.Humanoid:FindFirstChildOfClass("Animator")
                    if animator then
                        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                            local animName = ""
                            if track.Animation and track.Animation.AnimationId then
                                animName = track.Animation.AnimationId:lower()
                            end
                            if track.Name:lower():find("stun") or track.Name:lower():find("hit") or track.Name:lower():find("knockback") or animName:find("stun") then
                                track:Stop(0)
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.05)
    end
end)

btnWay3.MouseButton1Click:Connect(function()
    stateWay3 = not stateWay3
    if stateWay3 then
        btnWay3.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        btnWay3.Text = "Block Animation: ON"
    else
        btnWay3.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        btnWay3.Text = "Block Animation: OFF"
    end
end)

