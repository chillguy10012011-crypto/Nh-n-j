-- Ô nhập số trực tiếp (TextBox) ở cạnh thanh kéo
local speedTextBox = Instance.new("TextBox")
speedTextBox.Size = UDim2.new(0.2, 0, 0, 25)
speedTextBox.Position = UDim2.new(0.75, 0, 0, 103)
speedTextBox.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
speedTextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
speedTextBox.Text = "16"
speedTextBox.Font = Enum.Font.SourceSansBold
speedTextBox.TextSize = 14
speedTextBox.ClearTextOnFocus = false
speedTextBox.Parent = mainFrame

-- Biến cấu hình tốc độ (Min: 16, Max: 200)
local minSpeed = 16
local maxSpeed = 200
local currentSpeed = 16
local speedActive = false
local originalWalkSpeed = 16

-- Hàm cập nhật tốc độ
local function updateSpeed(val)
    currentSpeed = math.clamp(math.floor(val), minSpeed, maxSpeed)
    speedLabel.Text = "Tốc độ: " .. currentSpeed
    speedTextBox.Text = tostring(currentSpeed)
    
    -- Cập nhật vị trí nút kéo trên thanh slider
    local ratio = (currentSpeed - minSpeed) / (maxSpeed - minSpeed)
    sliderKnob.Position = UDim2.new(ratio, -7, 0, -5)
end

-- Xử lý kéo thanh trượt (Slider Logic)
local dragging = false
sliderKnob.MouseButton1Down:Connect(function()
    dragging = true
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

RunService.RenderStepped:Connect(function()
    if dragging then
        local mousePos = UserInputService:GetMouseLocation()
        local barPos = sliderBar.AbsolutePosition
        local barSize = sliderBar.AbsoluteSize
        local ratio = math.clamp((mousePos.X - barPos.X) / barSize.X, 0, 1)
        local val = minSpeed + ratio * (maxSpeed - minSpeed)
        updateSpeed(val)
    end
end)

-- Xử lý khi nhập số trực tiếp vào ô TextBox
speedTextBox.FocusLost:Connect(function(enterPressed)
    local num = tonumber(speedTextBox.Text)
    if num then
        updateSpeed(num)
    else
        speedTextBox.Text = tostring(currentSpeed)
    end
end)

-- Vòng lặp áp dụng tốc độ và chống stun liên tục khi bật
RunService.Heartbeat:Connect(function()
    pcall(function()
        local character = localPlayer.Character
        if not character then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        
        if humanoid then
            if speedActive then
                -- Ép tốc độ theo giá trị cài đặt và chống khựng/stun
                humanoid.WalkSpeed = currentSpeed
                humanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                
                local curState = humanoid:GetState()
                if curState == Enum.HumanoidStateType.PlatformStanding or curState == Enum.HumanoidStateType.Ragdoll then
                    humanoid:ChangeState(Enum.HumanoidStateType.Running)
                end
            else
                -- Trả về tốc độ mặc định khi tắt nút
                if humanoid.WalkSpeed == currentSpeed then
                    humanoid.WalkSpeed = originalWalkSpeed
                end
            end
        end
    end)
end)

-- Sự kiện bật/tắt nút chính
toggleBtn.MouseButton1Click:Connect(function()
    speedActive = not speedActive
    if speedActive then
        toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        toggleBtn.Text = "Speed Mod: ON"
    else
        toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        toggleBtn.Text = "Speed Mod: OFF"
        -- Khôi phục WalkSpeed gốc
        pcall(function()
            local humanoid = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then humanoid.WalkSpeed = 16 end
        end)
    end
end)
