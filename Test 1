local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local lp = Players.LocalPlayer

-- Chỉnh số nếu bị giật/nhầm
local MAX_SPEED = 120   -- vận tốc ngang/lên tối đa (studs/s)
local MAX_SPIN  = 40    -- tốc độ xoay tối đa

local SLIDER_MAX = 200  -- giá trị tối đa của thanh kéo
local INPUT_MAX  = 500  -- giá trị tối đa khi nhập tay
local DEFAULT_SPEED = 16

local enabled = false
local speedEnabled = false
local speedValue = DEFAULT_SPEED
local lastCF

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "AntiFlingGui"
gui.ResetOnSpawn = false
local ok, parent = pcall(function() return gethui() end)
gui.Parent = ok and parent or (pcall(function() return game:GetService("CoreGui").Name end) and game:GetService("CoreGui") or lp:WaitForChild("PlayerGui"))

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 190, 0, 170)
frame.Position = UDim2.new(0.5, -95, 0.1, 0)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
Instance.new("UICorner", frame)

-- Thanh tiêu đề (kéo GUI)
local title = Instance.new("TextLabel", frame)
title.Size = UDim2.new(1, 0, 0, 24)
title.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 14
title.Text = "Menu (kéo ở đây)"
Instance.new("UICorner", title)

do
    local dragging, dragStart, startPos
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- Nút Anti-Fling
local btn = Instance.new("TextButton", frame)
btn.Size = UDim2.new(1, -16, 0, 30)
btn.Position = UDim2.new(0, 8, 0, 30)
btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
btn.TextColor3 = Color3.new(1, 1, 1)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 16
btn.Text = "Anti-Fling: OFF"
Instance.new("UICorner", btn)

btn.MouseButton1Click:Connect(function()
    enabled = not enabled
    btn.Text = "Anti-Fling: " .. (enabled and "ON" or "OFF")
    btn.BackgroundColor3 = enabled and Color3.fromRGB(50, 170, 80) or Color3.fromRGB(200, 50, 50)
end)

-- Ô nhập tốc độ
local box = Instance.new("TextBox", frame)
box.Size = UDim2.new(1, -16, 0, 26)
box.Position = UDim2.new(0, 8, 0, 66)
box.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
box.TextColor3 = Color3.new(1, 1, 1)
box.PlaceholderText = "Nhập tốc độ"
box.Font = Enum.Font.Gotham
box.TextSize = 14
box.ClearTextOnFocus = false
box.Text = tostring(speedValue)
Instance.new("UICorner", box)

-- Thanh kéo tốc độ
local track = Instance.new("Frame", frame)
track.Size = UDim2.new(1, -16, 0, 12)
track.Position = UDim2.new(0, 8, 0, 102)
track.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

local fill = Instance.new("Frame", track)
fill.Size = UDim2.new(0, 0, 1, 0)
fill.BackgroundColor3 = Color3.fromRGB(70, 130, 255)
Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

local knob = Instance.new("Frame", track)
knob.Size = UDim2.new(0, 16, 0, 16)
knob.AnchorPoint = Vector2.new(0.5, 0.5)
knob.Position = UDim2.new(0, 0, 0.5, 0)
knob.BackgroundColor3 = Color3.new(1, 1, 1)
Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

local function setSpeed(v)
    v = math.floor(math.clamp(v, 0, INPUT_MAX) + 0.5)
    speedValue = v
    local ratio = math.clamp(v / SLIDER_MAX, 0, 1)
    fill.Size = UDim2.new(ratio, 0, 1, 0)
    knob.Position = UDim2.new(ratio, 0, 0.5, 0)
    box.Text = tostring(v)
end
setSpeed(speedValue)

box.FocusLost:Connect(function()
    local n = tonumber(box.Text)
    if n then setSpeed(n) else box.Text = tostring(speedValue) end
end)

do
    local sliding = false
    local function update(input)
        local ratio = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        setSpeed(ratio * SLIDER_MAX)
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)
end

-- Nút bật/tắt tốc độ
local speedBtn = Instance.new("TextButton", frame)
speedBtn.Size = UDim2.new(1, -16, 0, 30)
speedBtn.Position = UDim2.new(0, 8, 0, 126)
speedBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
speedBtn.TextColor3 = Color3.new(1, 1, 1)
speedBtn.Font = Enum.Font.GothamBold
speedBtn.TextSize = 16
speedBtn.Text = "Speed: OFF"
Instance.new("UICorner", speedBtn)

local originalSpeed = DEFAULT_SPEED

speedBtn.MouseButton1Click:Connect(function()
    speedEnabled = not speedEnabled
    speedBtn.Text = "Speed: " .. (speedEnabled and "ON" or "OFF")
    speedBtn.BackgroundColor3 = speedEnabled and Color3.fromRGB(50, 170, 80) or Color3.fromRGB(200, 50, 50)

    local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    if speedEnabled then
        if hum then originalSpeed = hum.WalkSpeed end
    else
        if hum then hum.WalkSpeed = originalSpeed end
    end
end)

-- Áp dụng tốc độ
RunService.Heartbeat:Connect(function()
    if not speedEnabled then return end
    local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = speedValue
    end
end)

-- Logic chống fling
RunService.Heartbeat:Connect(function()
    if not enabled then return end
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local v = root.AssemblyLinearVelocity
    local w = root.AssemblyAngularVelocity
    local horizontal = Vector3.new(v.X, 0, v.Z).Magnitude

    -- Nâng giới hạn khi đang chạy nhanh để không bị reset nhầm
    local limit = MAX_SPEED
    if speedEnabled then
        limit = math.max(MAX_SPEED, speedValue * 1.5)
    end

    if horizontal > limit or v.Y > limit or w.Magnitude > MAX_SPIN then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        if lastCF then
            root.CFrame = lastCF
        end
    else
        lastCF = root.CFrame
    end
end)
