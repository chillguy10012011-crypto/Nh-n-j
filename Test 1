local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local lp = Players.LocalPlayer

-- Chỉnh số nếu bị giật/nhầm
local MAX_SPEED = 120   -- vận tốc ngang/lên tối đa (studs/s)
local MAX_SPIN  = 40    -- tốc độ xoay tối đa

local enabled = false
local lastCF

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "AntiFlingGui"
gui.ResetOnSpawn = false
local ok, parent = pcall(function() return gethui() end)
gui.Parent = ok and parent or (pcall(function() return game:GetService("CoreGui").Name end) and game:GetService("CoreGui") or lp:WaitForChild("PlayerGui"))

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 150, 0, 60)
frame.Position = UDim2.new(0.5, -75, 0.1, 0)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.Active = true
frame.Draggable = true
Instance.new("UICorner", frame)

local btn = Instance.new("TextButton", frame)
btn.Size = UDim2.new(1, -16, 1, -16)
btn.Position = UDim2.new(0, 8, 0, 8)
btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
btn.TextColor3 = Color3.new(1, 1, 1)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 16
btn.Text = "Anti-Fling: OFF"
Instance.new("UICorner", btn)

btn.MouseButton1Click:Connect(function()
    enabled = not enabled
    btn.Text = "Anti-Fling: " .. (enabled and "ON" or "OFF")
    btn.BackgroundColor3 = enabled and Color3.fromRGB(50, 170, 80) or Color3.fromRGB(200, 50, 50)
end)

-- Logic chống fling
RunService.Heartbeat:Connect(function()
    if not enabled then return end
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local v = root.AssemblyLinearVelocity
    local w = root.AssemblyAngularVelocity
    local horizontal = Vector3.new(v.X, 0, v.Z).Magnitude

    if horizontal > MAX_SPEED or v.Y > MAX_SPEED or w.Magnitude > MAX_SPIN then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        if lastCF then
            root.CFrame = lastCF
        end
    else
        lastCF = root.CFrame
    end
end)
