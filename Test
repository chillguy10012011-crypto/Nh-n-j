-- Biến lưu trạng thái
local selectedPlayer = nil
local isFollowing = false
local isLooking = false
local isHiding = false
local followConnection = nil
local lookConnection = nil

-- Tự động cập nhật chiều cao vùng cuộn
UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
end)

-- Cập nhật danh sách người chơi
local function updatePlayerList()
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, 0, 0, 25)
			btn.Text = player.DisplayName .. " (@" .. player.Name .. ")"
			btn.Font = Enum.Font.SourceSans
			btn.TextSize = 12
			
			if selectedPlayer == player then
				btn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
				btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			else
				btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
				btn.TextColor3 = Color3.fromRGB(200, 200, 200)
			end
			
			btn.MouseButton1Click:Connect(function()
				selectedPlayer = player
				updatePlayerList()
			end)
			
			btn.Parent = scrollFrame
		end
	end
end

-- Tìm người chơi gần nhất
local function getNearestPlayer()
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
	
	local myHRP = myChar.HumanoidRootPart
	local nearestPlayer = nil
	local shortestDistance = math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local hum = player.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				local targetHRP = player.Character.HumanoidRootPart
				local distance = (myHRP.Position - targetHRP.Position).Magnitude
				
				if distance < shortestDistance then
					shortestDistance = distance
					nearestPlayer = player
				end
			end
		end
	end
	
	return nearestPlayer
end

-- Logic Ẩn/Hiện Bảng GUI
closeBtn.MouseButton1Click:Connect(function()
	mainFrame.Visible = false
	openGuiBtn.Visible = true
end)

openGuiBtn.MouseButton1Click:Connect(function()
	mainFrame.Visible = true
	openGuiBtn.Visible = false
end)

-- Logic Dịch Chuyển
toggleBtn.MouseButton1Click:Connect(function()
	isFollowing = not isFollowing
	toggleBtn.BackgroundColor3 = isFollowing and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
	toggleBtn.Text = isFollowing and "Dịch chuyển: BẬT" or "Dịch chuyển: TẮT"
	
	if isFollowing then
		followConnection = RunService.RenderStepped:Connect(function()
			if selectedPlayer and selectedPlayer.Character and selectedPlayer.Character:FindFirstChild("HumanoidRootPart") then
				local myChar = LocalPlayer.Character
				if myChar and myChar:FindFirstChild("HumanoidRootPart") then
					myChar.HumanoidRootPart.CFrame = selectedPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 0)
				end
			end
		end)
	else
		if followConnection then
			followConnection:Disconnect()
			followConnection = nil
		end
	end
end)

-- Logic Nhìn Người Gần Nhất
lookBtn.MouseButton1Click:Connect(function()
	isLooking = not isLooking
	lookBtn.BackgroundColor3 = isLooking and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
	lookBtn.Text = isLooking and "Nhìn gần nhất: BẬT" or "Nhìn gần nhất: TẮT"
	
	if isLooking then
		lookConnection = RunService.RenderStepped:Connect(function()
			local nearest = getNearestPlayer()
			if nearest and nearest.Character and nearest.Character:FindFirstChild("HumanoidRootPart") then
				local targetPos = nearest.Character.HumanoidRootPart.Position
				Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPos)
			end
		end)
	else
		if lookConnection then
			lookConnection:Disconnect()
			lookConnection = nil
		end
	end
end)

-- Logic Tàng Hình (Client Only)
hideBtn.MouseButton1Click:Connect(function()
	isHiding = not isHiding
	hideBtn.BackgroundColor3 = isHiding and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
	hideBtn.Text = isHiding and "Tàng hình (Client): BẬT" or "Tàng hình (Client): TẮT"
	
	local myChar = LocalPlayer.Character
	if myChar then
		for _, part in ipairs(myChar:GetDescendants()) do
			if part:IsA("BasePart") or part:IsA("Decal") then
				part.Transparency = isHiding and 1 or 0
			elseif part:IsA("BillboardGui") then
				part.Enabled = not isHiding
			end
		end
	end
end)

-- Lắng nghe người chơi ra vào server
Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(function(player)
	if selectedPlayer == player then
		selectedPlayer = nil
	end
	updatePlayerList()
end)

-- Khởi chạy danh sách ban đầu
updatePlayerList()
