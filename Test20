-- Xử lý logic khi nhấn nút Execute
ExecuteBtn.MouseButton1Click:Connect(function()
    local rawInput = InputBox.Text
    if rawInput == "" then return end
    
    -- Xử lý mô phỏng bắt khoảnh khắc giải mã & thực thi
    local decodedResult = ""
    
    -- Kiểm tra nếu người dùng nhập loadstring dạng thông thường
    local success, err = pcall(function()
        -- Nếu là loadstring hợp lệ, ta có thể thử load nó hoặc bắt nội dung
        if string.find(rawInput, "loadstring") then
            decodedResult = "-- Đã bắt và phân tích chuỗi loadstring:\n" .. rawInput
        else
            decodedResult = "-- Nội dung giải mã từ chuỗi:\n" .. rawInput
        end
        
        -- Thực thi đoạn code người dùng nhập vào
        local func, loadErr = loadstring(rawInput)
        if func then
            task.spawn(func) -- Chạy code bất đồng bộ
            decodedResult = decodedResult .. "\n\n[Trạng thái]: Thực thi (Execute) thành công!"
        else
            decodedResult = decodedResult .. "\n\n[Lỗi thực thi]: " .. tostring(loadErr)
        end
    end)

    if not success then
        decodedResult = "-- Lỗi xử lý: " .. tostring(err)
    end

    -- Thêm khoảng cách (cách dòng) giữa lần in cũ và lần in mới
    local currentText = OutputText.Text
    local spacer = "\n\n----------------------------------------\n\n"
    
    OutputText.Text = currentText .. spacer .. decodedResult
end)
