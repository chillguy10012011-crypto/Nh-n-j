local function createColorPalette(titleText, colorType)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0.95, 0, 0, 50)
    frame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    frame.BorderSizePixel = 1
    frame.BorderColor3 = CurrentColors.Border
    frame.Parent = SlideSetting
    registerElement(frame, "Border")

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 20)
    lbl.BackgroundTransparency = 1
    lbl.Text = titleText
    lbl.TextColor3 = CurrentColors.Text
    lbl.Font = Enum.Font.SourceSans
    lbl.TextSize = 14
    lbl.Parent = frame
    registerElement(lbl, "Text")

    local presetColors = {
        Color3.fromRGB(25, 25, 35), Color3.fromRGB(0, 150, 255), Color3.fromRGB(255, 255, 255),
        Color3.fromRGB(255, 50, 50), Color3.fromRGB(50, 255, 50), Color3.fromRGB(255, 220, 0),
        Color3.fromRGB(150, 50, 250)
    }

    for i, col in ipairs(presetColors) do
        local cBtn = Instance.new("TextButton")
        cBtn.Size = UDim2.new(0, 20, 0, 20)
        cBtn.Position = UDim2.new(0, 10 + (i - 1) * 26, 0, 24)
        cBtn.BackgroundColor3 = col
        cBtn.BorderSizePixel = 1
        cBtn.Text = ""
        cBtn.Parent = frame

        cBtn.MouseButton1Click:Connect(function()
            CurrentColors[colorType] = col
            updateGUIColors()
        end)
    end
end

