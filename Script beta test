local function createStyledButton(parent, text, pos, size)
    local btn = Instance.new("TextButton")
    btn.Size = size or UDim2.new(0, 380, 0, 30)
    btn.Position = pos
    btn.BackgroundColor3 = ThemePalette.ButtonBg
    btn.BorderColor3 = ThemePalette.Accent
