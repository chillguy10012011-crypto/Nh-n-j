local SpawnModelBtn = Instance.new("TextButton")
SpawnModelBtn.Size = UDim2.new(0.95, 0, 0, 28)
SpawnModelBtn.Position = UDim2.new(0.025, 0, 0, 142)
SpawnModelBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
SpawnModelBtn.BorderColor3 = Color3.fromRGB(0, 170, 255)
SpawnModelBtn.BorderSizePixel = 1
SpawnModelBtn.Text = "Spawn Dummy Model"
SpawnModelBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
SpawnModelBtn.Font = Enum.Font.SourceSansBold
SpawnModelBtn.TextSize = 12
SpawnModelBtn.Parent = HubSlide

table.insert(registeredBorders, SpawnModelBtn)
table.insert(registeredTexts, SpawnModelBtn)

SpawnModelBtn.MouseButton1Click:Connect(function()
    local myChar = LocalPlayer.Character
    if myChar and myChar:FindFirstChild("HumanoidRootPart") then
        local dummy = Instance.new("Model")
        dummy.Name = "CustomDummy"
        
        local part = Instance.new("Part")
        part.Size = Vector3.new(2, 5, 2)
        part.Position = myChar.HumanoidRootPart.Position + (myChar.HumanoidRootPart.CFrame.LookVector * 5)
        part.Color = Color3.fromRGB(255, 255, 0)
        part.Anchored = true
        part.Parent = dummy
        
        dummy.Parent = Workspace
    end
end)

-- LOOP XỬ LÝ SCRIPT HUB (PROJECT SMASH, AIR WALK & ANTI-STUN)
RunService.Stepped:Connect(function()
    local myChar = LocalPlayer.Character
    if not myChar then return end
    
    local hrp = myChar:FindFirstChild("HumanoidRootPart")
    local hum = myChar:FindFirstChildOfClass("Humanoid")

    -- PROJECT SMASH LOGIC
    if SmashToggle and hrp then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local targetHrp = p.Character.HumanoidRootPart
                if (targetHrp.Position - hrp.Position).Magnitude <= 10 then
                    targetHrp.Velocity = Vector3.new(0, 100, 0)
                end
            end
        end
    end

    -- AIR WALK LOGIC
    if AirWalkToggle and hrp then
        if not airPlatform or not airPlatform.Parent then
            airPlatform = Instance.new("Part")
            airPlatform.Size = Vector3.new(6, 1, 6)
            airPlatform.Anchored = true
            airPlatform.Transparency = 0.5
            airPlatform.Color = Color3.fromRGB(0, 170, 255)
            airPlatform.Parent = Workspace
        end
        airPlatform.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 3.5, hrp.Position.Z)
    elseif not AirWalkToggle and airPlatform then
        airPlatform:Destroy()
        airPlatform = nil
    end

    -- ANTI-STUN LOGIC
    if AntiStunToggle and hum then
        hum.PlatformStand = false
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    end
end)
