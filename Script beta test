-- Hàm Tạo Slide (ScrollingFrame)
local function createSlide(name)
    local scroll = Instance.new("ScrollingFrame")
    scroll.Name = name
    scroll.Size = UDim2.new(1, 0, 1, 0)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 5
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.Visible = false
    scroll.Parent = ContentFrame
    
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)
    layout.Parent = scroll
    
    Slides[name] = scroll
    return scroll
end

-- Hàm Chuyển Slide
local function showSlide(name)
    for slideName, slideObj in pairs(Slides) do
        slideObj.Visible = (slideName == name)
    end
end

-- Quản lý đổi màu GUI
local ColorElements = { Background = {}, Border = {}, Text = {} }

local function registerElement(element, elementType)
    table.insert(ColorElements[elementType], element)
end

local function updateGUIColors()
    MainFrame.BackgroundColor3 = CurrentColors.Background
    MainFrame.BorderColor3 = CurrentColors.Border
    TitleText.TextColor3 = CurrentColors.Text
    
    for _, elem in ipairs(ColorElements.Background) do
        elem.BackgroundColor3 = CurrentColors.Background
    end
    for _, elem in ipairs(ColorElements.Border) do
        if elem:IsA("Frame") or elem:IsA("TextButton") or elem:IsA("TextBox") then
            elem.BorderColor3 = CurrentColors.Border
        end
    end
    for _, elem in ipairs(ColorElements.Text) do
        if elem:IsA("TextLabel") or elem:IsA("TextButton") or elem:IsA("TextBox") then
            elem.TextColor3 = CurrentColors.Text
        end
    end
end

-- Hàm tạo Keybind Button (Meteor Client Style)
local function createKeybindButton(parent, text, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(0.95, 0, 0, 35)
    container.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    container.BorderSizePixel = 1
    container.BorderColor3 = CurrentColors.Border
    container.Parent = parent
    registerElement(container, "Border")

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.65, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = text
    btn.TextColor3 = CurrentColors.Text
    btn.Font = Enum.Font.SourceSans
    btn.TextSize = 16
    btn.Parent = container
    registerElement(btn, "Text")

    local keyBox = Instance.new("TextBox")
    keyBox.Size = UDim2.new(0.3, -5, 0.8, 0)
    keyBox.Position = UDim2.new(0.68, 0, 0.1, 0)
    keyBox.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    keyBox.BorderColor3 = CurrentColors.Border
    keyBox.Text = "None"
    keyBox.TextColor3 = CurrentColors.Text
    keyBox.Font = Enum.Font.SourceSansBold
    keyBox.TextSize = 14
    keyBox.Parent = container
    registerElement(keyBox, "Border")
    registerElement(keyBox, "Text")

    local state = false
    local currentKey = nil

    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.TextColor3 = state and Color3.fromRGB(0, 255, 120) or CurrentColors.Text
        callback(state)
    end)

    keyBox.Focused:Connect(function()
        keyBox.Text = "..."
    end)

    keyBox.FocusLost:Connect(function()
        local inputStr = keyBox.Text:upper()
        if inputStr == "" or inputStr == "NONE" or inputStr == "BACKSPACE" or inputStr == "DELETE" or inputStr == "ESCAPE" then
            currentKey = nil
            keyBox.Text = "None"
        else
            local success, enumKey = pcall(function() return Enum.KeyCode[inputStr] end)
            if success and enumKey then
                currentKey = enumKey
                keyBox.Text = enumKey.Name
            else
                keyBox.Text = currentKey and currentKey.Name or "None"
            end
        end
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and currentKey and input.KeyCode == currentKey then
            state = not state
            btn.TextColor3 = state and Color3.fromRGB(0, 255, 120) or CurrentColors.Text
            callback(state)
        end
    end)

    return container
end
