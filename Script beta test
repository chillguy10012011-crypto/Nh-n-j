local slidesList = {}
local currentSlideIndex = 1

local function createSlide(title)
    local slide = Instance.new("ScrollingFrame")
    slide.Size = UDim2.new(1, 0, 1, 0)
    slide.BackgroundColor3 = ThemePalette.SlideBg
    slide.BorderSizePixel = 0
    slide.Visible = false
    slide.ScrollBarThickness = 4
    slide.AutomaticCanvasSize = Enum.AutomaticSize.Y
    slide.CanvasSize = UDim2.new(0, 0, 0, 0)
    slide.Parent = SlidesContainer
    
    table.insert(slidesList, {Frame = slide, Title = title})
    return slide
end

local function showSlide(index)
    for i, sData in ipairs(slidesList) do
        sData.Frame.Visible = (i == index)
    end
    SlideTitle.Text = "Slide " .. index .. ": " .. slidesList[index].Title
end

PrevBtn.MouseButton1Click:Connect(function()
    currentSlideIndex = currentSlideIndex - 1
    if currentSlideIndex < 1 then currentSlideIndex = #slidesList end
    showSlide(currentSlideIndex)
end)

NextBtn.MouseButton1Click:Connect(function()
    currentSlideIndex = currentSlideIndex + 1
    if currentSlideIndex > #slidesList then currentSlideIndex = 1 end
    showSlide(currentSlideIndex)
end)

