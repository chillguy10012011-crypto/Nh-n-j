local function updateScale(input)
    local pos = math.clamp((input.Position.X - ScaleSliderBg.AbsolutePosition.X) / ScaleSliderBg.AbsoluteSize.X, 0, 1)
    ScaleSliderFill.Size = UDim2.new(pos, 0, 1, 0)
