-- // RENDER LOOP XỬ LÝ TOÀN BỘ LOGIC SLIDE PLAYER
RunService.RenderStepped:Connect(function()
    local Camera = Workspace.CurrentCamera
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

    -- 1. LOGIC NÚT 1: AIM TARGET
    if AimTargetToggle and selectedTargetPlayer and selectedTargetPlayer.Character then
        local targetHrp = selectedTargetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if targetHrp then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHrp.Position)
        end
    end

    -- 2. LOGIC NÚT 2: AIM NGƯỜI GẦN NHẤT
    if AimClosestToggle and myHrp then
        local closestChar = nil
        local shortestDist = math.huge

        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (p.Character.HumanoidRootPart.Position - myHrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestChar = p.Character.HumanoidRootPart
                end
            end
        end

        if closestChar then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestChar.Position)
        end
    end

    -- 3. LOGIC NÚT 3: HIGHLIGHT
    if HighlightToggle then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character then
                local hl = p.Character:FindFirstChild("CustomHighlight")
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "CustomHighlight"
                    hl.Parent = p.Character
                end
                
                if p == LocalPlayer then
                    hl.FillColor = Color3.fromRGB(0, 170, 255) -- Xanh biển
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                else
                    hl.FillColor = Color3.fromRGB(255, 0, 0) -- Đỏ
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                end
                hl.FillTransparency = 0.5
                hl.OutlineTransparency = 0
            end
        end
    end

    -- 4. LOGIC NÚT 5: SHOW NAME
    if ShowNameToggle then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                local head = p.Character.Head
                local tag = head:FindFirstChild("NameEspTag")
                if not tag then
                    tag = Instance.new("BillboardGui")
                    tag.Name = "NameEspTag"
                    tag.Size = UDim2.new(0, 100, 0, 30)
                    tag.StudsOffset = Vector3.new(0, 2, 0)
                    tag.AlwaysOnTop = true
                    tag.Parent = head

                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                    lbl.TextStrokeTransparency = 0
                    lbl.Font = Enum.Font.SourceSansBold
                    lbl.TextSize = 14
                    lbl.Parent = tag
                end
                
                tag.TextLabel.Text = p.DisplayName .. " (@" .. p.Name .. ")"
            end
        end
    end

    -- 5. LOGIC NÚT 4: LINE SHIFTLOCK & BOX ESP 2D
    clearDrawings()
    if EspLinesBoxesToggle then
        local centerScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = p.Character.HumanoidRootPart
                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                if onScreen then
                    -- Đường kẻ từ vị trí Shiftlock (tâm màn hình)
                    local line = Drawing.new("Line")
                    line.Visible = true
                    line.From = centerScreen
                    line.To = Vector2.new(pos.X, pos.Y)
                    line.Color = Color3.fromRGB(255, 0, 0)
                    line.Thickness = 1.5

                    -- Khung hình vuông 2D Box ESP
                    local head = p.Character:FindFirstChild("Head")
                    local headPos = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or pos
                    local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

                    local height = math.abs(headPos.Y - legPos.Y)
                    local width = height / 1.5

                    local box = Drawing.new("Square")
                    box.Visible = true
                    box.Size = Vector2.new(width, height)
                    box.Position = Vector2.new(pos.X - width / 2, pos.Y - height / 2)
                    box.Color = Color3.fromRGB(255, 0, 0)
                    box.Thickness = 1.5
                    box.Filled = false

                    table.insert(drawings, {Line = line, Box = box})
                end
            end
        end
    end
end)
