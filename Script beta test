local function createSlide(name)
    local slide = Instance.new("ScrollingFrame")
    slide.Name = name .. "Slide"
    slide.Size = UDim2.new(1, 0, 1, 0)
    slide.BackgroundTransparency = 1
    slide.BorderSizePixel = 0
    slide.ScrollBarThickness = 3
    slide.Visible = false
    slide.Parent = SlideContainer

    local btn = Instance.new("TextButton")
    btn.Name = name .. "Btn"
    btn.Size = UDim2.new(0, 60, 1, 0)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    btn.BorderColor3 = Color3.fromRGB(0, 170, 255)
    btn.BorderSizePixel = 1
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 12
    btn.Parent = NavBar

    table.insert(registeredBorders, btn)
    table.insert(registeredTexts, btn)

    btn.MouseButton1Click:Connect(function()
        for _, s in pairs(slides) do s.Visible = false end
        for _, b in pairs(slideButtons) do b.TextColor3 = Color3.fromRGB(200, 200, 200) end
        slide.Visible = true
        btn.TextColor3 = Color3.fromRGB(0, 255, 150)
    end)

    table.insert(slides, slide)
    table.insert(slideButtons, btn)
    return slide
end

-- HÀM TẠO NÚT CÓ KEYBIND DÙNG CHUNG
local function createKeybindButton(parentSlide, name, pos, size, defaultKey, callback)
    local container = Instance.new("Frame")
    container.Size = size
    container.Position = pos
    container.BackgroundTransparency = 1
    container.Parent = parentSlide

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0.7, -2, 1, 0)
    toggleBtn.Position = UDim2.new(0, 0, 0, 0)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    toggleBtn.BorderColor3 = Color3.fromRGB(0, 170, 255)
    toggleBtn.BorderSizePixel = 1
    toggleBtn.Text = name .. " [OFF]"
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.Font = Enum.Font.SourceSansBold
    toggleBtn.TextSize = 12
    toggleBtn.Parent = container

    table.insert(registeredBorders, toggleBtn)
    table.insert(registeredTexts, toggleBtn)

    local bindBtn = Instance.new("TextButton")
    bindBtn.Size = UDim2.new(0.3, -2, 1, 0)
    bindBtn.Position = UDim2.new(0.7, 2, 0, 0)
    bindBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    bindBtn.BorderColor3 = Color3.fromRGB(0, 170, 255)
    bindBtn.BorderSizePixel = 1
    bindBtn.Text = defaultKey and defaultKey.Name or "None"
    bindBtn.TextColor3 = Color3.fromRGB(0, 255, 150)
    bindBtn.Font = Enum.Font.SourceSans
    bindBtn.TextSize = 11
    bindBtn.Parent = container

    table.insert(registeredBorders, bindBtn)

    local state = false
    local currentKey = defaultKey
    local binding = false

    local function toggle()
        state = not state
        toggleBtn.Text = name .. (state and " [ON]" or " [OFF]")
        toggleBtn.BackgroundColor3 = state and Color3.fromRGB(0, 120, 200) or Color3.fromRGB(40, 40, 40)
        callback(state)
    end

    toggleBtn.MouseButton1Click:Connect(toggle)

    bindBtn.MouseButton1Click:Connect(function()
        binding = true
        bindBtn.Text = "..."
    end)

    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if binding then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                currentKey = input.KeyCode == Enum.KeyCode.Escape and nil or input.KeyCode
                bindBtn.Text = currentKey and currentKey.Name or "None"
                binding = false
            end
        elseif currentKey and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == currentKey then
            toggle()
        end
    end)
end

