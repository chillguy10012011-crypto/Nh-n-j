local GuestListToggleBtn = createStyledButton(Slide10, "▼ Bảng danh sách người chơi (Mở/Đóng)", UDim2.new(0, 10, 0, 10), UDim2.new(0, 380, 0, 25))
local GuestPlayerSelectedLbl = Instance.new("TextLabel")
GuestPlayerSelectedLbl.Size = UDim2.new(0, 380, 0, 20)
GuestPlayerSelectedLbl.Position = UDim2.new(0, 10, 0, 40)
GuestPlayerSelectedLbl.BackgroundTransparency = 1
GuestPlayerSelectedLbl.Text = "Player: Chưa chọn"
GuestPlayerSelectedLbl.TextColor3 = Color3.fromRGB(0, 170, 255)
GuestPlayerSelectedLbl.Font = Enum.Font.SourceSansBold
GuestPlayerSelectedLbl.TextSize = 13
GuestPlayerSelectedLbl.Parent = Slide10

local GuestPlayerListFrame = Instance.new("ScrollingFrame")
GuestPlayerListFrame.Size = UDim2.new(0, 380, 0, 80)
GuestPlayerListFrame.Position = UDim2.new(0, 10, 0, 65)
GuestPlayerListFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
GuestPlayerListFrame.BorderColor3 = Color3.fromRGB(0, 170, 255)
GuestPlayerListFrame.BorderSizePixel = 1
GuestPlayerListFrame.ScrollBarThickness = 4
GuestPlayerListFrame.Visible = true
GuestPlayerListFrame.Parent = Slide10

local GuestUIList = Instance.new("UIListLayout")
GuestUIList.Parent = GuestPlayerListFrame

local function updateGuestPlayerList()
    for _, item in pairs(GuestPlayerListFrame:GetChildren()) do
        if item:IsA("TextButton") then item:Destroy() end
    end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 22)
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
            btn.Text = p.Name .. " (" .. p.DisplayName .. ")"
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Font = Enum.Font.SourceSans
            btn.TextSize = 12
            btn.Parent = GuestPlayerListFrame
            
            btn.MouseButton1Click:Connect(function()
                guestSelectedPlayer = p
                GuestPlayerSelectedLbl.Text = "Player: " .. p.Name .. " (" .. p.DisplayName .. ")"
            end)
        end
    end
end
updateGuestPlayerList()
Players.PlayerAdded:Connect(updateGuestPlayerList)
Players.PlayerRemoving:Connect(updateGuestPlayerList)

GuestListToggleBtn.MouseButton1Click:Connect(function()
    GuestPlayerListFrame.Visible = not GuestPlayerListFrame.Visible
end)

-- Các nút Feature của Code Khách
local AimTargetToggle = false
local AimClosestToggle = false
local ChamsToggle = false
local LineBoxToggle = false
local ShowNameToggle = false

local AimTargetBtn = createStyledButton(Slide10, "Nút 1: Aim Target (OFF)", UDim2.new(0, 10, 0, 150), UDim2.new(0, 380, 0, 28))
local AimClosestBtn = createStyledButton(Slide10, "Nút 2: Aim người gần nhất (OFF)", UDim2.new(0, 10, 0, 183), UDim2.new(0, 380, 0, 28))
local ChamsBtn = createStyledButton(Slide10, "Nút 3: Highlight Chập (OFF)", UDim2.new(0, 10, 0, 216), UDim2.new(0, 380, 0, 28))
local LineBoxBtn = createStyledButton(Slide10, "Nút 4: Line & Box ESP (OFF)", UDim2.new(0, 10, 0, 249), UDim2.new(0, 380, 0, 28))
local ShowNameBtn = createStyledButton(Slide10, "Nút 5: Show Name ESP (OFF)", UDim2.new(0, 10, 0, 282), UDim2.new(0, 380, 0, 28))

local function toggleGuestBtn(btn, state, name)
    btn.Text = name .. " (" .. (state and "ON" or "OFF") .. ")"
    btn.BackgroundColor3 = state and Color3.fromRGB(0, 150, 0) or ThemePalette.ButtonBg
end

AimTargetBtn.MouseButton1Click:Connect(function()
    AimTargetToggle = not AimTargetToggle
    toggleGuestBtn(AimTargetBtn, AimTargetToggle, "Nút 1: Aim Target")
end)

AimClosestBtn.MouseButton1Click:Connect(function()
    AimClosestToggle = not AimClosestToggle
    toggleGuestBtn(AimClosestBtn, AimClosestToggle, "Nút 2: Aim người gần nhất")
end)

ChamsBtn.MouseButton1Click:Connect(function()
    ChamsToggle = not ChamsToggle
    toggleGuestBtn(ChamsBtn, ChamsToggle, "Nút 3: Highlight Chập")
    if not ChamsToggle then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("ChamsHighlight") then
                p.Character.ChamsHighlight:Destroy()
            end
        end
    end
end)

LineBoxBtn.MouseButton1Click:Connect(function()
    LineBoxToggle = not LineBoxToggle
    toggleGuestBtn(LineBoxBtn, LineBoxToggle, "Nút 4: Line & Box ESP")
end)

ShowNameBtn.MouseButton1Click:Connect(function()
    ShowNameToggle = not ShowNameToggle
    toggleGuestBtn(ShowNameBtn, ShowNameToggle, "Nút 5: Show Name ESP")
    if not ShowNameToggle then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("NameESP") then
                p.Character.Head.NameESP:Destroy()
            end
        end
    end
end)

-- Hàm hỗ trợ Aim & Khoảng cách
local function getClosestPlayer()
    local closest, dist = nil, math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local d = (p.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            if d < dist then
                dist = d
                closest = p
            end
        end
    end
    return closest
end

-- Bảng vẽ Drawing cho Line & Box ESP
local espCache = {}

local function clearESP(p)
    if espCache[p] then
        if espCache[p].Line then espCache[p].Line:Remove() end
        if espCache[p].Box then espCache[p].Box:Remove() end
        espCache[p] = nil
    end
end

-- Loop xử lý logic liên tục
RunService.RenderStepped:Connect(function()
    -- Logic Aim Target (Nút 1)
    if AimTargetToggle and guestSelectedPlayer and guestSelectedPlayer.Character and guestSelectedPlayer.Character:FindFirstChild("HumanoidRootPart") then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, guestSelectedPlayer.Character.HumanoidRootPart.Position)
    end
    
    -- Logic Aim Closest (Nút 2)
    if AimClosestToggle and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local target = getClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.HumanoidRootPart.Position)
        end
    end

    -- Logic Highlight Chams (Nút 3)
    if ChamsToggle then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character then
                local hl = p.Character:FindFirstChild("ChamsHighlight")
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "ChamsHighlight"
                    hl.Parent = p.Character
                end
                if p == LocalPlayer then
                    hl.FillColor = Color3.fromRGB(0, 170, 255)
                else
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                end
            end
        end
    end

    -- Logic Show Name ESP (Nút 5)
    if ShowNameToggle then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                local bbb = p.Character.Head:FindFirstChild("NameESP")
                if not bbb then
                    bbb = Instance.new("BillboardGui")
                    bbb.Name = "NameESP"
                    bbb.Size = UDim2.new(0, 100, 0, 30)
                    bbb.StudsOffset = Vector3.new(0, 2, 0)
                    bbb.AlwaysOnTop = true
                    bbb.Parent = p.Character.Head
                    
                    local txt = Instance.new("TextLabel")
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.Text = p.Name
                    txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                    txt.Font = Enum.Font.SourceSansBold
                    txt.TextSize = 14
                    txt.Parent = bbb
                end
            end
        end
    end

    -- Logic Line & Box ESP (Nút 4)
    if LineBoxToggle then
        local centerPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = p.Character.HumanoidRootPart
                local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                
                if onScreen then
                    if not espCache[p] then
                        espCache[p] = {
                            Line = Drawing.new("Line"),
                            Box = Drawing.new("Square")
                        }
                    end
                    
                    -- Vẽ Line
                    local line = espCache[p].Line
                    line.Visible = true
                    line.From = centerPos
                    line.To = Vector2.new(screenPos.X, screenPos.Y)
                    line.Color = Color3.fromRGB(255, 0, 0)
                    line.Thickness = 1.5
                    
                    -- Vẽ Box
                    local box = espCache[p].Box
                    box.Visible = true
                    box.Size = Vector2.new(2000 / screenPos.Z, 3000 / screenPos.Z)
                    box.Position = Vector2.new(screenPos.X - box.Size.X / 2, screenPos.Y - box.Size.Y / 2)
                    box.Color = Color3.fromRGB(255, 0, 0)
                    box.Thickness = 1.5
                else
                    clearESP(p)
                end
            else
                clearESP(p)
            end
        end
    else
        for p, _ in pairs(espCache) do
            clearESP(p)
        end
    end
end)

