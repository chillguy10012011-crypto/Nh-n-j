-- 2. Hàm lấy Stage tiếp theo thông minh
local function getNextSpawnPart()
    local stagesFolder = Workspace:FindFirstChild("Stages") or Workspace:FindFirstChild("Checkpoints") or Workspace:FindFirstChild("Spawns")
    
    local currentLevel = 0
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        local stageStat = leaderstats:FindFirstChild("Stage") or leaderstats:FindFirstChild("Level")
        if stageStat then currentLevel = stageStat.Value end
    end

    if stagesFolder then
        local nextStage = stagesFolder:FindFirstChild(tostring(currentLevel + 1)) or stagesFolder:FindFirstChild("Stage" .. (currentLevel + 1))
        if nextStage then
            return nextStage:IsA("BasePart") and nextStage or nextStage:FindFirstChildWhichIsA("BasePart")
        end
    end

    local nearestNext = nil
    local shortestDist = math.huge
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local myPos = char.HumanoidRootPart.Position
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local name = obj.Name:lower()
                if name:find("spawn") or name:find("checkpoint") or name:find("stage") or name:find("pad") then
                    local dist = (myPos - obj.Position).Magnitude
                    if dist > 8 and dist < shortestDist then
                        shortestDist = dist
                        nearestNext = obj
                    end
                end
            end
        end
    end
    return nearestNext
end

local isFarming = false

farmButton.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        farmButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        farmButton.Text = "⏹️ DỪNG FARM"
        
        task.spawn(function()
            while isFarming do
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local rootPart = safeCloneRef(character.HumanoidRootPart)
                    local targetPart = getNextSpawnPart()
                    
                    if targetPart then
                        -- Bắt Game ÉP LOAD vùng đất nơi chứa targetPart
                        pcall(function()
                            Workspace:RequestStreamAsync(targetPart.Position)
                        end)
                        
                        task.wait(0.1)
                        
                        -- Teleport chính xác đến SpawnPart
                        rootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                        statusLabel.Text = "✨ Đã ép Load & Húp mốc:\n" .. targetPart.Name
                    else
                        statusLabel.Text = "🔍 Đang tìm Stage tiếp theo..."
                    end
                end
                task.wait(0.35)
            end
        end)
    else
        farmButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        farmButton.Text = "🚀 BẬT AUTO FARM (ÉP LOAD MAP)"
        statusLabel.Text = "⏹️ Đã dừng Farm."
    end
end)

