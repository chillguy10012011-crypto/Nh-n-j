-- =========================================================================
-- LOGIC QUẢN LÝ MODE & HIỂN THỊ TRANG
-- =========================================================================
local currentMode = 2 -- Mặc định Mode 2: Nhiều Trang
local rawCapturedLogs = {}

ModeBtn.MouseButton1Click:Connect(function()
    if currentMode == 2 then
        currentMode = 1
        ModeBtn.Text = "Mode: 📄 Một Trang"
        NavFrame.Visible = false
        ScrollingFrame.Size = UDim2.new(1, -20, 0, 295)
        ScrollingFrame.Position = UDim2.new(0, 10, 0, 160)
    else
        currentMode = 2
        ModeBtn.Text = "Mode: 🌐 Nhiều Trang"
        NavFrame.Visible = true
        ScrollingFrame.Size = UDim2.new(1, -20, 0, 265)
        ScrollingFrame.Position = UDim2.new(0, 10, 0, 190)
    end
    updateDisplay()
end)

local pages = {}
local currentPage = 1

function updateDisplay()
    if #rawCapturedLogs == 0 then
        PageLabel.Text = "Trang: 0 / 0"
        OutputBox.Text = "-- Không có dữ liệu."
        OutputBox.Size = UDim2.new(1, 0, 0, 0)
        return
    end

    local fullText = table.concat(rawCapturedLogs, "\n")

    if currentMode == 1 then
        -- Mode 1: Gom tất cả vào 1 trang duy nhất
        PageLabel.Text = "Mode: Một Trang"
        OutputBox.Text = fullText
        local lines = 1
        for _ in fullText:gmatch("\n") do lines = lines + 1 end
        OutputBox.Size = UDim2.new(1, 0, 0, math.max(295, lines * 15 + 20))
    else
        -- Mode 2: Chia theo giới hạn số dòng người dùng cài đặt
        local maxLinesPerTrang = tonumber(LineInput.Text) or 500
        pages = {}
        
        local currentChunkLines = {}
        local lineCount = 0
        
        for line in (fullText .. "\n"):gmatch("(.-)\n") do
            table.insert(currentChunkLines, line)
            lineCount = lineCount + 1
            if lineCount >= maxLinesPerTrang then
                table.insert(pages, table.concat(currentChunkLines, "\n"))
                currentChunkLines = {}
                lineCount = 0
            end
        end
        if #currentChunkLines > 0 then
            table.insert(pages, table.concat(currentChunkLines, "\n"))
        end

        if currentPage < 1 then currentPage = 1 end
        if currentPage > #pages then currentPage = #pages end
        
        PageLabel.Text = string.format("Trang: %d / %d", currentPage, #pages)
        local pageText = pages[currentPage] or ""
        OutputBox.Text = pageText
        
        local lines = 1
        for _ in pageText:gmatch("\n") do lines = lines + 1 end
        OutputBox.Size = UDim2.new(1, 0, 0, math.max(265, lines * 15 + 20))
    end
end

PrevBtn.MouseButton1Click:Connect(function()
    if currentMode == 2 and currentPage > 1 then
        currentPage = currentPage - 1
        updateDisplay()
    end
end)

NextBtn.MouseButton1Click:Connect(function()
    if currentMode == 2 and currentPage < #pages then
        currentPage = currentPage + 1
        updateDisplay()
    end
end)

-- -------------------------------------------------------------------------
-- LOGIC BẪY BÓC TÁC CODE
-- -------------------------------------------------------------------------
ExecButton.MouseButton1Click:Connect(function()
    local rawCode = InputBox.Text
    if rawCode == "" then
        OutputBox.Text = "⚠️ Lỗi: Vui lòng nhập code!"
        return
    end

    OutputBox.Text = "⏳ Đang bóc tách dữ liệu..."
    rawCapturedLogs = {}
    pages = {}
    currentPage = 1

    local old_loadstring = loadstring
    local loadCount = 0

    local interceptedHttpGet = function(self, url)
        loadCount = loadCount + 1
        local header = string.format("\n\n-- [HTTPGET #%d]: %s\n", loadCount, tostring(url))
        
        local success, fileContent = pcall(function()
            return game:HttpGet(url)
        end)
        
        if success then
            table.insert(rawCapturedLogs, header .. fileContent)
            updateDisplay()
            return fileContent
        else
            table.insert(rawCapturedLogs, header .. "-- [LỖI TẢI LINK]")
            updateDisplay()
            return ""
        end
    end

    local function recursiveTrap(codeChunk, chunkName)
        loadCount = loadCount + 1
        local header = string.format("\n\n-- [LOADSTRING #%d] - Chunk: %s\n", loadCount, tostring(chunkName))
        table.insert(rawCapturedLogs, header .. tostring(codeChunk))
        updateDisplay()
        
        local realFunc, loadErr = old_loadstring(codeChunk, chunkName)
        if realFunc then
            local envProxy
            envProxy = setmetatable({
                loadstring = function(subChunk, subName)
                    return recursiveTrap(subChunk, subName)
                end,
                game = setmetatable({
                    HttpGet = function(s, u)
                        return interceptedHttpGet(s, u)
                    end
                }, {
                    __index = game
                })
            }, {
                __index = getgenv(),
            })
            
            setfenv(realFunc, envProxy)
            pcall(realFunc)
            return realFunc
        else
            return function() end
        end
    end

    getgenv().loadstring = function(codeChunk, chunkName)
        return recursiveTrap(codeChunk, chunkName)
    end

    local envProxyTop = setmetatable({
        game = setmetatable({
            HttpGet = function(s, u)
                return interceptedHttpGet(s, u)
            end
        }, {
            __index = game
        })
    }, {
        __index = getgenv(),
    })

    local success, err = pcall(function()
        local func, loadErr = old_loadstring(rawCode)
        if func then
            setfenv(func, envProxyTop)
            func()
        else
            OutputBox.Text = "❌ Lỗi cú pháp ban đầu:\n" .. tostring(loadErr)
        end
    end)

    getgenv().loadstring = old_loadstring

    if not success and #rawCapturedLogs == 0 then
        OutputBox.Text = "⚠️ Lỗi thực thi:\n" .. tostring(err)
    elseif #rawCapturedLogs > 0 then
        updateDisplay()
    end
end)
