-- Khởi tạo dịch vụ và người chơi
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Xóa GUI cũ nếu tồn tại
if PlayerGui:FindFirstChild("FreePartGui") then
    PlayerGui.FreePartGui:Destroy()
end

-- Tạo ScreenGui
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FreePartGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

-- Tạo khung chính (MainFrame)
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 240, 0, 130)
MainFrame.Position = UDim2.new(0.5, -120, 0.5, -65)
MainFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
MainFrame.BorderColor3 = Color3.fromRGB(0, 170, 255)
MainFrame.BorderSizePixel = 2
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

-- Tiêu đề GUI
local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 35)
Title.BackgroundTransparency = 1
Title.Text = "Free Part Controller"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 16
Title.Parent = MainFrame

-- Nút Bật/Tắt
local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(0.85, 0, 0, 50)
ToggleBtn.Position = UDim2.new(0.075, 0, 0.45, 0)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
ToggleBtn.BorderColor3 = Color3.fromRGB(0, 170, 255)
ToggleBtn.Text = "Trạng thái: TẮT"
ToggleBtn.TextColor3 = Color3.fromRGB(255, 85, 85)
ToggleBtn.Font = Enum.Font.SourceSansBold
ToggleBtn.TextSize = 16
ToggleBtn.Parent = MainFrame

-- Biến trạng thái
local isEnabled = false
local freePart = nil
local connection = nil

ToggleBtn.MouseButton1Click:Connect(function()
    isEnabled = not isEnabled
    
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if isEnabled then
        ToggleBtn.Text = "Trạng thái: BẬT"
        ToggleBtn.TextColor3 = Color3.fromRGB(85, 255, 85)
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 150)
        
        if hrp then
            -- 1. Tạo một Part tự do (Anchored = false) trong Workspace
            freePart = Instance.new("Part")
            freePart.Name = "ControlledFreePart"
            freePart.Size = Vector3.new(3, 3, 3)
            freePart.CFrame = hrp.CFrame * CFrame.new(0, 5, 0)
            freePart.Anchored = false -- Part tự do theo yêu cầu
            freePart.CanCollide = true
            freePart.Transparency = 0.3 -- Chỉnh thành 1 nếu muốn ẩn hoàn toàn
            freePart.Parent = workspace
            
            -- 2. Vòng lặp điều khiển Part tự do chạy theo ý muốn hoặc gia tăng vận tốc trên Executor
            connection = RunService.Heartbeat:Connect(function()
                if freePart and freePart.Parent and hrp then
                    -- Bạn có thể viết code điều khiển phần Part tự do ở đây (ví dụ: bám theo hướng nhìn hoặc bay lượn)
                    -- Đảm bảo Server công nhận thông qua Network Ownership của Client
                    pcall(function()
                        freePart:SetNetworkOwner(LocalPlayer)
                    end)
                end
            end)
        end
    else
        ToggleBtn.Text = "Trạng thái: TẮT"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 85, 85)
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        
        -- Ngắt kết nối vòng lặp
        if connection then
            connection:Disconnect()
            connection = nil
        end
        
        -- Xóa Part khi tắt để tránh gây lag
        if freePart then
            freePart:Destroy()
            freePart = nil
        end
    end
end)
