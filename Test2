-- Khởi tạo các dịch vụ cần thiết
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local PhysicsService = game:GetService("PhysicsService")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

-- 1. Tạo GUI Bật/Tắt Fling
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ArmFlingGUI"
ScreenGui.ResetOnSpawn = false
pcall(function()
    ScreenGui.Parent = game:GetService("CoreGui")
end)
if not ScreenGui.Parent then
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

local ToggleButton = Instance.new("TextButton")
ToggleButton.Size = UDim2.new(0, 140, 0, 50)
ToggleButton.Position = UDim2.new(0, 50, 0, 150)
ToggleButton.Text = "Arm Fling: OFF"
ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.TextScaled = true
ToggleButton.Font = Enum.Font.SourceSansBold
ToggleButton.Active = true
ToggleButton.Draggable = true
ToggleButton.Parent = ScreenGui

local isFlinging = false
local flingPart = nil
local connection = nil

-- 2. Thiết lập Collision Group để tránh tự va chạm với chính mình
local groupName = "AntiSelfCollisionArm"
pcall(function()
    PhysicsService:CreateCollisionGroup(groupName)
    PhysicsService:CollisionGroupSetCollidable(groupName, groupName, false)
end)

-- 3. Xử lý logic khi bấm nút
ToggleButton.MouseButton1Click:Connect(function()
    isFlinging = not isFlinging
    
    -- Cập nhật lại Character và tìm tay phải (Hỗ trợ cả R6: "Right Arm" và R15: "RightHand" hoặc "RightLowerArm")
    Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local rightArm = Character:FindFirstChild("RightHand") 
                  or Character:FindFirstChild("Right Arm") 
                  or Character:FindFirstChild("RightLowerArm")
    
    if isFlinging then
        if not rightArm then
            ToggleButton.Text = "Không tìm thấy tay!"
            task.wait(1)
            ToggleButton.Text = "Arm Fling: OFF"
            isFlinging = false
            return
        end
        
        ToggleButton.Text = "Arm Fling: ON"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        
        -- Tạo Part ẩn
        flingPart = Instance.new("Part")
        flingPart.Name = "ArmFlingHitbox"
        flingPart.Size = Vector3.new(4, 4, 4)
        flingPart.Transparency = 1 -- Trong suốt tuyệt đối
        flingPart.CanCollide = true -- Vẫn gây va chạm vật lý với người khác
        flingPart.Massless = true   -- Không làm tay bị nặng/trĩu xuống
        flingPart.CFrame = rightArm.CFrame
        
        -- Gán CollisionGroup
        pcall(function()
            flingPart.CollisionGroupId = PhysicsService:GetCollisionGroupId(groupName)
        end)
        
        flingPart.Parent = Character

        -- Hàn chặt vào TAY phải bằng WeldConstraint (Server ghi nhận Network Ownership)
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = rightArm
        weld.Part1 = flingPart
        weld.Parent = flingPart

        -- Vòng lặp xoay phần Part ẩn gắn ở tay với tốc độ cực cao
        connection = RunService.Heartbeat:Connect(function()
            if not flingPart or not rightArm or not Character:FindFirstChild("Humanoid") then return end
            
            -- Tạo góc xoay ngẫu nhiên tốc độ cao
            local randomAngle = CFrame.Angles(
                math.rad(math.random(-720, 720)),
                math.rad(math.random(-720, 720)),
                math.rad(math.random(-720, 720))
            )
            
            -- Ép dịch chuyển tọa độ liên tục quanh vị trí của tay
            flingPart.CFrame = rightArm.CFrame * randomAngle
        end)
        
    else
        ToggleButton.Text = "Arm Fling: OFF"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        
        -- Dọn dẹp kết nối và xóa Part khi tắt
        if connection then
            connection:Disconnect()
            connection = nil
        end
        
        if flingPart then
            flingPart:Destroy()
            flingPart = nil
        end
    end
end)
