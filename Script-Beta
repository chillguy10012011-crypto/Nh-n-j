local ColorBox = createStyledTextBox(Slide3, "Ví dụ: 0, 170, 255", UDim2.new(0.025, 0, 0, 70), UDim2.new(0.95, 0, 0, 30))
ColorBox.FocusLost:Connect(function()
    local r, g, b = ColorBox.Text:match("(%d+)%s*,%s*(%d+)%s*,%s*(%d+)")
    if r and g and b then
        r, g, b = tonumber(r), tonumber(g), tonumber(b)
        if r <= 255 and g <= 255 and b <= 255 then
            local newColor = Color3.fromRGB(r, g, b)
            for _, border in pairs(registeredBorders) do
                if border and border.Parent then
                    border.BorderColor3 = newColor
                end
            end
            for _, txt in pairs(registeredTexts) do
                if txt and txt.Parent then
                    txt.TextColor3 = newColor
                end
            end
            ColorBox.Text = "Đã đổi màu viền thành công!"
            return
        end
    end
    ColorBox.Text = "Định dạng sai! Nhập lại (VD: 255, 0, 0)"
end)

local RGBToggle = false
local rgbConnection = nil

createKeybindButton(Slide3, "Chế độ viền cầu vồng (RGB)", UDim2.new(0.025, 0, 0, 110), UDim2.new(0.95, 0, 0, 30), nil, function(state)
    RGBToggle = state
    if RGBToggle then
        rgbConnection = RunService.RenderStepped:Connect(function()
            local hue = (tick() % 5) / 5
            local rainbowColor = Color3.fromHSV(hue, 1, 1)
            for _, border in pairs(registeredBorders) do
                if border and border.Parent then
                    border.BorderColor3 = rainbowColor
                end
            end
            for _, txt in pairs(registeredTexts) do
                if txt and txt.Parent then
                    txt.TextColor3 = rainbowColor
                end
            end
        end)
    else
        if rgbConnection then
            rgbConnection:Disconnect()
            rgbConnection = nil
        end
        for _, border in pairs(registeredBorders) do
            if border and border.Parent then
                border.BorderColor3 = Color3.fromRGB(0, 170, 255)
            end
        end
        for _, txt in pairs(registeredTexts) do
            if txt and txt.Parent then
                txt.TextColor3 = Color3.fromRGB(0, 170, 255)
            end
        end
    end
end)

