local ScaleSliderFrame = Instance.new("Frame")
ScaleSliderFrame.Size = UDim2.new(0, 370, 0, 15)
ScaleSliderFrame.Position = UDim2.new(0, 10, 0, 235)
ScaleSliderFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
ScaleSliderFrame.BorderColor3 = Color3.fromRGB(0, 170, 255)
ScaleSliderFrame.BorderSizePixel = 1
ScaleSliderFrame.Parent = Slide5

table.insert(registeredBorders, ScaleSliderFrame)

local ScaleSliderFill = Instance.new("Frame")
ScaleSliderFill.Size = UDim2.new((1.0 - 0.5) / (2.0 - 0.5), 0, 1, 0)
ScaleSliderFill.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
ScaleSliderFill.BorderSizePixel = 0
ScaleSliderFill.Parent = ScaleSliderFrame

local isDraggingScale = false

local function updateScaleFromValue(val)
    val = math.clamp(val, 0.5, 2.0)
    local roundedScale = math.floor(val * 100 + 0.5) / 100
    MainScale.Scale = roundedScale
    ScaleSliderFill.Size = UDim2.new((roundedScale - 0.5) / 1.5, 0, 1, 0)
    ScaleLabel.Text = "Kích thước GUI (UIScale): " .. string.format("%.2f", roundedScale) .. "x"
end

local function updateScaleFromInput(input)
    local relativeX = input.Position.X - ScaleSliderFrame.AbsolutePosition.X
    local pct = math.clamp(relativeX / ScaleSliderFrame.AbsoluteSize.X, 0, 1)
    local val = 0.5 + (pct * 1.5)
    updateScaleFromValue(val)
end

ScaleSliderFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingScale = true
        updateScaleFromInput(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDraggingScale and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateScaleFromInput(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingScale = false
    end
end)
