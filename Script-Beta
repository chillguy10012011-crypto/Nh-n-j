createKeybindButton(Slide1, "Desync (Mất đồng bộ)", UDim2.new(0.025, 0, 0, 198), UDim2.new(0.95, 0, 0, 28), nil, function(state)
    DesyncToggle = state
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if DesyncToggle then
        if hum then originalWalkSpeed = hum.WalkSpeed end
        
        desyncConnection = RunService.Heartbeat:Connect(function()
            if DesyncToggle and hrp then
                local oldCFrame = hrp.CFrame
                hrp.CFrame = oldCFrame * CFrame.new(math.random(-desyncBoostVal, desyncBoostVal)/10, 0, math.random(-desyncBoostVal, desyncBoostVal)/10)
                RunService.RenderStepped:Wait()
                hrp.CFrame = oldCFrame
            end
        end)
    else
        if desyncConnection then
            desyncConnection:Disconnect()
            desyncConnection = nil
        end
        if hum then hum.WalkSpeed = originalWalkSpeed end
    end
end)

