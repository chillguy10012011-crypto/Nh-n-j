        local lineCount = 0
        
        for line in (fullText .. "\n"):gmatch("(.-)\n") do
            table.insert(currentChunkLines, line)
            lineCount = lineCount + 1
            if lineCount >= maxLinesPerTrang then
                table.insert(pages, table.concat(currentChunkLines, "\n"))
                currentChunkLines = {}
                lineCount = 0
            end
        end
        if #currentChunkLines > 0 then
            table.insert(pages, table.concat(currentChunkLines, "\n"))
        end

        if currentPage < 1 then currentPage = 1 end
        if currentPage > #pages then currentPage = #pages end
        
        PageLabel.Text = string.format("Trang: %d / %d", currentPage, #pages)
        local pageText = pages[currentPage] or ""
        OutputBox.Text = pageText
        
        local lines = 1
        for _ in pageText:gmatch("\n") do lines = lines + 1 end
        OutputBox.Size = UDim2.new(1, 0, 0, math.max(255, lines * 14 + 20))
    end
end

PrevBtn.MouseButton1Click:Connect(function()
    if currentMode == 2 and currentPage > 1 then
        currentPage = currentPage - 1
        updateDisplay()
    end
end)

NextBtn.MouseButton1Click:Connect(function()
    if currentMode == 2 and currentPage < #pages then
        currentPage = currentPage + 1
        updateDisplay()
    end
end)

-- Bóc tách nâng cao (Fix Request + Auto Direct Fetch)
ExecButton.MouseButton1Click:Connect(function()
    local rawInput = InputBox.Text
    if rawInput == "" then
        OutputBox.Text = "⚠️ Lỗi: Vui lòng nhập link hoặc code vào ô!"
        return
    end

    OutputBox.Text = "⏳ Đang bóc tách dữ liệu..."
    rawCapturedLogs = {}
    pages = {}
    currentPage = 1
    local loadCount = 0

    local function advancedFetch(url)
        if not httpRequest then
            local success, res = pcall(function() return real_httpget(game, url) end)
            return success, res
        end

        local res = pcall(function()
            return httpRequest({
                Url = url,
                Method = "GET",
                Headers = {
                    ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
                    ["Accept"] = "*/*",
                }
            })
        end)

        if res and type(res) == "table" and res.Body then
            return true, res.Body
        else
            local success, content = pcall(function() return real_httpget(game, url) end)
            if success then return true, content end
        end
        return false, "Lỗi kết nối"
    end

    local interceptedHttpGet = function(self, url)
        loadCount = loadCount + 1
        local header = string.format("\n\n-- [HTTPGET #%d]: %s\n", loadCount, tostring(url))
        local success, fileContent = advancedFetch(url)
        if success then
            table.insert(rawCapturedLogs, header .. fileContent)
            updateDisplay()
            return fileContent
        else
            table.insert(rawCapturedLogs, header .. "-- [LỖI TẢI LINK]")
            updateDisplay()
            return ""
        end
    end

    if rawInput:match("^https?://") then
        OutputBox.Text = "⏳ Đang tải link trực tiếp..."
        local success, content = advancedFetch(rawInput)
        if success then
            table.insert(rawCapturedLogs, "-- [DIRECT LINK DUMP]: " .. rawInput .. "\n\n" .. content)
            updateDisplay()
        else
            OutputBox.Text = "❌ Không thể tải link này. Hãy bật nút [Hook] rồi chạy script trong game!"
        end
        return
    end

    local function recursiveTrap(codeChunk, chunkName)
        loadCount = loadCount + 1
        local header = string.format("\n\n-- [LOADSTRING #%d] - Chunk: %s\n", loadCount, tostring(chunkName))
        table.insert(rawCapturedLogs, header .. tostring(codeChunk))
        updateDisplay()
        
        local realFunc, loadErr = originalLoadstring(codeChunk, chunkName)
        if realFunc then
            local envProxy = setmetatable({
                loadstring = function(subChunk, subName) return recursiveTrap(subChunk, subName) end,
                game = setmetatable({ HttpGet = function(s, u) return interceptedHttpGet(s, u) end }, { __index = game })
            }, { __index = getgenv() })
            setfenv(realFunc, envProxy)
            pcall(realFunc)
            return realFunc
        else
            return function() end
        end
    end

    getgenv().loadstring = function(codeChunk, chunkName) return recursiveTrap(codeChunk, chunkName) end

    local envProxyTop = setmetatable({
        game = setmetatable({ HttpGet = function(s, u) return interceptedHttpGet(s, u) end }, { __index = game })
    }, { __index = getgenv() })

    pcall(function()
        local func = originalLoadstring(rawInput)
        if func then
            setfenv(func, envProxyTop)
            func()
        end
    end)

    getgenv().loadstring = originalLoadstring
    if #rawCapturedLogs > 0 then updateDisplay() end
end)
