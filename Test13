-- Hàm thêm dòng log mới
local function logMessage(msg)
	local timestamp = os.date("%H:%M:%S")
	LogBox.Text = LogBox.Text .. "[" .. timestamp .. "]: " .. msg .. "\n"
end

-- Xử lý sự kiện khi nhấn nút Execute
ExecuteBtn.MouseButton1Click:Connect(function()
	local userCode = CodeBox.Text
	
	if userCode == "" then
		logMessage("Lỗi: Khung code đang trống!")
		return
	end
	
	logMessage("Đang biên dịch và thực thi code...")
	
	-- Dùng loadstring để chạy code người dùng nhập vào
	local success, err = pcall(function()
		local func = loadstring(userCode)
		if func then
			func()
		else
			error("Lỗi cú pháp (Syntax Error)")
		end
	end)
	
	if success then
		logMessage("Thực thi thành công!")
	else
		logMessage("Lỗi thực thi: " tostring(err))
	end
end)
