--// Lấy các bộ phận cơ thể thực tế (Hỗ trợ R6 và R15)
local function getBodyPart(id)
    if id == "Head" then return character:FindFirstChild("Head")
    elseif id == "Torso" then return character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    elseif id == "LeftArm" then return character:FindFirstChild("Left Arm") or character:FindFirstChild("LeftUpperArm")
    elseif id == "RightArm" then return character:FindFirstChild("Right Arm") or character:FindFirstChild("RightUpperArm")
    elseif id == "LeftLeg" then return character:FindFirstChild("Left Leg") or character:FindFirstChild("LeftUpperLeg")
    elseif id == "RightLeg" then return character:FindFirstChild("Right Leg") or character:FindFirstChild("RightUpperLeg")
    end
end

--// Logic chính khi Bật / Tắt
local isActive = false
local mainPart = nil
local renderConnection = nil

activateBtn.MouseButton1Click:Connect(function()
    isActive = not isActive
    
    if isActive then
        activateBtn.Text = "ĐANG BẬT (TẮT)"
        activateBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        
        -- 1. Tạo Main Part hình vuông, mờ, có lửa
        mainPart = Instance.new("Part")
        mainPart.Name = "MainFloatingPart"
        mainPart.Size = Vector3.new(4, 1, 4)
        mainPart.Shape = Enum.PartType.Block
        mainPart.Transparency = 0.6
        mainPart.CanCollide = false
        mainPart.Anchored = false
        mainPart.Position = rootPart.Position + Vector3.new(0, 5, 0)
        mainPart.Parent = workspace
        
        local fire = Instance.new("Fire")
        fire.Size = 8
        fire.Heat = 10
        fire.Parent = mainPart

        -- Lưu trạng thái ban đầu của các bộ phận để khi tắt khôi phục lại
        local originalStates = {}
        for _, pData in ipairs(partsList) do
            if pData.Id ~= "All" then
                local part = getBodyPart(pData.Id)
                if part then
                    originalStates[part] = {Anchored = part.Anchored, CanCollide = part.CanCollide}
                end
            end
        end

        -- 2. Đổi Camera sang theo dõi Main Part
        workspace.CurrentCamera.CameraSubject = mainPart
        
        -- 3. Vòng lặp cập nhật mỗi khung hình
        renderConnection = RunService.RenderStepped:Connect(function(dt)
            if not mainPart or not character then return end
            
            -- Điều khiển Main Part bằng MoveDirection (Hỗ trợ cả Joystick di động và WASD trên PC)
            local moveDir = humanoid.MoveDirection
            local speed = 500
            
            if moveDir.Magnitude > 0 then
                mainPart.CFrame = mainPart.CFrame + (moveDir * speed * dt)
            end
            
            -- Ép nhân vật bám theo Main Part và tăng tốc độ / tốc độ xoay góc
            humanoid.WalkSpeed = 500
            rootPart.CFrame = CFrame.new(mainPart.Position)
            
            -- Xử lý các bộ phận cơ thể dựa theo lựa chọn
            for _, pData in ipairs(partsList) do
                if pData.Id ~= "All" then
                    local part = getBodyPart(pData.Id)
                    if part then
                        if pData.Selected then
                            -- Bật va chạm và luôn đi theo Main Part
                            part.CanCollide = true
                            part.Anchored = false
                            part.CFrame = mainPart.CFrame
                        else
                            -- Đóng băng tại vị trí hiện tại
                            part.Anchored = true
                        end
                    end
                end
            end
        end)
        
    else
        -- KHI TẮT
        activateBtn.Text = "BẬT (ACTIVATE)"
        activateBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
        
        if renderConnection then
            renderConnection:Disconnect()
            renderConnection = nil
        end
        
        -- Khóa vận tốc tối đa ở mức 0 trong 2s để tránh lỗi văng (fling)
        humanoid.WalkSpeed = 0
        if rootPart then
            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
        
        -- Mở khóa các bộ phận (unanchor)
        for _, pData in ipairs(partsList) do
            if pData.Id ~= "All" then
                local part = getBodyPart(pData.Id)
                if part then
                    part.Anchored = false
                end
            end
        end
        
        -- Chờ 2 giây theo yêu cầu để tránh lỗi
        task.wait(2)
        
        -- Reset lại vận tốc và thông số mặc định
        humanoid.WalkSpeed = 16
        
        -- Xóa Main Part
        if mainPart then
            mainPart:Destroy()
            mainPart = nil
        end
        
        -- Trả camera về lại đầu nhân vật
        if character and character:FindFirstChild("Head") then
            workspace.CurrentCamera.CameraSubject = character.Head
        end
    end
end)
