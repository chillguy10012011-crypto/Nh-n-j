-- Xử lý sự kiện khi nhấn nút Execute
ExecuteBtn.MouseButton1Click:Connect(function()
    local codeToRun = CodeBox.Text
    if codeToRun == "" then
        LogBox.Text = "[Lỗi]\nChưa nhập code để chạy!"
        return
    end

    -- Bắt khoảnh khắc thời gian thực thi
    local startTime = tick()
    
    -- Dùng loadstring để biên dịch và chạy đoạn code người dùng nhập
    local success, err = pcall(function()
        local func = loadstring(codeToRun)
        if func then
            func()
        else
            error("Lỗi cú pháp (Syntax Error)")
        end
    end)

    local endTime = tick()
    local duration = string.format("%.4f", endTime - startTime)

    -- Hiển thị kết quả vào khung bắt khoảnh khắc bên phải
    if success then
        LogBox.Text = "[Thành công]\nKhoảnh khắc:\n- Chạy xong trong: " .. duration .. "s\n- Trạng thái: OK"
    else
        LogBox.Text = "[Thất bại]\nLỗi:\n" .. tostring(err)
    end
end)

-- Xử lý sự kiện nút Clear
ClearBtn.MouseButton1Click:Connect(function()
    CodeBox.Text = ""
    LogBox.Text = "[Trạng thái]\nĐã làm sạch."
end)
