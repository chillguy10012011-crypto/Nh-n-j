-- -------------------------------------------------------------------------
-- LOGIC SIÊU BẪY AN TOÀN (BẢO VỆ CHỐNG TRÀN BỘ NHỚ)
-- -------------------------------------------------------------------------
ExecButton.MouseButton1Click:Connect(function()
    local rawCode = InputBox.Text
    if rawCode == "" then
        OutputBox.Text = "⚠️ Lỗi: Vui lòng nhập code vào khung bên trên!"
        return
    end

    OutputBox.Text = "⏳ Đang quét mạng và bóc tách dữ liệu..."

    local old_loadstring = loadstring
    local capturedChunks = {}
    local loadCount = 0

    local interceptedHttpGet = function(self, url)
        loadCount = loadCount + 1
        local header = string.format("\n\n-- ========================================\n-- [PHÁT HIỆN LINK HTTPGET THỨ %d]\n-- Link: %s\n-- ========================================\n", loadCount, tostring(url))
        
        local success, fileContent = pcall(function()
            return game:HttpGet(url)
        end)
        
        if success then
            local length = #fileContent
            local displayContent = fileContent
            
            -- Nếu file quá dài (> 100k ký tự), ta cắt bớt khi hiển thị lên màn hình GUI để tránh lỗi văng game
            if length > 100000 then
                displayContent = fileContent:sub(1, 100000) .. "\n\n-- [⚠️ CẢNH BÁO]: Nội dung quá lớn (" .. length .. " ký tự). Đã cắt bớt hiển thị trên màn hình, nhưng toàn bộ file gốc đã được lưu nguyên vẹn vào thư mục workspace!"
            end

            local fullContent = header .. displayContent
            table.insert(capturedChunks, fullContent)
            
            -- Cập nhật giao diện an toàn dưới 180,000 ký tự
            local combinedText = table.concat(capturedChunks, "\n")
            if #combinedText > 180000 then
                OutputBox.Text = combinedText:sub(1, 180000) .. "\n\n-- [⚠️ THÔNG BÁO]: Giao diện đã đạt giới hạn hiển thị ký tự của Roblox!"
            else
                OutputBox.Text = combinedText
            end

            -- ⭐ TỰ ĐỘNG LƯU FILE GỐC VÀO MÁY (Workspace của Executor)
            if writefile then
                local safeFileName = "Deobfuscated_Script_" .. loadCount .. ".txt"
                pcall(function()
                    writefile(safeFileName, fileContent)
                end)
            end

            return fileContent
        else
            local errContent = header .. "-- [LỖI] Không thể tải nội dung từ link này: " .. tostring(fileContent)
            table.insert(capturedChunks, errContent)
            OutputBox.Text = table.concat(capturedChunks, "\n")
            return ""
        end
    end

    local function recursiveTrap(codeChunk, chunkName)
        loadCount = loadCount + 1
        local header = string.format("\n\n-- ========================================\n-- [LOADSTRING TẦNG THỨ %d] - Chunk: %s\n-- ========================================\n", loadCount, tostring(chunkName))
        local displayChunk = tostring(codeChunk)
        if #displayChunk > 100000 then
            displayChunk = displayChunk:sub(1, 100000) .. "\n\n-- [⚠️ CẢNH BÁO]: Chunk quá lớn đã được cắt ngắn hiển thị."
        end
        
        local fullChunkContent = header .. displayChunk
        table.insert(capturedChunks, fullChunkContent)
        
        local combinedText = table.concat(capturedChunks, "\n")
        if #combinedText > 180000 then
            OutputBox.Text = combinedText:sub(1, 180000) .. "\n\n-- [⚠️ THÔNG BÁO]: Giao diện đạt giới hạn hiển thị."
        else
            OutputBox.Text = combinedText
        end
        
        local realFunc, loadErr = old_loadstring(codeChunk, chunkName)
        if realFunc then
            local envProxy
            envProxy = setmetatable({
                loadstring = function(subChunk, subName)
                    return recursiveTrap(subChunk, subName)
                end,
                game = setmetatable({
                    HttpGet = function(s, u)
                        return interceptedHttpGet(s, u)
                    end
                }, {
                    __index = game
                })
            }, {
                __index = getgenv(),
            })
            
            setfenv(realFunc, envProxy)
            pcall(realFunc)
            return realFunc
        else
            return function() end
        end
    end

    getgenv().loadstring = function(codeChunk, chunkName)
        return recursiveTrap(codeChunk, chunkName)
    end

    local envProxyTop = setmetatable({
        game = setmetatable({
            HttpGet = function(s, u)
                return interceptedHttpGet(s, u)
            end
        }, {
            __index = game
        })
    }, {
        __index = getgenv(),
    })

    local success, err = pcall(function()
        local func, loadErr = old_loadstring(rawCode)
        if func then
            setfenv(func, envProxyTop)
            func()
        else
            OutputBox.Text = "❌ Lỗi cú pháp khi nạp code ban đầu:\n" .. tostring(loadErr)
        end
    end)

    getgenv().loadstring = old_loadstring

    if not success and #capturedChunks == 0 then
        OutputBox.Text = "⚠️ Thực thi kết thúc với lỗi:\n" .. tostring(err)
    elseif #capturedChunks > 0 then
        OutputBox.Text = table.concat(capturedChunks, "\n") .. "\n\n-- [HOÀN TẤT] Đã xử lý xong! Kiểm tra thư mục workspace của executor để lấy toàn bộ các file code gốc không bị cắt ngắn."
    end
end)
