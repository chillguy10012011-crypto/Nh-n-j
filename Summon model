-- Nút 1: Tạo Model kèm Part bên trong
btnCreate.MouseButton1Click:Connect(function()
	local modelName = nameInput.Text
	if modelName == "" then
		modelName = "ModelMoi"
	end

	local newModel = Instance.new("Model")
	newModel.Name = modelName

	local newPart = Instance.new("Part")
	newPart.Name = "MainPart"
	newPart.Size = Vector3.new(4, 4, 4)
	newPart.BrickColor = BrickColor.random()
	
	-- Đặt Part ngay trước mặt nhân vật
	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		newPart.CFrame = character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -10)
	else
		newPart.Position = Vector3.new(0, 10, 0)
	end
	
	newPart.Parent = newModel
	newModel.PrimaryPart = newPart
	newModel.Parent = Workspace
end)

-- Nút 2: Xoá toàn bộ Model có tên tương ứng trong Workspace
btnDelete.MouseButton1Click:Connect(function()
	local targetName = nameInput.Text
	if targetName == "" then return end

	for _, item in ipairs(Workspace:GetChildren()) do
		if item:IsA("Model") and item.Name == targetName then
			item:Destroy()
		end
	end
end)
