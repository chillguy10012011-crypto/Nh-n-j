-- // Biến điều khiển trạng thái tính năng
local isRunning = false
local mainPart = nil
local connection = nil

activeToggleBtn.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local rootPart = char.HumanoidRootPart

    if isRunning then
        activeToggleBtn.Text = "Tắt Chức Năng"
        activeToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)

        -- Tạo Main Part hình vuông, mờ, có hiệu ứng lửa, không trọng lực
        mainPart = Instance.new("Part")
        mainPart.Name = "MainPartControl"
        mainPart.Size = Vector3.new(3, 3, 3)
        mainPart.Shape = Enum.PartType.Block
        mainPart.Transparency = 0.6
        mainPart.CanCollide = false
        mainPart.Anchored = true
        mainPart.Position = rootPart.Position + Vector3.new(0, 5, 0)
        mainPart.BrickColor = BrickColor.new("Bright red")
        mainPart.Parent = workspace

        local fire = Instance.new("Fire")
        fire.Size = 6
        fire.Parent = mainPart

        camera.CameraSubject = mainPart

        -- Vòng lặp cập nhật chuyển động và vật lý
        connection = RunService.RenderStepped:Connect(function(dt)
            if not mainPart or not mainPart.Parent then return end

            -- Lấy hướng di chuyển (hỗ trợ joystick di động và WASD PC qua MoveDirection)
            local moveDir = humanoid.MoveDirection
            local speed = 50 -- Tốc độ di chuyển của Main Part
            
            -- Di chuyển Main Part theo hướng nhìn camera và hướng đi
            local camLook = camera.CFrame.LookVector
            local camRight = camera.CFrame.RightVector
            
            -- Lắng nghe input di chuyển đơn giản
            if moveDir.Magnitude > 0 then
                mainPart.Position = mainPart.Position + (moveDir * speed * dt)
            end

            -- Đồng bộ nhân vật theo Main Part với vận tốc và tốc độ xoay tăng cường
            rootPart.CFrame = CFrame.new(mainPart.Position)
            if rootPart:FindFirstChild("AssemblyLinearVelocity") then
                rootPart.AssemblyLinearVelocity = Vector3.new(500, 500, 500)
            end

            -- Tìm người chơi gần nhất trong phạm vi 15 stud
            local nearestTarget = nil
            local shortestDist = 15
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local targetRoot = p.Character.HumanoidRootPart
                    local dist = (rootPart.Position - targetRoot.Position).Magnitude
                    if dist <= shortestDist then
                        shortestDist = dist
                        nearestTarget = targetRoot
                    end
                end
            end

            local followTarget = nearestTarget or mainPart

            -- Xử lý các bộ phận cơ thể
            local partMapping = {
                ["Đầu"] = char:FindFirstChild("Head"),
                ["Thân"] = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"),
                ["Tay trái"] = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm"),
                ["Tay phải"] = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm"),
                ["Chân trái"] = char:FindFirstChild("LeftLowerLeg") or char:FindFirstChild("Left Leg"),
                ["Chân phải"] = char:FindFirstChild("RightLowerLeg") or char:FindFirstChild("Right Leg"),
            }

            for name, part in pairs(partMapping) do
                if part then
                    if selectedParts[name] then
                        part.CanCollide = true
                        part.CFrame = followTarget.CFrame
                    else
                        part.CanCollide = false
                        -- Đóng băng tại vị trí hiện tại
                        if part:IsA("BasePart") then
                            part.Anchored = true
                        end
                    end
                end
            end
        end)
    else
        activeToggleBtn.Text = "Bật Chức Năng"
        activeToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)

        if connection then
            connection:Disconnect()
            connection = nil
        end

        -- Khoá vận tốc tối đa ở mức 0 trong 2 giây
        if humanoid then
            humanoid.WalkSpeed = 0
        end

        task.delay(2, function()
            if humanoid then
                humanoid.WalkSpeed = 16 -- Trả về mặc định
            end
        end)

        -- Reset vận tốc và tốc độ xoay góc
        if rootPart then
            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            
            -- Mở băng các bộ phận cơ thể
            for _, desc in ipairs(char:GetDescendants()) do
                if desc:IsA("BasePart") then
                    desc.Anchored = false
                end
            end
        end

        -- Xoá Main Part và đưa camera về đầu nhân vật
        if mainPart then
            mainPart:Destroy()
            mainPart = nil
        end

        local head = char:FindFirstChild("Head")
        if head then
            camera.CameraSubject = head
        elseif humanoid then
            camera.CameraSubject = humanoid
        end
    end
end)
