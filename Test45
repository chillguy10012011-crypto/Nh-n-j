-- // Bảng chọn bộ phận cơ thể
local partsList = {"Tất cả", "Đầu", "Thân", "Tay trái", "Tay phải", "Chân trái", "Chân phải"}
local selectedParts = {}
for _, p in ipairs(partsList) do selectedParts[p] = false end

local listContainer = Instance.new("ScrollingFrame")
listContainer.Size = UDim2.new(1, -20, 0, 200)
listContainer.Position = UDim2.new(0, 10, 0, 50)
listContainer.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
listContainer.BorderSizePixel = 0
listContainer.CanvasSize = UDim2.new(0, 0, 0, #partsList * 35)
listContainer.Parent = mainFrame

local lcCorner = Instance.new("UICorner")
lcCorner.CornerRadius = UDim.new(0, 8)
lcCorner.Parent = listContainer

for i, partName in ipairs(partsList) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 30)
    btn.Position = UDim2.new(0, 5, 0, (i - 1) * 35 + 5)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = "[ ] " .. partName
    btn.TextSize = 13
    btn.Font = Enum.Font.Gotham
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = listContainer
    
    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(0, 6)
    bCorner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        if partName == "Tất cả" then
            local newState = not selectedParts["Tất cả"]
            for k, _ in pairs(selectedParts) do
                selectedParts[k] = newState
            end
        else
            selectedParts[partName] = not selectedParts[partName]
        end
        
        -- Cập nhật giao diện nút
        for _, child in ipairs(listContainer:GetChildren()) do
            if child:IsA("TextButton") then
                local name = child.Text:sub(5)
                if selectedParts[name] then
                    child.Text = "[X] " .. name
                    child.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
                else
                    child.Text = "[ ] " .. name
                    child.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                end
            end
        end
    end)
end

