-- Hàm tìm tất cả các phần có thể là Checkpoint / SpawnPart trong map
local function getAllSpawnParts()
    local spawns = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local nameLower = obj.Name:lower()
            -- Lọc các từ khóa nhận diện checkpoint/spawn trong game obby
            if nameLower:find("spawn") or nameLower:find("checkpoint") or nameLower:find("stage") or nameLower:find("goal") or nameLower:find("pad") then
                table.insert(spawns, obj)
            end
        end
    end
    return spawns
end

local isFarming = false

-- Chức năng Auto Farm tự động lướt qua các SpawnPart
farmButton.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        farmButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        farmButton.Text = "⏹️ DỪNG AUTO FARM"
        
        task.spawn(function()
            while isFarming do
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local rootPart = character.HumanoidRootPart
                    local spawns = getAllSpawnParts()
                    
                    statusLabel.Text = "🔍 Tìm thấy " .. #spawns .. " SpawnPart. Đang càn quét..."
                    
                    -- Sắp xếp các Spawn theo khoảng cách gần tới xa so với người chơi
                    table.sort(spawns, function(a, b)
                        local distA = (rootPart.Position - a.Position).Magnitude
                        local distB = (rootPart.Position - b.Position).Magnitude
                        return distA < distB
                    end)
                    
                    -- Lần lượt dịch chuyển qua từng SpawnPart
                    for _, spawnPart in ipairs(spawns) do
                        if not isFarming then break end
                        if spawnPart and spawnPart.Parent then
                            -- Teleport lên trên bề mặt SpawnPart một chút để tránh kẹt
                            rootPart.CFrame = spawnPart.CFrame + Vector3.new(0, 3, 0)
                            statusLabel.Text = "✨ Đã húp điểm tại:\n" .. spawnPart.Name
                            task.wait(0.4) -- Đợi 0.4 giây để server nhận diện lệnh chạm và cộng điểm
                        end
                    end
                end
                task.wait(1)
            end
        end)
    else
        farmButton.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        farmButton.Text = "🚀 BẮT ĐẦU AUTO FARM SPAWN"
        statusLabel.Text = "⏹️ Đã dừng Auto Farm."
    end
end)

-- Chức năng bấm từng bước một (Dành cho map nào có cơ chế nhạy cảm cần bấm từ từ)
local currentIndex = 1
stepButton.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local rootPart = character.HumanoidRootPart
        local spawns = getAllSpawnParts()
        
        if #spawns > 0 then
            if currentIndex > #spawns then currentIndex = 1 end
            local target = spawns[currentIndex]
            rootPart.CFrame = target.CFrame + Vector3.new(0, 3, 0)
            statusLabel.Text = "🎯 Đã nhảy đến [" .. currentIndex .. "/" .. #spawns .. "]:\n" .. target.Name
            currentIndex = currentIndex + 1
        else
            statusLabel.Text = "⚠️ Không tìm thấy SpawnPart nào trong map!"
        end
    end
end)

