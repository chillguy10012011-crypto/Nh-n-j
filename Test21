-- Xử lý logic bẫy loadstring và hiển thị
executeBtn.MouseButton1Click:Connect(function()
    local rawCode = inputBox.Text
    if rawCode == "" then
        outputBox.Text = "Lỗi: Bạn chưa nhập code vào ô phía trên!"
        return
    end

    outputBox.Text = "Đang xử lý và bẫy code..."

    -- Lưu lại loadstring gốc
    local oldLoadString = loadstring
    local capturedCode = "Không bắt được nội dung."

    -- Tạo môi trường bẫy tạm thời
    local success, err = pcall(function()
        -- Ghi đè loadstring trong phạm vi thực thi đoạn code này
        local env = setmetatable({
            loadstring = function(code, chunkname)
                capturedCode = code -- Chộp ngay khoảnh khắc code thô lộ dạng
                outputBox.Text = tostring(code) -- In thẳng ra khung output
                -- Trả về một hàm trống để ngăn script độc hại chạy thật (giữ an toàn tuyệt đối)
                return function() 
                    print("[!] Đã chặn không cho script độc hại thực thi hành vi nguy hiểm.") 
                end
            end
        }, {__index = getgenv()})

        -- Nạp và chạy đoạn code của hacker trong môi trường bẫy
        local fn, loadErr = oldLoadString(rawCode)
        if fn then
            setfenv(fn, env)
            fn()
        else
            outputBox.Text = "Lỗi khi biên soạn đoạn code đầu vào:\n" .. tostring(loadErr)
        end
    end)

    if not success then
        -- Phòng hờ nếu script tự gọi qua các đường khác
        if capturedCode == "Không bắt được nội dung." then
            outputBox.Text = "Đã xảy ra lỗi hoặc script không dùng loadstring chuẩn:\n" .. tostring(err)
        end
    end
end)
