-- ==========================================
-- SLIDE 5: Spawn model
-- ==========================================
local Slide5 = createSlide(" spawn model ")

local SpawnBox = createStyledTextBox(Slide5, "Nhập tên Model...", UDim2.new(0, 10, 0, 20), UDim2.new(0, 370, 0, 30))

local SpawnUnanchoredBtn = createStyledButton(Slide5, "Triệu hồi (Có tác động lực)", UDim2.new(0, 10, 0, 65), UDim2.new(0, 370, 0, 30))
local SpawnAnchoredBtn = createStyledButton(Slide5, "Triệu hồi (Không tác động lực)", UDim2.new(0, 10, 0, 105), UDim2.new(0, 370, 0, 30))
local DeleteModelBtn = createStyledButton(Slide5, "Xóa toàn bộ Model theo tên", UDim2.new(0, 10, 0, 145), UDim2.new(0, 370, 0, 30))

local function spawnModelLogic(isAnchored)
    local name = SpawnBox.Text
    if name == "" then return end
    
    local char = LocalPlayer.Character
    local spawnPos = char and char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.CFrame * CFrame.new(0, 0, -5) or CFrame.new(0, 10, 0)

    local newModel = Instance.new("Model")
    newModel.Name = name

    local part = Instance.new("Part")
    part.Name = "MainPart"
    part.Size = Vector3.new(4, 4, 4)
    part.CFrame = spawnPos
    part.Anchored = isAnchored
    part.CanCollide = true
    part.Material = Enum.Material.SmoothPlastic
    part.Color = Color3.fromRGB(0, 170, 255)
    part.Parent = newModel

    newModel.PrimaryPart = part
    newModel.Parent = Workspace
end

SpawnUnanchoredBtn.MouseButton1Click:Connect(function()
    spawnModelLogic(false)
end)

SpawnAnchoredBtn.MouseButton1Click:Connect(function()
    spawnModelLogic(true)
end)

DeleteModelBtn.MouseButton1Click:Connect(function()
    local name = SpawnBox.Text
    if name == "" then return end
    
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name == name then
            obj:Destroy()
        end
    end
end)

-- ==========================================
-- SLIDE 6: Fling
-- ==========================================
local Slide6 = createSlide("Fling")

-- Khai báo trạng thái bật/tắt
local SpinFlingToggle = false
local LinearFlingToggle = false
local NoclipFlingToggle = false

-- Nút 1: Spin Bot Fling
local SpinBtn = createStyledButton(Slide6, "Nút 1: Spin Bot Fling (OFF)", UDim2.new(0, 10, 0, 20), UDim2.new(0, 370, 0, 35))

-- Nút 2: LinearVelocity Fling
local LinearBtn = createStyledButton(Slide6, "Nút 2: LinearVelocity Fling (OFF)", UDim2.new(0, 10, 0, 65), UDim2.new(0, 370, 0, 35))

-- Nút 3: Noclip & Teleport Fling
local NoclipBtn = createStyledButton(Slide6, "Nút 3: Clipped Collision Fling (OFF)", UDim2.new(0, 10, 0, 110), UDim2.new(0, 370, 0, 35))

-- Biến lưu trữ đối tượng vật lý của Nút 2
local currentLinearVelocity = nil
local currentAttachment = nil

-- Sự kiện Click Nút 1
SpinBtn.MouseButton1Click:Connect(function()
    SpinFlingToggle = not SpinFlingToggle
    SpinBtn.Text = "Nút 1: Spin Bot Fling (" .. (SpinFlingToggle and "ON" or "OFF") .. ")"
    SpinBtn.BackgroundColor3 = SpinFlingToggle and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(50, 50, 50)
    
    if not SpinFlingToggle and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end
end)

-- Sự kiện Click Nút 2
LinearBtn.MouseButton1Click:Connect(function()
    LinearFlingToggle = not LinearFlingToggle
    LinearBtn.Text = "Nút 2: LinearVelocity Fling (" .. (LinearFlingToggle and "ON" or "OFF") .. ")"
    LinearBtn.BackgroundColor3 = LinearFlingToggle and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(50, 50, 50)

    if not LinearFlingToggle then
        if currentLinearVelocity then currentLinearVelocity:Destroy() currentLinearVelocity = nil end
        if currentAttachment then currentAttachment:Destroy() currentAttachment = nil end
    end
end)

-- Sự kiện Click Nút 3
NoclipBtn.MouseButton1Click:Connect(function()
    NoclipFlingToggle = not NoclipFlingToggle
    NoclipBtn.Text = "Nút 3: Clipped Collision Fling (" .. (NoclipFlingToggle and "ON" or "OFF") .. ")"
    NoclipBtn.BackgroundColor3 = NoclipFlingToggle and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(50, 50, 50)
end)

-- Vòng lặp xử lý logic vật lý
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- LOGIC NÚT 1: Spin Bot Fling (Xoay vận tốc góc cực cao)
    if SpinFlingToggle then
        hrp.AssemblyAngularVelocity = Vector3.new(0, 999999, 0)
    end

    -- LOGIC NÚT 2: LinearVelocity Force
    if LinearFlingToggle then
        if not currentAttachment or currentAttachment.Parent ~= hrp then
            if currentAttachment then currentAttachment:Destroy() end
            currentAttachment = Instance.new("Attachment")
            currentAttachment.Parent = hrp
        end
        if not currentLinearVelocity or currentLinearVelocity.Parent ~= hrp then
            if currentLinearVelocity then currentLinearVelocity:Destroy() end
            currentLinearVelocity = Instance.new("LinearVelocity")
            currentLinearVelocity.Attachment0 = currentAttachment
            currentLinearVelocity.MaxForce = 999999999
            currentLinearVelocity.VectorVelocity = Vector3.new(9999, 9999, 9999)
            currentLinearVelocity.Parent = hrp
        end
    end

    -- LOGIC NÚT 3: Noclip & Collision Reset (Xóa CanCollide và gán Velocity)
    if NoclipFlingToggle then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        hrp.AssemblyLinearVelocity = Vector3.new(99999, 99999, 99999)
    end
end)
