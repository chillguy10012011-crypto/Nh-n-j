local SliderFill = Instance.new("Frame")
SliderFill.Size = UDim2.new((4 - 1) / (20 - 1), 0, 1, 0)
SliderFill.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
SliderFill.BorderSizePixel = 0
SliderFill.Parent = SliderFrame

local SliderBtn = Instance.new("TextButton")
SliderBtn.Size = UDim2.new(0, 12, 1, 4)
SliderBtn.Position = UDim2.new(1, -6, 0, -2)
SliderBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
SliderBtn.Text = ""
SliderBtn.Parent = SliderFill

local isDraggingSlider = false

local function updateSliderFromValue(val)
    val = math.clamp(val, 1, 20)
    targetDistance = math.floor(val * 10 + 0.5) / 10
    SliderFill.Size = UDim2.new((targetDistance - 1) / 19, 0, 1, 0)
    DistBox.Text = "Khoảng cách: " .. tostring(targetDistance) .. " studs (Nhấn để chỉnh)"
end

local function updateSliderFromInput(input)
    local relativeX = input.Position.X - SliderFrame.AbsolutePosition.X
    local pct = math.clamp(relativeX / SliderFrame.AbsoluteSize.X, 0, 1)
    local val = 1 + (pct * 19)
    updateSliderFromValue(val)
end

SliderFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingSlider = true
        updateSliderFromInput(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDraggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSliderFromInput(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingSlider = false
    end
end)

DistBox.FocusLost:Connect(function()
    local num = tonumber(DistBox.Text:match("%d+%.?%d*"))
    if num then
        updateSliderFromValue(num)
    else
        DistBox.Text = "Khoảng cách: " .. tostring(targetDistance) .. " studs (Nhấn để chỉnh)"
    end
end)

-- Hàm lấy mục tiêu theo chế độ đã chọn[span_6](start_span)[span_6](end_span)[span_7](start_span)[span_7](end_span)[span_8](start_span)[span_8](end_span)
local function getTargetPlayer()
    local name = (modeOption == 1) and selectedPlayerName or InputNameBox1.Text[span_9](start_span)[span_9](end_span)[span_10](start_span)[span_10](end_span)[span_11](start_span)[span_11](end_span)
    if name ~= "" then
        return Players:FindFirstChild(name)[span_12](start_span)[span_12](end_span)[span_13](start_span)[span_13](end_span)[span_14](start_span)[span_14](end_span)
    end
    return nil[span_15](start_span)[span_15](end_span)[span_16](start_span)[span_16](end_span)[span_17](start_span)[span_17](end_span)
end

-- Logic Vòng lặp cho Slide 1[span_18](start_span)[span_18](end_span)[span_19](start_span)[span_19](end_span)[span_20](start_span)[span_20](end_span)
RunService.RenderStepped:Connect(function()
    -- Nút 1: Nhìn người gần nhất[span_21](start_span)[span_21](end_span)[span_22](start_span)[span_22](end_span)[span_23](start_span)[span_23](end_span)
    if LockAimToggle and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then[span_24](start_span)[span_24](end_span)[span_25](start_span)[span_25](end_span)[span_26](start_span)[span_26](end_span)
        local myHrp = LocalPlayer.Character.HumanoidRootPart[span_27](start_span)[span_27](end_span)[span_28](start_span)[span_28](end_span)[span_29](start_span)[span_29](end_span)
        local closestChar = nil[span_30](start_span)[span_30](end_span)[span_31](start_span)[span_31](end_span)[span_32](start_span)[span_32](end_span)
        local shortestDist = math.huge[span_33](start_span)[span_33](end_span)[span_34](start_span)[span_34](end_span)[span_35](start_span)[span_35](end_span)

        for _, p in pairs(Players:GetPlayers()) do[span_36](start_span)[span_36](end_span)[span_37](start_span)[span_37](end_span)[span_38](start_span)[span_38](end_span)
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then[span_39](start_span)[span_39](end_span)[span_40](start_span)[span_40](end_span)[span_41](start_span)[span_41](end_span)
                local dist = (p.Character.HumanoidRootPart.Position - myHrp.Position).Magnitude[span_42](start_span)[span_42](end_span)[span_43](start_span)[span_43](end_span)[span_44](start_span)[span_44](end_span)
                if dist < shortestDist then[span_45](start_span)[span_45](end_span)[span_46](start_span)[span_46](end_span)[span_47](start_span)[span_47](end_span)
                    shortestDist = dist[span_48](start_span)[span_48](end_span)[span_49](start_span)[span_49](end_span)[span_50](start_span)[span_50](end_span)
                    closestChar = p.Character.HumanoidRootPart[span_51](start_span)[span_51](end_span)[span_52](start_span)[span_52](end_span)[span_53](start_span)[span_53](end_span)
                end
            end
        end

        if closestChar then[span_54](start_span)[span_54](end_span)[span_55](start_span)[span_55](end_span)[span_56](start_span)[span_56](end_span)
            Workspace.CurrentCamera.CFrame = CFrame.new(Workspace.CurrentCamera.CFrame.Position, closestChar.Position)[span_57](start_span)[span_57](end_span)[span_58](start_span)[span_58](end_span)[span_59](start_span)[span_59](end_span)
        end
    end

    -- Nút 2: Đứng sau người chơi với khoảng cách biến targetDistance[span_60](start_span)[span_60](end_span)[span_61](start_span)[span_61](end_span)[span_62](start_span)[span_62](end_span)
    if StandBehindToggle and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then[span_63](start_span)[span_63](end_span)[span_64](start_span)[span_64](end_span)[span_65](start_span)[span_65](end_span)
        local target = getTargetPlayer()[span_66](start_span)[span_66](end_span)[span_67](start_span)[span_67](end_span)[span_68](start_span)[span_68](end_span)
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then[span_69](start_span)[span_69](end_span)[span_70](start_span)[span_70](end_span)[span_71](start_span)[span_71](end_span)
            local targetHrp = target.Character.HumanoidRootPart[span_72](start_span)[span_72](end_span)[span_73](start_span)[span_73](end_span)[span_74](start_span)[span_74](end_span)
            local myHrp = LocalPlayer.Character.HumanoidRootPart[span_75](start_span)[span_75](end_span)[span_76](start_span)[span_76](end_span)[span_77](start_span)[span_77](end_span)
            myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, targetDistance)
        end
    end
end)




