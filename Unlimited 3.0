-- SLIDE 2: Deadrais
-- ==========================================
local Slide2 = createSlide(" Deadrais ")
local PushToggle = false
local PushBtn = createStyledButton(Slide2, "Nút 1: Đẩy Model gần (OFF)", UDim2.new(0, 10, 0, 20), UDim2.new(0, 370, 0, 35))

PushBtn.MouseButton1Click:Connect(function()
    PushToggle = not PushToggle
    PushBtn.Text = "Nút 1: Đẩy Model gần (" .. (PushToggle and "ON" or "OFF") .. ")"
    PushBtn.BackgroundColor3 = PushToggle and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(50, 50, 50)
end)

RunService.Heartbeat:Connect(function()
    if PushToggle and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myHrp = LocalPlayer.Character.HumanoidRootPart
        for _, obj in pairs(Workspace:GetChildren()) do
            if obj:IsA("Model") and obj ~= LocalPlayer.Character then
                local targetPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("PrimaryPart") or obj:FindFirstChildWhichIsA("BasePart")
                if targetPart and not Players:GetPlayerFromCharacter(obj) then
                    local dist = (targetPart.Position - myHrp.Position).Magnitude
                    if dist <= 10 then
                        local dir = (targetPart.Position - myHrp.Position).Unit
                        if dir ~= dir then dir = Vector3.new(1, 0, 0) end -- Tránh lỗi NaN Vector
                        targetPart.CFrame = CFrame.new(myHrp.Position + (dir * 11))
                    end
                end
            end
        end
    end
end)

