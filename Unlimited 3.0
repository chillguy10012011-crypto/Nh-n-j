local SpawnAnchoredBtn = createStyledButton(Slide5, "Triệu hồi (Không tác động lực)", UDim2.new(0, 10, 0, 105), UDim2.new(0, 370, 0, 30))
local DeleteModelBtn = createStyledButton(Slide5, "Xóa toàn bộ Model theo tên", UDim2.new(0, 10, 0, 145), UDim2.new(0, 370, 0, 30))

local function spawnModelLogic(isAnchored)
    local name = SpawnBox.Text
    if name == "" then return end
    
    local char = LocalPlayer.Character
    local spawnPos = char and char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.CFrame * CFrame.new(0, 0, -5) or CFrame.new(0, 10, 0)

    local newModel = Instance.new("Model")
    newModel.Name = name

    local part = Instance.new("Part")
    part.Name = "MainPart"
    part.Size = Vector3.new(4, 4, 4)
    part.CFrame = spawnPos
    part.Anchored = isAnchored
    part.CanCollide = true
    part.Material = Enum.Material.SmoothPlastic
    part.Color = Color3.fromRGB(0, 170, 255)
    part.Parent = newModel

    newModel.PrimaryPart = part
    newModel.Parent = Workspace
end

SpawnUnanchoredBtn.MouseButton1Click:Connect(function()
    spawnModelLogic(false)
end)

SpawnAnchoredBtn.MouseButton1Click:Connect(function()
    spawnModelLogic(true)
end)

DeleteModelBtn.MouseButton1Click:Connect(function()
    local name = SpawnBox.Text
    if name == "" then return end
    
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name == name then
            obj:Destroy()
        end
    end
end)

-- ==========================================
-- SLIDE 6: Dynamic Collision
-- ==========================================
local Slide6 = createSlide("Dynamic Collision")

local CollisionToggle = false
local CollisionBtn = createStyledButton(Slide6, "Auto CanCollide (OFF)", UDim2.new(0, 10, 0, 20), UDim2.new(0, 370, 0, 35))

local isTouching = false

-- Lắng nghe sự kiện va chạm của nhân vật
local function setupTouchDetection(char)
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Touched:Connect(function(hit)
                if not CollisionToggle then return end
                -- Nếu vật thể chạm vào không thuộc về nhân vật của mình
                if hit and not hit:IsDescendantOf(char) then
                    isTouching = true
                end
            end)

            part.TouchEnded:Connect(function(hit)
                if not CollisionToggle then return end
                if hit and not hit:IsDescendantOf(char) then
                    isTouching = false
                end
            end)
        end
    end
end

-- Bật / Tắt chức năng
CollisionBtn.MouseButton1Click:Connect(function()
    CollisionToggle = not CollisionToggle
    CollisionBtn.Text = "Auto CanCollide (" .. (CollisionToggle and "ON" or "OFF") .. ")"
    CollisionBtn.BackgroundColor3 = CollisionToggle and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(50, 50, 50)

    -- Khi tắt, khôi phục CanCollide = true cho nhân vật
    if not CollisionToggle and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end)

-- Khởi tạo sự kiện khi nhân vật respawn
if LocalPlayer.Character then
    setupTouchDetection(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(setupTouchDetection)

-- Vòng lặp cập nhật trạng thái CanCollide liên tục
RunService.Stepped:Connect(function()
    if CollisionToggle and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                -- Nếu có ai chạm vào thì CanCollide = true, ngược lại CanCollide = false
                part.CanCollide = isTouching
            end
        end
    end
end)

-- ==========================================
-- SLIDE 7: Infinite yield
-- ==========================================
local Slide7 = createSlide("Infinite yield")

local IYBtn = createStyledButton(Slide7, "Chạy Script Infinite Yield", UDim2.new(0, 10, 0, 20), UDim2.new(0, 370, 0, 35))

IYBtn.MouseButton1Click:Connect(function()
    pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source"))()
    end)
end)
