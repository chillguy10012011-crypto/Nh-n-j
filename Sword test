-- // FE HAT ORBIT (TẬN DỤNG NÓN/PHỤ KIỆN TRÊN NGƯỜI)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local hrp = char:WaitForChild("HumanoidRootPart")
local humanoid = char:WaitForChild("Humanoid")

local hats = {}

-- Tìm tất cả phụ kiện/nón trên nhân vật
for _, acc in pairs(char:GetChildren()) do
    if acc:IsA("Accessory") and acc:FindFirstChild("Handle") then
        local handle = acc.Handle
        handle.CanCollide = false
        
        -- Xóa mối nối (Weld) gắn nón vào đầu
        for _, v in pairs(handle:GetDescendants()) do
            if v:IsA("Weld") or v:IsA("WeldConstraint") then
                v:Destroy()
            end
        end
        table.insert(hats, handle)
    end
end

if #hats == 0 then
    warn("Nhân vật của bạn cần đeo ít nhất 1 cái Nón/Phụ kiện!")
    return
end

local radius = 5
local rotateSpeed = 4
local angle = 0

RunService.Heartbeat:Connect(function(dt)
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    angle = angle + (dt * rotateSpeed)

    for i, handle in ipairs(hats) do
        if handle then
            -- Bypass NetworkOwnership
            handle.Velocity = Vector3.new(30, 0, 0)
            
            local offsetAngle = angle + ((i - 1) * (math.pi * 2 / #hats))
            local x = math.cos(offsetAngle) * radius
            local z = math.sin(offsetAngle) * radius
            
            local targetPos = hrp.Position + Vector3.new(x, 0, z)
            handle.CFrame = CFrame.new(targetPos, hrp.Position)
        end
    end
end)
