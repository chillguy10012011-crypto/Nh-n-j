-- HỆ THỐNG XỬ LÝ: BÓC TÁCH & GIẢI MÃ NHIỀU TẦNG
-----------------------------------------------------------------

local function decodePayload(text)
	-- 1. Giải mã chuỗi string.char dạng ẩn (ví dụ: string.char(104,101,108,112))
	text = text:gsub("string%.char%s*%(%s*([%d,%s]+)%s*%)", function(chars)
		local decodedStr = ""
		for num in chars:gmatch("%d+") do
			decodedStr = decodedStr .. string.char(tonumber(num))
		end
		-- Trả về dạng chuỗi Lua đã bọc ngoặc kép an toàn
		return string.format("%q", decodedStr)
	end)

	-- 2. Bóc tách các dạng loadstring nhiều tầng (Loadstring lồng nhau dạng: loadstring(game:HttpGet(...))() hoặc loadstring("...")())
	local maxIterations = 10 -- Giới hạn chống lặp vô hạn
	local iteration = 0
	
	local function unwrapLoadstring(str)
		local changed = false
		
		-- Tìm dạng loadstring(...)(hoặc các biến gọi lại)
		str = str:gsub("loadstring%s*%(%s*(['\"])(.-)%1%s*%)%s*%(%s*%)", function(_, innerCode)
			changed = true
			return innerCode
		end)
		
		str = str:gsub("loadstring%s*%(%s*%[%[(.-)%]%s*%s*%)%s*%(%s*%)", function(innerCode)
			changed = true
			return innerCode
		end)

		-- Xử lý dạng game:HttpGet bọc trong loadstring
		str = str:gsub("loadstring%s*%(%s*game\t*:%s*HttpGet%s*%(%s*(['\"])(.-)%1%s*%)%s*%)%s*%(%s*%)", function(_, url)
			changed = true
			-- Thử giả lập lấy nội dung nếu executor hỗ trợ, hoặc trả về dạng chú thích URL
			local success, webContent = pcall(function()
				return game:HttpGet(url)
			end)
			if success and webContent then
				return webContent
			end
			return "-- [Không thể kết nối mạng tải từ URL: " .. url .. "]"
		end)

		return str, changed
	end

	repeat
		iteration = iteration + 1
		local changed
		text, changed = unwrapLoadstring(text)
	until not changed or iteration >= maxIterations

	return text
end

-- Sự kiện khi nhấn nút Run
RunButton.MouseButton1Click:Connect(function()
	local rawInput = InputBox.Text
	if rawInput == "" then
		OutputBox.Text = "-- Vui lòng nhập code vào Khung 1!"
		return
	end

	local success, result = pcall(function()
		return decodePayload(rawInput)
	end)

	if success then
		OutputBox.Text = result
	else
		OutputBox.Text = "-- Lỗi khi xử lý giải mã:\n" .. tostring(result)
	end
end)
