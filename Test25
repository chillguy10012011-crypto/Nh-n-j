-- Tự động điều chỉnh kích thước TextBox theo số dòng chữ bên trong
OutputBox:GetPropertyChangedSignal("Text"):Connect(function()
    local lines = 1
    for _ in OutputBox.Text:gmatch("\n") do
        lines = lines + 1
    end
    -- Mỗi dòng ước tính khoảng 16 pixel chiều cao
    OutputBox.Size = UDim2.new(1, 0, 0, math.max(250, lines * 16 + 20))
end)

-- -------------------------------------------------------------------------
-- LOGIC BẪY NÂNG CẤP
-- -------------------------------------------------------------------------
ExecButton.MouseButton1Click:Connect(function()
    local rawCode = InputBox.Text
    if rawCode == "" then
        OutputBox.Text = "⚠️ Lỗi: Vui lòng nhập code vào khung bên trên!"
        return
    end

    OutputBox.Text = "⏳ Đang chạy và thu thập các tầng giải mã..."

    local old_loadstring = loadstring
    local capturedChunks = {}
    local loadCount = 0

    getgenv().loadstring = function(codeChunk, chunkName)
        loadCount = loadCount + 1
        local header = string.format("\n\n-- ========================================\n-- [LẦN GỌI THỨ %d] - Chunk: %s\n-- ========================================\n", loadCount, tostring(chunkName))
        local fullChunkContent = header .. tostring(codeChunk)
        
        table.insert(capturedChunks, fullChunkContent)
        OutputBox.Text = table.concat(capturedChunks, "\n")
        
        return function() end
    end

    local envProxy = setmetatable({}, {
        __index = getgenv(),
    })

    local success, err = pcall(function()
        local func, loadErr = old_loadstring(rawCode)
        if func then
            setfenv(func, envProxy)
            func()
        else
            OutputBox.Text = "❌ Lỗi cú pháp khi nạp code ban đầu:\n" + tostring(loadErr)
        end
    end)

    getgenv().loadstring = old_loadstring

    if not success and #capturedChunks == 0 then
        OutputBox.Text = "⚠️ Thực thi kết thúc với lỗi:\n" .. tostring(err)
    elseif #capturedChunks > 0 then
        OutputBox.Text = table.concat(capturedChunks, "\n") .. "\n\n-- [HOÀN TẤT] Đã bắt trọn " .. loadCount .. " lần gọi loadstring!"
    end
end)
