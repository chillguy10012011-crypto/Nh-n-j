-- Biến logic hệ thống
local isFlinging = false
local flingConn = nil
local isMinimized = false
local neonBox = nil

local function getRoot(char)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
end

-- Hàm bật/tắt hiệu ứng Neon phát sáng quanh người
local function toggleNeonVisual(char, root, state)
    if state then
        if char and root and not char:FindFirstChild("NeonFlingVisual") then
            neonBox = Instance.new("SelectionBox")
            neonBox.Name = "NeonFlingVisual"
            neonBox.Adornee = root
            neonBox.Color3 = Color3.fromRGB(0, 255, 100)
            neonBox.LineThickness = 0.05
            neonBox.SurfaceColor3 = Color3.fromRGB(0, 255, 100)
            neonBox.SurfaceTransparency = 0.8
            neonBox.Parent = char
        end
    else
        if neonBox then
            neonBox:Destroy()
            neonBox = nil
        end
        if char then
            local oldVisual = char:FindFirstChild("NeonFlingVisual")
            if oldVisual then oldVisual:Destroy() end
        end
    end
end

-- Hàm Bật/Tắt Collision (Va chạm) trên cơ thể
local function toggleCollision(char, state)
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if state then
                -- Lưu trạng thái cũ (nếu cần) và tắt va chạm
                part.CanCollide = false
            else
                -- Khôi phục lại va chạm khi tắt Fling
                part.CanCollide = true
            end
        end
    end
end

-- Chức năng nút Xóa (X)
closeBtn.MouseButton1Click:Connect(function()
    if flingConn then
        flingConn:Disconnect()
    end
    toggleCollision(plr.Character, false)
    toggleNeonVisual(plr.Character, getRoot(plr.Character), false)
    sc:Destroy()
end)

-- Chức năng nút Thu gọn (-) / Mở rộng (+)
minBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        minBtn.Text = "+"
        btn.Visible = false
        frm.Size = UDim2.new(0, 210, 0, 30)
    else
        minBtn.Text = "-"
        btn.Visible = true
        frm.Size = UDim2.new(0, 210, 0, 110)
    end
end)

-- Chức năng Bật/Tắt Fling + Neon Body + Noclip Collision
btn.MouseButton1Click:Connect(function()
    isFlinging = not isFlinging
    
    local char = plr.Character
    local root = getRoot(char)

    if isFlinging then
        if not char or not root then
            btn.Text = "No Character!"
            isFlinging = false
            return
        end
        
        btn.Text = "Status: ON (Active)"
        btnStroke.Color = Color3.fromRGB(0, 255, 100)
        
        -- Kích hoạt hiệu ứng neon & Tắt va chạm cơ thể
        toggleNeonVisual(char, root, true)
        toggleCollision(char, true)
        
        -- Vòng lặp fling
        flingConn = RunService.Heartbeat:Connect(function()
            -- Kiểm tra lại character liên tục trong trường hợp player reset
            local currentTargetChar = plr.Character
            local currentRoot = getRoot(currentTargetChar)
            
            if not currentTargetChar or not currentRoot or not isFlinging then 
                return 
            end
            
            -- Đảm bảo mỗi khi hồi sinh hoặc đổi trạng thái vẫn giữ tắt va chạm
            for _, part in ipairs(currentTargetChar:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
            
            local lastVel = currentRoot.AssemblyLinearVelocity
            currentRoot.AssemblyLinearVelocity = Vector3.new(500000, 250000, 500000)
            
            RunService.RenderStepped:Wait()
            if currentRoot and currentRoot.Parent then
                currentRoot.AssemblyLinearVelocity = lastVel
            end
        end)
    else
        btn.Text = "Status: OFF"
        btnStroke.Color = Color3.fromRGB(255, 50, 50)
        
        if flingConn then
            flingConn:Disconnect()
            flingConn = nil
        end
        
        -- Tắt hiệu ứng neon & Bật lại va chạm cơ thể bình thường
        toggleNeonVisual(plr.Character, getRoot(plr.Character), false)
        toggleCollision(plr.Character, false)
    end
end)
