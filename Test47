local function cleanup()
	pcall(stop)
	for _, c in ipairs(allConns) do
		pcall(function() c:Disconnect() end)
	end
	gui:Destroy()
end
closeBtn.Activated:Connect(cleanup)

pcall(function() getgenv().__FlingHubCleanup = cleanup end)
