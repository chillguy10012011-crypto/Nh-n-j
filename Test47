----------------------------------------------------------------------
-- LOGIC FLING
----------------------------------------------------------------------
local char, hum, hrp
local fake, runConn, diedConn, ancConn
local flip = false
local start, stop

local function getChar()
	char = LocalPlayer.Character
	if not char then return false end
	hum = char:FindFirstChildOfClass("Humanoid")
	hrp = char:FindFirstChild("HumanoidRootPart")
	return hum ~= nil and hrp ~= nil
end

-- điểm nhắm: tia từ tâm màn hình theo hướng camera
local function aimPoint()
	local cam = Workspace.CurrentCamera
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char, fake }
	local origin, look = cam.CFrame.Position, cam.CFrame.LookVector
	local res = Workspace:Raycast(origin, look * 2000, params)
	return res and res.Position or (origin + look * 150)
end

local function jitter()
	return (math.random() - 0.5) * 0.5
end

refreshUI = function()
	local info = TweenInfo.new(0.15)
	if state.active then
		mainBtn.Text = "■  DỪNG"
		TweenService:Create(mainBtn, info, { BackgroundColor3 = C.red }):Play()
		dot.BackgroundColor3 = C.green
		statusLbl.Text = string.format("Đang chạy  •  Lực x%d  •  Tốc độ x%d", state.power, state.speed)
	else
		mainBtn.Text = "▶  BẮT ĐẦU"
		TweenService:Create(mainBtn, info, { BackgroundColor3 = C.green }):Play()
		dot.BackgroundColor3 = C.red
		statusLbl.Text = "Đang tắt"
	end
end

stop = function()
	if not state.active then return end
	state.active = false
	state.strikeHeld, state.mouseHeld = false, false

	if runConn then runConn:Disconnect() runConn = nil end
	if diedConn then diedConn:Disconnect() diedConn = nil end
	if ancConn then ancConn:Disconnect() ancConn = nil end

	if hrp and hrp.Parent then
		if fake then pcall(function() hrp.CFrame = CFrame.new(fake.Position) end) end
		
		-- Reset vận tốc tuyến tính và vận tốc góc về 0
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		
		-- Khóa và giữ vận tốc ở mức 0 trong 1 giây để tránh bị văng tiếp
		task.spawn(function()
			local startTime = tick()
			while tick() - startTime < 1 do
				if hrp and hrp.Parent then
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero
				end
				task.wait()
			end
		end)
	end
	if fake then fake:Destroy() fake = nil end

	local cam = Workspace.CurrentCamera
	if cam and hum and hum.Parent then cam.CameraSubject = hum end
	if hum and hum.Parent and hum.Health > 0 then
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
	end
	refreshUI()
end

start = function()
	if state.active then return end
	if not getChar() or hum.Health <= 0 then
		statusLbl.Text = "Chưa có nhân vật"
		dot.BackgroundColor3 = C.amber
		return
	end

	state.active = true
	fake = new("Part", {
		Name = "FlingCore", Shape = Enum.PartType.Ball, Size = Vector3.new(4, 4, 4),
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		Material = Enum.Material.Neon, Transparency = 0.4, Color = C.accentA,
		CFrame = hrp.CFrame,
	}, Workspace)

	local hue = 0
	runConn = RunService.Heartbeat:Connect(function(dt)
		if not (char and char.Parent and hrp and hrp.Parent and hum and hum.Parent and hum.Health > 0) then
			stop()
			return
		end

		-- Khóa máu nhân vật liên tục ở mức 100
		hum.Health = 100

		-- 1) Quét người chơi xung quanh khối cầu trong phạm vi 15 studs
		local targetPlayerHRP = nil
		local shortestDist = 15 -- Bán kính tối đa 15 studs
		
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character then
				local targetHRP = p.Character:FindFirstChild("HumanoidRootPart")
				local targetHum = p.Character:FindFirstChildOfClass("Humanoid")
				if targetHRP and targetHum and targetHum.Health > 0 then
					local dist = (targetHRP.Position - fake.Position).Magnitude
					if dist < shortestDist then
						shortestDist = dist
						targetPlayerHRP = targetHRP
					end
				end
			end
		end

		-- 2) Xác định vị trí di chuyển của lõi
		if targetPlayerHRP then
			-- Nếu có người chơi trong phạm vi 15 studs -> Di chuyển bám theo người đó
			fake.CFrame = targetPlayerHRP.CFrame
		else
			-- Nếu không có ai -> Di chuyển mặc định theo điều khiển (WASD / Cần điều khiển + Lên/Xuống)
			local vert = (state.up and 1 or 0) - (state.down and 1 or 0)
			local mv = hum.MoveDirection + Vector3.new(0, vert, 0)
			if mv.Magnitude > 0 then
				fake.CFrame = fake.CFrame + mv * (state.speed * CFG.SpeedUnit * dt)
			end
		end

		-- 3) giữ nhân vật tại lõi, gán vận tốc lớn
		hrp.CFrame = fake.CFrame
		hrp.AssemblyLinearVelocity = CFG.LinearVel * state.power

		-- 4) hất: dịch nhân vật tới điểm nhắm, xoay ngẫu nhiên + vận tốc góc
		local target
		if state.strikeHeld then
			target = aimPoint()
		elseif state.mouseHeld and state.strikeClick then
			target = mouse.Hit.Position
		end
		if target then
			hrp.CFrame = CFrame.new(target + Vector3.new(jitter(), jitter(), jitter()))
				* CFrame.Angles(
					math.rad(math.random(-180, 180)),
					math.rad(math.random(-180, 180)),
					math.rad(math.random(-180, 180)))
			hrp.AssemblyAngularVelocity = CFG.AngularVel * state.power
		end

		-- 5) chống ngã
		flip = not flip
		hum:ChangeState(flip and Enum.HumanoidStateType.Swimming or Enum.HumanoidStateType.GettingUp)

		-- 6) camera bám lõi
		local cam = Workspace.CurrentCamera
		if cam and cam.CameraSubject ~= fake then cam.CameraSubject = fake end

		-- 7) màu cầu vồng cho lõi
		hue = (hue + dt * 0.3) % 1
		fake.Color = Color3.fromHSV(hue, 0.8, 1)
	end)

	diedConn = hum.Died:Connect(function() stop() end)
	ancConn = char.AncestryChanged:Connect(function(_, parent)
		if not parent then stop() end
	end)
	refreshUI()
end

