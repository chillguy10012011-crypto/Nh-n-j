local isFarming = false
local stepDistance = 15 -- Khoảng cách giữa các stage ước tính (có thể tăng giảm tùy map)

farmButton.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        farmButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        farmButton.Text = "⏹️ DỪNG FARM"
        
        task.spawn(function()
            while isFarming do
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local rootPart = safeCloneRef(character.HumanoidRootPart)
                    
                    -- Ép nhân vật dịch chuyển tịnh tiến về phía trước theo hướng nhìn (LookVector) hoặc trục Z
                    -- Giúp vượt qua các map bị giới hạn load bằng Bloxstrap
                    rootPart.CFrame = rootPart.CFrame + (rootPart.CFrame.LookVector * stepDistance) + Vector3.new(0, 3, 0)
                    
                    statusLabel.Text = "🚀 Đang lướt tịnh tiến vượt map bất chấp giới hạn load!"
                end
                task.wait(0.3) -- Tốc độ lướt qua các stage
            end
        end)
    else
        farmButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        farmButton.Text = "🚀 BẬT FARM TIẾN LÊN (BẤT CHẤP LOAD)"
        statusLabel.Text = "⏹️ Đã dừng Farm."
    end
end)

stepButton.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local rootPart = safeCloneRef(character.HumanoidRootPart)
        rootPart.CFrame = rootPart.CFrame + (rootPart.CFrame.LookVector * stepDistance) + Vector3.new(0, 3, 0)
        statusLabel.Text = "🎯 Đã phóng tới 1 nấc!"
    end
end)

print("✅ Đã load chế độ Blind Farm chống giới hạn Bloxstrap!")
