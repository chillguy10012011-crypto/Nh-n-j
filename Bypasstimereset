btnCorner.Parent = resetButton

-- 6. Thuật toán tự động tìm RemoteEvent/RemoteFunction liên quan đến Reset/Level
local foundRemote = nil

local function scanForRemotes()
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local nameLower = obj.Name:lower()
            -- Lọc các từ khóa thường dùng trong game obby
            if nameLower:find("reset") or nameLower:find("level") or nameLower:find("checkpoint") or nameLower:find("clear") or nameLower:find("reward") then
                foundRemote = obj
                statusLabel.Text = "🎯 Đã tìm thấy:\n" .. obj.Name .. " (" .. obj.ClassName .. ")"
                statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                return
            end
        end
    end
    statusLabel.Text = "⚠️ Không tìm thấy tự động. Hãy thử bấm nút Reset trong game 1 lần để hệ thống bắt tín hiệu!"
    statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
end

scanForRemotes()

-- Fallback: Nếu chưa thấy, lắng nghe xem có Remote nào vừa được gọi hoặc xuất hiện không
ReplicatedStorage.DescendantAdded:Connect(function(obj)
    if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) and not foundRemote then
        local nameLower = obj.Name:lower()
        if nameLower:find("reset") or nameLower:find("level") or nameLower:find("complete") then
            foundRemote = obj
            statusLabel.Text = "🎯 Đã bắt được:\n" .. obj.Name
            statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
        end
    end
end)

-- 7. Xử lý sự kiện khi bấm nút trên GUI
resetButton.MouseButton1Click:Connect(function()
    if foundRemote then
        pcall(function()
            if foundRemote:IsA("RemoteEvent") then
                foundRemote:FireServer()
            elseif foundRemote:IsA("RemoteFunction") then
                foundRemote:InvokeServer()
            end
        end)
        statusLabel.Text = "✨ Đã gửi lệnh Reset qua:\n" .. foundRemote.Name
    else
        statusLabel.Text = "❌ Chưa có Remote nào! Hãy bấm nút Reset chuẩn của game 1 lần rồi bấm lại nút này."
    end
end)

print("✅ Đã load GUI Bypass Obby thành công!")
