-- -------------------------------------------------------------------------
-- LOGIC BẪY & GOM TOÀN BỘ VÀO 1 BIẾN DUY NHẤT
-- -------------------------------------------------------------------------
ExecButton.MouseButton1Click:Connect(function()
    local rawCode = InputBox.Text
    if rawCode == "" then
        OutputBox.Text = "⚠️ Lỗi: Vui lòng nhập code!"
        return
    end

    OutputBox.Text = "⏳ Đang quét và gom toàn bộ mã nguồn..."
    fullMasterCode = ""

    local old_loadstring = loadstring
    local collectedChunks = {}
    local loadCount = 0

    local interceptedHttpGet = function(self, url)
        loadCount = loadCount + 1
        local header = string.format("\n\n-- ========================================\n-- [HTTPGET #%d]: %s\n-- ========================================\n", loadCount, tostring(url))
        
        local success, fileContent = pcall(function()
            return game:HttpGet(url)
        end)
        
        if success then
            table.insert(collectedChunks, header .. fileContent)
            return fileContent
        else
            table.insert(collectedChunks, header .. "-- [LỖI TẢI LINK]")
            return ""
        end
    end

    local function recursiveTrap(codeChunk, chunkName)
        loadCount = loadCount + 1
        local header = string.format("\n\n-- ========================================\n-- [LOADSTRING #%d] - Chunk: %s\n-- ========================================\n", loadCount, tostring(chunkName))
        table.insert(collectedChunks, header .. tostring(codeChunk))
        
        local realFunc, loadErr = old_loadstring(codeChunk, chunkName)
        if realFunc then
            local envProxy
            envProxy = setmetatable({
                loadstring = function(subChunk, subName)
                    return recursiveTrap(subChunk, subName)
                end,
                game = setmetatable({
                    HttpGet = function(s, u)
                        return interceptedHttpGet(s, u)
                    end
                }, {
                    __index = game
                })
            }, {
                __index = getgenv(),
            })
            
            setfenv(realFunc, envProxy)
            pcall(realFunc)
            return realFunc
        else
            return function() end
        end
    end

    getgenv().loadstring = function(codeChunk, chunkName)
        return recursiveTrap(codeChunk, chunkName)
    end

    local envProxyTop = setmetatable({
        game = setmetatable({
            HttpGet = function(s, u)
                return interceptedHttpGet(s, u)
            end
        }, {
            __index = game
        })
    }, {
        __index = getgenv(),
    })

    local success, err = pcall(function()
        local func, loadErr = old_loadstring(rawCode)
        if func then
            setfenv(func, envProxyTop)
            func()
        else
            OutputBox.Text = "❌ Lỗi cú pháp ban đầu:\n" .. tostring(loadErr)
        end
    end)

    getgenv().loadstring = old_loadstring

    -- Gom tất cả các khối lại thành một chuỗi siêu to khổng lồ duy nhất
    if #collectedChunks > 0 then
        fullMasterCode = table.concat(collectedChunks, "\n")
        
        -- Tự động đẩy thẳng vào Clipboard của điện thoại
        if setclipboard then
            setclipboard(fullMasterCode)
            OutputBox.Text = string.format("🎉 THÀNH CÔNG RỰC RỠ!\n\n- Đã bắt trọn %d tầng/link.\n- Tổng độ dài: %d ký tự.\n- 📋 ĐÃ TỰ ĐỘNG COPY TOÀN BỘ VÀO CLIPBOARD!\n\n👉 Bây giờ ní chỉ cần mở ứng dụng Ghi Chú (Notes) trên điện thoại và bấm Dán (Paste) là ra full toàn bộ code gốc!", loadCount, #fullMasterCode)
        else
            OutputBox.Text = "⚠️ Đã gom xong nhưng executor không hỗ trợ setclipboard(). Ní hãy bấm nút 'COPY LẠI' màu xanh dương bên trên nhé!"
        end
    else
        if success then
            OutputBox.Text = "⚠️ Chạy xong nhưng không bắt được lệnh loadstring hay HttpGet nào."
        else
            OutputBox.Text = "⚠️ Lỗi thực thi:\n" .. tostring(err)
        end
    end
end)
