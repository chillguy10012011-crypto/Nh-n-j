-- Xử lý sự kiện khi nhấn nút Execute
ExecuteBtn.MouseButton1Click:Connect(function()
	local rawText = InputBox.Text
	
	-- Đưa nội dung vừa nhập sang khung Output để bạn dễ nhìn/copy
	OutputBox.Text = rawText

	-- Kiểm tra nếu nội dung là một dạng loadstring (ví dụ: loadstring(game:HttpGet(...))())
	local success, err = pcall(function()
		if string.find(rawText, "loadstring") then
			-- Thực thi trực tiếp chuỗi loadstring
			local func, loadErr = loadstring(rawText)
			if func then
				func()
			else
				warn("Loadstring Error: " .. tostring(loadErr))
			end
		else
			-- Thực thi code thường
			local func, loadErr = loadstring(rawText)
			if func then
				func()
			else
				warn("Compile Error: " .. tostring(loadErr))
			end
		end
	end)

	if not success then
		warn("Execution Error: " .. tostring(err))
	end
end)
