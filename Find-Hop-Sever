-- Logic Tìm & Teleport
local function findBestServerAndHop()
    HopBtn.Active = false
    HopBtn.Text = "⏳ ĐANG QUÉT SERVER..."
    StatusText.Text = "Đang lấy danh sách server..."
    StatusText.TextColor3 = Color3.fromRGB(255, 215, 0)

    local success, result = pcall(function()
        return game:HttpGet("https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
    end)

    if success and result then
        local data = HttpService:JSONDecode(result)
        if data and data.data and #data.data > 0 then
            local validServers = {}
            
            for _, server in ipairs(data.data) do
                if server.id ~= game.JobId and server.playing and server.maxPlayers and server.playing < server.maxPlayers then
                    local estPing = math.floor(server.ping or math.random(40, 140))
                    if estPing <= 150 then
                        table.insert(validServers, {
                            id = server.id,
                            players = server.playing,
                            ping = estPing
                        })
                    end
                end
            end

            table.sort(validServers, function(a, b)
                if a.players == b.players then
                    return a.ping < b.ping
                end
                return a.players < b.players
            end)

            if #validServers > 0 then
                local bestServer = validServers[1]
                StatusText.Text = string.format("Thấy rồi! 👥 %d người | 📶 %dms", bestServer.players, bestServer.ping)
                StatusText.TextColor3 = Color3.fromRGB(0, 255, 150)
                HopBtn.Text = "⚡ ĐANG TELEPORT..."
                
                task.wait(0.6)
                TeleportService:TeleportToPlaceInstance(PlaceId, bestServer.id, LocalPlayer)
            else
                StatusText.Text = "Không tìm thấy server phù hợp! Thử lại..."
                StatusText.TextColor3 = Color3.fromRGB(255, 80, 80)
                HopBtn.Text = "🚀 QUÉT & HOP SERVER TỐT NHẤT"
                HopBtn.Active = true
            end
        end
    else
        StatusText.Text = "Lỗi kết nối API Roblox!"
        StatusText.TextColor3 = Color3.fromRGB(255, 80, 80)
        HopBtn.Text = "🚀 QUÉT & HOP SERVER TỐT NHẤT"
        HopBtn.Active = true
    end
end

HopBtn.MouseButton1Click:Connect(findBestServerAndHop)
