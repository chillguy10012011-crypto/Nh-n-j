-- Khởi tạo dịch vụ
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- Xóa GUI cũ nếu đã tồn tại để tránh bị lỗi trùng lặp
if CoreGui:FindFirstChild("ToolFlingGUI") then
    CoreGui.ToolFlingGUI:Destroy()
end

-- Tạo ScreenGui chính
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ToolFlingGUI"
ScreenGui.Parent = CoreGui

-- Tạo khung giao diện (có thể kéo đi chỗ khác)
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 200, 0, 70)
MainFrame.Position = UDim2.new(0.5, -100, 0.3, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = MainFrame

-- Nút Bật/Tắt Tool Fling
local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(1, -16, 1, -16)
ToggleBtn.Position = UDim2.new(0, 8, 0, 8)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
ToggleBtn.Text = "Tool Fling: TẮT"
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.Font = Enum.Font.SourceSansBold
ToggleBtn.TextSize = 16
ToggleBtn.Parent = MainFrame

local BtnCorner = Instance.new("UICorner")
BtnCorner.CornerRadius = UDim.new(0, 6)
BtnCorner.Parent = ToggleBtn

-- Biến điều khiển
local isFlinging = false
local connection = nil

ToggleBtn.MouseButton1Click:Connect(function()
    isFlinging = not isFlinging
    
    if isFlinging then
        ToggleBtn.Text = "Tool Fling: BẬT"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        
        -- Vòng lặp liên tục gia tăng vận tốc cho Tool đang cầm
        connection = RunService.Heartbeat:Connect(function()
            local character = LocalPlayer.Character
            if not character then return end
            
            -- Tìm Tool đang cầm trên tay nhân vật
            local tool = character:FindFirstChildOfClass("Tool")
            if tool and tool:FindFirstChild("Handle") then
                local handle = tool.Handle
                -- Ép vận tốc tuyến tính và vận tốc góc lên mức cực lớn để fling
                handle.AssemblyLinearVelocity = Vector3.new(999999, 999999, 999999)
                handle.AssemblyAngularVelocity = Vector3.new(0, 999999, 0)
            end
        end)
    else
        ToggleBtn.Text = "Tool Fling: TẮT"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        
        -- Ngắt kết nối vòng lặp khi tắt
        if connection then
            connection:Disconnect()
            connection = nil
        end
    end
end)
