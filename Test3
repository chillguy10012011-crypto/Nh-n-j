-- Tạo GUI trên Roblox Executor
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Xóa GUI cũ nếu đã tồn tại để tránh bị trùng lặp
if PlayerGui:FindFirstChild("WeldConstraintGUI") then
    PlayerGui.WeldConstraintGUI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "WeldConstraintGUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

-- Khung chính của GUI
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 220, 0, 110)
MainFrame.Position = UDim2.new(0.5, -110, 0.5, -55)
MainFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
MainFrame.BorderColor3 = Color3.fromRGB(0, 170, 255)
MainFrame.BorderSizePixel = 2
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

-- Tiêu đề GUI
local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundTransparency = 1
Title.Text = "WeldConstraint Tool"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 16
Title.Parent = MainFrame

-- Nút Bật/Tắt
local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(0.85, 0, 0, 45)
ToggleBtn.Position = UDim2.new(0.075, 0, 0.4, 0)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
ToggleBtn.BorderColor3 = Color3.fromRGB(0, 170, 255)
ToggleBtn.Text = "Trạng thái: TẮT"
ToggleBtn.TextColor3 = Color3.fromRGB(255, 85, 85)
ToggleBtn.Font = Enum.Font.SourceSansBold
ToggleBtn.TextSize = 15
ToggleBtn.Parent = MainFrame

local isEnabled = false
local spawnedPart = nil

ToggleBtn.MouseButton1Click:Connect(function()
    isEnabled = not isEnabled
    
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if isEnabled then
        ToggleBtn.Text = "Trạng thái: BẬT"
        ToggleBtn.TextColor3 = Color3.fromRGB(85, 255, 85)
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 150)
        
        if hrp then
            -- Tạo Part mới gắn vào nhân vật
            spawnedPart = Instance.new("Part")
            spawnedPart.Name = "WeldedPart"
            spawnedPart.Size = Vector3.new(4, 4, 4)
            spawnedPart.CFrame = hrp.CFrame
            spawnedPart.CanCollide = false -- Tránh kẹt nhân vật của bạn
            spawnedPart.Transparency = 0.5 -- Chỉnh thành 1 nếu muốn tàng hình hoàn toàn
            spawnedPart.Parent = character
            
            -- Dùng WeldConstraint để hàn Part vào HumanoidRootPart
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = hrp
            weld.Part1 = spawnedPart
            weld.Parent = spawnedPart
        end
    else
        ToggleBtn.Text = "Trạng thái: TẮT"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 85, 85)
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        
        -- Xóa Part khi tắt để tránh gây lag
        if spawnedPart then
            spawnedPart:Destroy()
            spawnedPart = nil
        end
    end
end)
