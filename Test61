bind(UIS.InputBegan, function(input, gpe)
	if UIS:GetFocusedTextBox() then return end
	if input.KeyCode == Enum.KeyCode.Space then
		state.up = true
	elseif input.KeyCode == Enum.KeyCode.LeftShift then
		state.down = true
	end
end)
bind(UIS.InputEnded, function(input)
	if input.KeyCode == Enum.KeyCode.Space then
		state.up = false
	elseif input.KeyCode == Enum.KeyCode.LeftShift then
		state.down = false
	end
end)

mainBtn.Activated:Connect(function()
	if state.active then stop() else start() end
end)

resetBtn.Activated:Connect(function()
	stop()
	local c = LocalPlayer.Character
	if c then
		local h = c:FindFirstChildOfClass("Humanoid")
		if h then h.Health = 0 end
		pcall(function() c:BreakJoints() end)
	end
end)

clearBtn.Activated:Connect(function()
	local removed = 0
	for _, name in ipairs({ "PoisonParts", "KillParts", "RagdollParts", "WaterParts", "FireParts" }) do
		local o = Workspace:FindFirstChild(name)
		if o then o:Destroy() removed = removed + 1 end
	end
	clearBtn.Text = removed > 0 and ("✓ Đã xóa " .. removed) or "Không có gì để xóa"
	task.delay(2, function()
		if clearBtn.Parent then clearBtn.Text = "🧹 Xóa bẫy map" end
	end)
end)

local minimized = false
minBtn.Activated:Connect(function()
	minimized = not minimized
	body.Visible = not minimized
	minBtn.Text = minimized and "+" or "–"
	TweenService:Create(win, TweenInfo.new(0.2), {
		Size = UDim2.new(0, WIN_W, 0, minimized and TITLE_H or (TITLE_H + BODY_H)),
	}):Play()
end)

local function cleanup()
	pcall(stop)
	for _, c in ipairs(allConns) do pcall(function() c:Disconnect() end) end
	gui:Destroy()
end
closeBtn.Activated:Connect(cleanup)

pcall(function() getgenv().__AccFlingCleanup = cleanup end)
refreshUI()
