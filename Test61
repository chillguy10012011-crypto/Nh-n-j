stop = function()
	if not state.active then return end
	state.active = false
	state.strikeHeld = false

	if runConn then runConn:Disconnect() runConn = nil end
	if diedConn then diedConn:Disconnect() diedConn = nil end
	if ancConn then ancConn:Disconnect() ancConn = nil end

	pcall(function()
		for _, handle in ipairs(getAllAccessoryHandles()) do
			if handle and handle.Parent then
				handle.AssemblyLinearVelocity = Vector3.zero
				handle.AssemblyAngularVelocity = Vector3.zero
				local orig = handle:FindFirstChild("OriginalSize")
				if orig then handle.Size = orig.Value end
			end
		end
	end)

	local cam = Workspace.CurrentCamera
	if cam and hum and hum.Parent then cam.CameraSubject = hum end

	if hrp and hrp.Parent then
		hrp.Anchored = false
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end

	if fake then fake:Destroy() fake = nil end
	refreshUI()
end

start = function()
	if state.active then return end
	if not getChar() or hum.Health <= 0 then
		statusLbl.Text = "Chưa có nhân vật"
		dot.BackgroundColor3 = C.amber
		return
	end

	local handles = getAllAccessoryHandles()
	if #handles == 0 then
		statusLbl.Text = "Không tìm thấy Phụ kiện (Accessory)"
		dot.BackgroundColor3 = C.amber
		return
	end

	state.active = true
	hrp.Anchored = true

	fake = new("Part", {
		Name = "AccFlingCore", Shape = Enum.PartType.Ball, Size = Vector3.new(3, 3, 3),
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		Material = Enum.Material.Neon, Transparency = 0.5, Color = C.accentA,
		CFrame = hrp.CFrame,
	}, Workspace)

	runConn = RunService.Heartbeat:Connect(function(dt)
		if not (char and char.Parent and hrp and hrp.Parent and hum and hum.Parent and hum.Health > 0) then
			stop()
			return
		end

		-- 1) Di chuyển khối cầu lõi bằng phím/joystick
		local vert = (state.up and 1 or 0) - (state.down and 1 or 0)
		local mv = hum.MoveDirection + Vector3.new(0, vert, 0)
		if mv.Magnitude > 0 then
			fake.CFrame = fake.CFrame + mv * (state.speed * CFG.SpeedUnit * dt)
		end

		-- 2) Tìm mục tiêu trong bán kính 20 studs quanh khối cầu
		local targetPart = nil
		if fake then
			targetPart = getNearestTargetPart(fake.Position, 20, state.targetMode)
		end

		-- Luân phiên vị trí trước/sau 0.5 studs để tránh nghẽn lệnh mạng
		frameCounter = frameCounter + 1
		if frameCounter >= 10 then
			frameCounter = 0
			toggleSide = not toggleSide
		end

		if targetPart then
			local offsetDist = toggleSide and 0.5 or -0.5
			local offsetCF = targetPart.CFrame * CFrame.new(0, 0, offsetDist)

			for _, handle in ipairs(handles) do
				if handle and handle.Parent then
					handle.CanCollide = true
					handle.CFrame = offsetCF * CFrame.Angles(
						math.rad(math.random(-180, 180)),
						math.rad(math.random(-180, 180)),
						math.rad(math.random(-180, 180)))
					
					handle.AssemblyLinearVelocity = CFG.LinearVel
					handle.AssemblyAngularVelocity = CFG.AngularVel
				end
			end
		else
			-- KHÔNG CÓ AI TRONG 20 STUDS: Các phụ kiện bám theo khối cầu ảo
			for _, handle in ipairs(handles) do
				if handle and handle.Parent then
					handle.CanCollide = true
					handle.CFrame = fake.CFrame
					handle.AssemblyLinearVelocity = Vector3.zero
					handle.AssemblyAngularVelocity = Vector3.zero
				end
			end
		end

		-- 3) Chuyển camera bám theo khối cầu điều khiển
		local cam = Workspace.CurrentCamera
		if cam and cam.CameraSubject ~= fake then cam.CameraSubject = fake end
	end)

	diedConn = hum.Died:Connect(function() stop() end)
	ancConn = char.AncestryChanged:Connect(function(_, parent)
		if not parent then stop() end
	end)
	refreshUI()
end

