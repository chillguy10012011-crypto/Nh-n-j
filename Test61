----------------------------------------------------------------------
-- LOGIC ĐA PHỤ KIỆN (MULTI-ACCESSORY) + MEGA SIZE + FLING
----------------------------------------------------------------------
local char, hum, hrp
local fake, runConn, diedConn, ancConn
local start, stop
local toggleSide = false
local frameCounter = 0

local function getChar()
	char = LocalPlayer.Character
	if not char then return false end
	hum = char:FindFirstChildOfClass("Humanoid")
	hrp = char:FindFirstChild("HumanoidRootPart")
	return hum ~= nil and hrp ~= nil
end

-- Lấy danh sách TOÀN BỘ Handle phụ kiện (mũ, tóc, kính,...), phá weld, bật va chạm và tăng kích thước
local function getAllAccessoryHandles()
	local handles = {}
	if not char then return handles end
	for _, child in ipairs(char:GetChildren()) do
		if child:IsA("Accessory") then
			local handle = child:FindFirstChild("Handle")
			if handle and handle:IsA("BasePart") then
				for _, joint in ipairs(handle:GetChildren()) do
					if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") then
						joint:Destroy()
					end
				end
				for _, joint in ipairs(char:GetDescendants()) do
					if (joint:IsA("JointInstance") or joint:IsA("WeldConstraint")) and (joint.Part0 == handle or joint.Part1 == handle) then
						joint:Destroy()
					end
				end
				handle.CanCollide = true
				-- Tăng kích thước phụ kiện để mở rộng vùng va chạm fling
				if not handle:FindFirstChild("OriginalSize") then
					local origSize = Instance.new("Vector3Value")
					origSize.Name = "OriginalSize"
					origSize.Value = handle.Size
					origSize.Parent = handle
					handle.Size = handle.Size * CFG.SizeMultiplier
				end
				table.insert(handles, handle)
			end
		end
	end
	return handles
end

local function getNearestTargetPart(center, maxDist, mode)
	local nearestPart = nil
	local minDist = maxDist
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local pHum = p.Character:FindFirstChildOfClass("Humanoid")
			local pHrp = p.Character:FindFirstChild("HumanoidRootPart")
			if pHum and pHrp and pHum.Health > 0 then
				local targetPart = pHrp
				if mode == 1 then
					targetPart = p.Character:FindFirstChild("Head") or pHrp
				elseif mode == 2 then
					targetPart = pHrp
				elseif mode == 3 then
					targetPart = p.Character:FindFirstChild("LeftFoot") or p.Character:FindFirstChild("RightFoot") or p.Character:FindFirstChild("LowerTorso") or pHrp
				end
				
				local dist = (targetPart.Position - center).Magnitude
				if dist < minDist then
					minDist = dist
					nearestPart = targetPart
				end
			end
		end
	end
	return nearestPart
end

