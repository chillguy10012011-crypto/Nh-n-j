-- -------------------------------------------------------------------------
-- LOGIC BẪY "LOADSTRING" ĐỂ BẮT KHOẢNH KHẮC GIẢI MÃ
-- -------------------------------------------------------------------------
ExecButton.MouseButton1Click:Connect(function()
    local rawCode = InputBox.Text
    if rawCode == "" then
        OutputBox.Text = "⚠️ Lỗi: Vui lòng nhập hoặc dán code mã hóa vào khung bên trên trước!"
        return
    end

    OutputBox.Text = "⏳ Đang chạy và kích hoạt bẫy..."

    -- Lưu lại hàm loadstring gốc của môi trường
    local old_loadstring = loadstring
    local capturedCode = "Không bắt được nội dung loadstring nào!"

    -- Tạo môi trường cô lập để đánh lừa script độc hại (chặn không cho nó quậy game chính)
    local envProxy = setmetatable({}, {
        __index = getgenv(),
    })

    -- Bẫy hàm loadstring
    getgenv().loadstring = function(codeChunk, chunkName)
        -- ✨ ĐÂY CHÍNH LÀ KHOẢNH KHẮC VÀNG: Code đã giải mã hiện nguyên hình!
        capturedCode = "-- [Đã bắt thành công tại Chunk: " .. tostring(chunkName) .. "]\n\n" .. tostring(codeChunk)
        OutputBox.Text = capturedCode
        
        -- Trả về một hàm trống thay vì thực thi thật để đảm bảo an toàn tuyệt đối cho bạn
        return function()
            print("[Deobfuscator] Đã chặn thực thi đoạn code độc hại sau khi bắt được.")
        end
    end

    -- Thực thi đoạn code của hacker trong môi trường bẫy
    local success, err = pcall(function()
        local func, loadErr = old_loadstring(rawCode)
        if func then
            setfenv(func, envProxy) -- Gắn môi trường ảo
            func() -- Kích hoạt để nó tự chạy hàm giải mã bên trong
        else
            OutputBox.Text = "❌ Lỗi cú pháp khi nạp code ban đầu:\n" .. tostring(loadErr)
        end
    end)

    -- Khôi phục lại hàm loadstring gốc ngay sau khi chạy xong để không ảnh hưởng game
    getgenv().loadstring = old_loadstring

    if not success then
        -- Dù có lỗi hay không, nếu qua hàm loadstring bẫy ở trên thì code vẫn được bắt lại
        if OutputBox.Text == "⏳ Đang chạy và kích hoạt bẫy..." then
            OutputBox.Text = "⚠️ Thực thi kết thúc với lỗi (nhưng có thể code đã được in hoặc không gọi loadstring):\n" .. tostring(err)
        end
    end
end)
