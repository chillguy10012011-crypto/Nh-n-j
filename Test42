toggleMenuBtn.Size = UDim2.new(0, 45, 0, 45)
toggleMenuBtn.Position = UDim2.new(0, 20, 0, 100)
toggleMenuBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
toggleMenuBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleMenuBtn.Text = "GUI"
toggleMenuBtn.TextSize = 13
toggleMenuBtn.Font = Enum.Font.GothamBold
toggleMenuBtn.Parent = screenGui

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(1, 0)
btnCorner.Parent = toggleMenuBtn

-- Khung GUI chính (Có thể di chuyển & bo tròn góc)
local mainFrame = Instance.new("Frame")
