-- -------------------------------------------------------------------------
-- LOGIC BẪY ĐỆ QUY ĐA TẦNG
-- -------------------------------------------------------------------------
ExecButton.MouseButton1Click:Connect(function()
    local rawCode = InputBox.Text
    if rawCode == "" then
        OutputBox.Text = "⚠️ Lỗi: Vui lòng nhập code vào khung bên trên!"
        return
    end

    OutputBox.Text = "⏳ Đang bóc tách các lớp bảo vệ đa tầng..."

    local old_loadstring = loadstring
    local capturedChunks = {}
    local loadCount = 0

    -- Khai báo hàm bẫy có khả năng đệ quy
    local function recursiveTrap(codeChunk, chunkName)
        loadCount = loadCount + 1
        local currentLayer = loadCount
        
        local header = string.format("\n\n-- ========================================\n-- [TẦNG GIẢI MÃ THỨ %d] - Chunk: %s\n-- ========================================\n", currentLayer, tostring(chunkName))
        local fullChunkContent = header .. tostring(codeChunk)
        
        table.insert(capturedChunks, fullChunkContent)
        OutputBox.Text = table.concat(capturedChunks, "\n")
        
        -- ⭐ ĐIỂM KHÁC BIỆT QUAN TRỌNG: 
        -- Thay vì chặn đứng, ta vẫn cho phép đoạn code này được biên dịch và chạy tiếp 
        -- để nó tự động lòi ra các tầng tiếp theo (nếu có).
        local realFunc, loadErr = old_loadstring(codeChunk, chunkName)
        if realFunc then
            -- Tạm thời ghi đè loadstring bên trong môi trường con để bắt tiếp các tầng sâu hơn
            local envProxy
            envProxy = setmetatable({
                loadstring = function(subChunk, subName)
                    return recursiveTrap(subChunk, subName)
                end
            }, {
                __index = getgenv(),
            })
            
            setfenv(realFunc, envProxy)
            
            -- Chạy ngầm hàm của tầng này để nó tiếp tục gọi loadstring tầng kế tiếp
            pcall(realFunc)
            
            return realFunc
        else
            return function()
                print("[Deobfuscator] Không thể biên dịch chunk ở tầng " .. currentLayer .. ": " .. tostring(loadErr))
            end
        end
    end

    -- Gắn bẫy toàn cục cấp cao nhất
    getgenv().loadstring = function(codeChunk, chunkName)
        return recursiveTrap(codeChunk, chunkName)
    end

    local envProxyTop = setmetatable({}, {
        __index = getgenv(),
    })

    local success, err = pcall(function()
        local func, loadErr = old_loadstring(rawCode)
        if func then
            setfenv(func, envProxyTop)
            func()
        else
            OutputBox.Text = "❌ Lỗi cú pháp khi nạp code ban đầu:\n" .. tostring(loadErr)
        end
    end)

    -- Khôi phục lại hàm loadstring gốc
    getgenv().loadstring = old_loadstring

    if not success and #capturedChunks == 0 then
        OutputBox.Text = "⚠️ Thực thi kết thúc với lỗi:\n" .. tostring(err)
    elseif #capturedChunks > 0 then
        OutputBox.Text = table.concat(capturedChunks, "\n") .. "\n\n-- [HOÀN TẤT] Đã bóc sạch " .. loadCount .. " tầng mã hóa!"
    end
end)
