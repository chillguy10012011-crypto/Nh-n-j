-- Biến logic xử lý
local isEnabled = false
local mainPart = nil
local renderConnection = nil
local moveSpeed = 60

featureBtn.MouseButton1Click:Connect(function()
    isEnabled = not isEnabled
    character = player.Character or player.CharacterAdded:Wait()
    humanoid = character:FindFirstChildOfClass("Humanoid")
    rootPart = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not rootPart then return end

    if isEnabled then
        featureBtn.Text = "Tắt Tính Năng"
        featureBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)

        -- Tạo Main Part hình vuông, mờ, có hiệu ứng lửa
        mainPart = Instance.new("Part")
        mainPart.Name = "MainFlightPart"
        mainPart.Size = Vector3.new(3, 3, 3)
        mainPart.Shape = Enum.PartType.Block
        mainPart.Transparency = 0.5
        mainPart.BrickColor = BrickColor.new("Bright red")
        mainPart.Material = Enum.Material.Neon
        mainPart.CanCollide = false
        mainPart.Anchored = true
        mainPart.CFrame = rootPart.CFrame + Vector3.new(0, 5, 0)
        mainPart.Parent = workspace

        local fire = Instance.new("Fire")
        fire.Size = 8
        fire.Heat = 10
        fire.Parent = mainPart

        -- Đổi camera sang mainPart
        workspace.CurrentCamera.CameraSubject = mainPart

        -- Vòng lặp cập nhật liên tục mỗi frame
        renderConnection = RunService.RenderStepped:Connect(function(dt)
            if not mainPart or not character or not humanoid then return end

            -- Tăng tốc độ nhân vật
            humanoid.WalkSpeed = 500
            
            -- Lấy hướng di chuyển chung cho cả Joystick (Mobile) và W,A,S,D (PC)
            local moveDir = humanoid.MoveDirection
            if moveDir.Magnitude > 0 then
                mainPart.CFrame = mainPart.CFrame + (moveDir * moveSpeed * dt)
            end

            -- Ép nhân vật và tốc độ quay góc bám theo main part
            rootPart.CFrame = mainPart.CFrame
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.new(500, 500, 500)
        end)

    else
        featureBtn.Text = "Bật Tính Năng"
        featureBtn.BackgroundColor3 = Color3.fromRGB(0, 162, 255)

        -- Ngắt vòng lặp
        if renderConnection then
            renderConnection:Disconnect()
            renderConnection = nil
        end

        -- Khóa vận tốc tối đa về 0 trong 2 giây để tránh lỗi văng/kẹt
        if humanoid then
            humanoid.WalkSpeed = 0
        end

        -- Xóa part và trả camera về đầu nhân vật (mặc định)
        if mainPart then
            mainPart:Destroy()
            mainPart = nil
        end
        workspace.CurrentCamera.CameraSubject = humanoid

        -- Sau 2 giây mở lại tốc độ chuẩn cho nhân vật
        task.delay(2, function()
            if humanoid and humanoid.Parent then
                humanoid.WalkSpeed = 16
            end
        end)
    end
end)
