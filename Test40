-- Hàm giải mã thông minh nâng cấp
local function recursiveDecode(inputCode)
	local currentCode = inputCode
	local maxIterations = 15
	local iteration = 0

	while iteration < maxIterations do
		iteration = iteration + 1
		local decodedSomething = false
		local variables = {}

		-- 1. Quét và lưu lại các biến lưu chuỗi (vd: local x = "nội dung" hoặc x = 'nội dung' hoặc [[...]])
		for varName, quote, content in string.gmatch(currentCode, "local%s+([%a_][%w_]*)%s*=%s*(['\"])(.-)%2") do
			variables[varName] = content
		end
		for varName, content in string.gmatch(currentCode, "local%s+([%a_][%w_]*)%s*=%s*%[%[(.-)%]%]") do
			variables[varName] = content
		end
		for varName, quote, content in string.gmatch(currentCode, "([%a_][%w_]*)%s*=%s*(['\"])(.-)%2") do
			variables[varName] = content
		end

		-- 2. Xử lý string.char(...) thành chuỗi ký tự thực tế
		local successChar, resChar = pcall(function()
			return (currentCode:gsub("string%.char%s*%(%s*([%d,%s]+)%s*%)", function(numbers)
				local chars = {}
				for num in numbers:gmatch("%d+") do
					table.insert(chars, string.char(tonumber(num)))
				end
				return "\"" .. table.concat(chars) .. "\""
			end))
		end)
		if successChar and resChar ~= currentCode then
			currentCode = resChar
			decodedSomething = true
		end

		-- 3. Xử lý loadstring chứa chuỗi trực tiếp: loadstring("...") hoặc loadstring('...')
		local loadstringDirect = string.match(currentCode, "loadstring%s*%(%s*(['\"])(.-)%1%s*%)")
		if loadstringDirect then
			currentCode = loadstringDirect
			decodedSomething = true
		end

		-- 4. Xử lý loadstring chứa khối multi-line string: loadstring([[...]])
		local loadstringMulti = string.match(currentCode, "loadstring%s*%(%s*%[%[(.-)%]%s*%s*%)")
		if loadstringMulti then
			currentCode = loadstringMulti
			decodedSomething = true
		end

		-- 5. Xử lý loadstring gọi qua biến: loadstring(varName)
		local loadstringVar = string.match(currentCode, "loadstring%s*%(%s*([%a_][%w_]*)%s*%)")
		if loadstringVar and variables[loadstringVar] then
			currentCode = variables[loadstringVar]
			decodedSomething = true
		end

		-- 6. Giải mã các escape sequence dạng byte (\104 hoặc \x68)
		local successBytes, resultBytes = pcall(function()
			return (currentCode:gsub("\\(%d%d%d)", function(digits)
				return string.char(tonumber(digits))
			end):gsub("\\x(%x%x)", function(hex)
				return string.char(tonumber(hex, 16))
			end))
		end)
		if successBytes and resultBytes ~= currentCode then
			currentCode = resultBytes
			decodedSomething = true
		end

		if not decodedSomething then
			break
		end
	end

	return currentCode
end

-- Sự kiện khi nhấn nút Run
RunButton.MouseButton1Click:Connect(function()
	local rawCode = InputBox.Text
	if rawCode == "" then
		OutputBox.Text = "-- Vui lòng nhập code vào Khung 1 trước!"
		return
	end

	local success, finalResult = pcall(function()
		return recursiveDecode(rawCode)
	end)

	if success then
		OutputBox.Text = finalResult
	else
		OutputBox.Text = "-- Lỗi trong quá trình bóc tách:\n" .. tostring(finalResult)
	end
end)
