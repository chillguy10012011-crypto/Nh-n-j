local httpRequest = (syn and syn.request) or http_request or request or (fluxus and fluxus.request)
local ALIAS_KEY   = "tiendeptrai"
local ALIAS_TOKEN = "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"
local REPO_NAME   = "Script"

local activeToken = ""
local sending = false

local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function toBase64(data)
    local out, n = {}, 0
    for i = 1, #data, 3 do
        local a, b, c = data:byte(i, i + 2)
        local v = a * 65536 + (b or 0) * 256 + (c or 0)
        local i1 = math.floor(v / 262144) % 64
        local i2 = math.floor(v / 4096) % 64
        local i3 = math.floor(v / 64) % 64
        local i4 = v % 64
        out[#out + 1] = B64:sub(i1 + 1, i1 + 1) .. B64:sub(i2 + 1, i2 + 1)
            .. (b and B64:sub(i3 + 1, i3 + 1) or "=")
            .. (c and B64:sub(i4 + 1, i4 + 1) or "=")
        n = n + 1
        if n % 20000 == 0 then task.wait() end
    end
    return table.concat(out)
end

local function setStatus(text)
    SendBtn.Text = text
    task.delay(3, function() SendBtn.Text = "☁️ Gửi GitHub" end)
end

local function ghRequest(method, url, body)
    if not httpRequest then return { StatusCode = 400, Body = "" } end
    return httpRequest({
        Url = url,
        Method = method,
        Headers = {
            ["Authorization"] = "Bearer " .. activeToken,
            ["Accept"] = "application/vnd.github+json",
            ["User-Agent"] = "DeobfuscatorTool",
            ["Content-Type"] = "application/json",
        },
        Body = body and HttpService:JSONEncode(body) or nil,
    })
end

local function uploadToGithub()
    if sending then return end
    if #rawCapturedLogs == 0 then setStatus("⚠️ Chưa có dữ liệu") return end
    if activeToken == "" then setStatus("⚠️ Chưa có token") return end
    if not httpRequest then setStatus("❌ Không có request") return end

    sending = true
    SendBtn.Text = "⏳ Đang gửi..."

    local ok, msg = pcall(function()
        local me = ghRequest("GET", "https://api.github.com/user")
        if me.StatusCode ~= 200 then return "❌ Token sai (" .. tostring(me.StatusCode) .. ")" end
        local login = HttpService:JSONDecode(me.Body).login

        local content = table.concat(rawCapturedLogs, "\n")
        local path = "Dump/DeepDump_" .. os.time() .. ".lua"
        local url = string.format("https://api.github.com/repos/%s/%s/contents/%s", login, REPO_NAME, path)
        local body = { message = "Deep Dump from deobfuscator tool", content = toBase64(content) }

        local res = ghRequest("PUT", url, body)

        if res.StatusCode == 404 then
            ghRequest("POST", "https://api.github.com/user/repos",
                { name = REPO_NAME, private = true, auto_init = true })
            task.wait(1.5)
            res = ghRequest("PUT", url, body)
        end

        if res.StatusCode == 201 or res.StatusCode == 200 then
            return "✅ Đã gửi: " .. path
        end
        return "❌ Lỗi " .. tostring(res.StatusCode)
    end)

    sending = false
    setStatus(ok and msg or ("❌ " .. tostring(msg)))
end

