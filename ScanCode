-- LOGIC BÓC TÁC ĐA TẦNG & URL SANITIZER
-- =========================================================================
ExecButton.MouseButton1Click:Connect(function()
    local rawCode = InputBox.Text
    if rawCode == "" then
        OutputBox.Text = "⚠️ Lỗi: Vui lòng nhập code!"
        return
    end

    OutputBox.Text = "⏳ Đang tiến hành siêu bóc tách đa tầng..."
    rawCapturedLogs = {}
    pages = {}
    currentPage = 1

    local old_loadstring = loadstring
    local loadCount = 0

    local function sanitizeUrl(url)
        local strUrl = tostring(url)
        strUrl = strUrl:gsub(" ", "%%20")
        return strUrl
    end

    local function interceptedHttpGet(self, url)
        loadCount = loadCount + 1
        local cleanUrl = sanitizeUrl(url)
        local header = string.format("\n\n-- [DEEP HTTPGET #%d]: %s\n", loadCount, cleanUrl)
        
        local success, fileContent = pcall(function()
            return game:HttpGet(cleanUrl)
        end)
        
        if success then
            table.insert(rawCapturedLogs, header .. fileContent)
            updateDisplay()
            if type(fileContent) == "string" and fileContent:find("loadstring") then
                pcall(function()
                    local subFunc = old_loadstring(fileContent)
                    if subFunc then
                        setfenv(subFunc, setmetatable({
                            loadstring = function(c, n) return old_loadstring(c, n) end,
                            game = setmetatable({
                                HttpGet = function(s, u) return interceptedHttpGet(s, u) end
                            }, { __index = game })
                        }, { __index = getgenv() }))
                        subFunc()
                    end
                end)
            end
            return fileContent
        else
            table.insert(rawCapturedLogs, header .. "-- [LỖI TẢI LINK HOẶC BỊ CHẶN]")
            updateDisplay()
            return ""
        end
    end

    local function recursiveTrap(codeChunk, chunkName)
        loadCount = loadCount + 1
        local header = string.format("\n\n-- [DEEP LOADSTRING #%d] - Chunk: %s\n", loadCount, tostring(chunkName))
        table.insert(rawCapturedLogs, header .. tostring(codeChunk))
        updateDisplay()
        
        local realFunc, loadErr = old_loadstring(codeChunk, chunkName)
        if realFunc then
            local envProxy
            envProxy = setmetatable({
                loadstring = function(subChunk, subName)
                    return recursiveTrap(subChunk, subName)
                end,
                game = setmetatable({
                    HttpGet = function(s, u)
                        return interceptedHttpGet(s, u)
                    end
                }, {
                    __index = game
                })
            }, {
                __index = getgenv(),
            })
            
            setfenv(realFunc, envProxy)
            pcall(realFunc)
            return realFunc
        else
            table.insert(rawCapturedLogs, "-- [LỖI BIÊN DỊCH LOADSTRING]: " .. tostring(loadErr))
            updateDisplay()
            return function() end
        end
    end

    getgenv().loadstring = function(codeChunk, chunkName)
        return recursiveTrap(codeChunk, chunkName)
    end

    local envProxyTop = setmetatable({
        game = setmetatable({
            HttpGet = function(s, u)
                return interceptedHttpGet(s, u)
            end
        }, {
            __index = game
        })
    }, {
        __index = getgenv(),
    })

    local success, err = pcall(function()
        local func, loadErr = old_loadstring(rawCode)
        if func then
            setfenv(func, envProxyTop)
            func()
        else
            OutputBox.Text = "❌ Lỗi cú pháp ban đầu:\n" .. tostring(loadErr)
        end
    end)

    getgenv().loadstring = old_loadstring

    if not success and #rawCapturedLogs == 0 then
        OutputBox.Text = "⚠️ Lỗi thực thi toàn cục:\n" .. tostring(err)
    elseif #rawCapturedLogs > 0 then
        updateDisplay()
    end
end)
