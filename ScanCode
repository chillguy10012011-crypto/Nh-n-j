local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function toBase64(data)
    local out, n = {}, 0
    for i = 1, #data, 3 do
        local a, b, c = data:byte(i, i + 2)
        local v = a * 65536 + (b or 0) * 256 + (c or 0)
        local i1 = math.floor(v / 262144) % 64
        local i2 = math.floor(v / 4096) % 64
        local i3 = math.floor(v / 64) % 64
        local i4 = v % 64
        out[#out + 1] = B64:sub(i1 + 1, i1 + 1) .. B64:sub(i2 + 1, i2 + 1)
            .. (b and B64:sub(i3 + 1, i3 + 1) or "=")
            .. (c and B64:sub(i4 + 1, i4 + 1) or "=")
        n = n + 1
        if n % 20000 == 0 then task.wait() end
    end
    return table.concat(out)
end

