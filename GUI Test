local function createColorPicker(title, pos, applyCallback)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0, 370, 0, 20)
    lbl.Position = pos
    lbl.BackgroundTransparency = 1
    lbl.Text = title
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.SourceSansBold
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = SettingSlide

    table.insert(registeredTexts, lbl)

    local container = Instance.new("Frame")
    container.Size = UDim2.new(0, 370, 0, 25)
    container.Position = pos + UDim2.new(0, 0, 0, 22)
    container.BackgroundTransparency = 1
    container.Parent = SettingSlide

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.Padding = UDim.new(0, 5)
    layout.Parent = container

    for _, col in ipairs(paletteColors) do
        local cBtn = Instance.new("TextButton")
        cBtn.Size = UDim2.new(0, 35, 0, 22)
        cBtn.BackgroundColor3 = col
        cBtn.BorderColor3 = Color3.fromRGB(200, 200, 200)
        cBtn.BorderSizePixel = 1
        cBtn.Text = ""
        cBtn.Parent = container

        cBtn.MouseButton1Click:Connect(function()
            applyCallback(col)
        end)
    end
end

