-- Hàm tạo nút bấm chung
templateButton = function(name, posY)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 40)
    btn.Position = UDim2.new(0, 10, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.Text = name
    btn.Parent = MainFrame
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    return btn
end

-- ==========================================
-- NÚT 1: Lồng giam bằng Phụ kiện (Hats)
-- ==========================================
local BtnHatCage = templateButton("1. Tạo lồng bằng Nón/Phụ kiện", 50)
BtnHatCage.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local hats = {}
    for _, acc in pairs(char:GetChildren()) do
        if acc:IsA("Accessory") and acc:FindFirstChild("Handle") then
            local handle = acc.Handle
            handle.CanCollide = true -- Bật va chạm để làm lồng
            for _, v in pairs(handle:GetDescendants()) do
                if v:IsA("Weld") or v:IsA("WeldConstraint") then v:Destroy() end
            end
            table.insert(hats, handle)
        end
    end
    
    if #hats == 0 then
        BtnHatCage.Text = "Cần đeo ít nhất 1 Nón!"
        task.wait(1)
        BtnHatCage.Text = "1. Tạo lồng bằng Nón/Phụ kiện"
        return
    end
    
    -- Xếp các nón thành hình trụ quanh nhân vật
    local count = #hats
    for i, handle in ipairs(hats) do
        local angle = (i / count) * (math.pi * 2)
        local offsetX = math.cos(angle) * 4
        local offsetZ = math.sin(angle) * 4
        handle.CFrame = hrp.CFrame + Vector3.new(offsetX, 0, offsetZ)
        -- Cố định vị trí tạm thời
        local bodyPos = Instance.new("BodyPosition")
        bodyPos.Position = handle.Position
        bodyPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyPos.Parent = handle
    end
    BtnHatCage.Text = "Đã thả lồng (Hats)!"
end)

-- ==========================================
-- NÚT 2: Lồng giam bằng Tool trong Balo
-- ==========================================
local BtnToolCage = templateButton("2. Tạo lồng bằng Tool (Balo)", 100)
BtnToolCage.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not char or not backpack then return end
    
    local tools = {}
    for _, tool in pairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            tool.Parent = char -- Đưa lên tay
            if tool:FindFirstChild("Handle") then
                tool.Handle.CanCollide = true
                table.insert(tools, tool.Handle)
            end
        end
    end
    
    if #tools == 0 then
        BtnToolCage.Text = "Không có Tool trong Balo!"
        task.wait(1)
        BtnToolCage.Text = "2. Tạo lồng bằng Tool (Balo)"
        return
    end
    
    local hrp = char.HumanoidRootPart
    local count = #tools
    for i, handle in ipairs(tools) do
        local angle = (i / count) * (math.pi * 2)
        local offsetX = math.cos(angle) * 4
        local offsetZ = math.sin(angle) * 4
        handle.CFrame = hrp.CFrame + Vector3.new(offsetX, 0, offsetZ)
    end
    BtnToolCage.Text = "Đã thả lồng (Tools)!"
end)

-- ==========================================
-- NÚT 3: Lồng giam bằng Part hàn vào Character
-- ==========================================
local BtnWeldCage = templateButton("3. Tạo lồng bằng WeldConstraint", 150)
BtnWeldCage.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    -- Tạo vòng vây các Part hàn chặt vào nhân vật
    for i = 1, 6 do
        local part = Instance.new("Part")
        part.Size = Vector3.new(2, 6, 2)
        part.Transparency = 0.5 -- Để dễ quan sát (có thể đổi thành 1 để tàng hình)
        part.CanCollide = true
        part.Massless = true
        
        local angle = (i / 6) * (math.pi * 2)
        local offsetX = math.cos(angle) * 4
        local offsetZ = math.sin(angle) * 4
        part.CFrame = hrp.CFrame + Vector3.new(offsetX, 0, offsetZ)
        
        -- Dùng WeldConstraint để Server công nhận
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = hrp
        weld.Part1 = part
        weld.Parent = part
        
        part.Parent = char
    end
    BtnWeldCage.Text = "Đã tạo lồng (Welded Parts)!"
end)
