-- Xử lý chức năng khi nhấn nút Execute
ExecuteBtn.MouseButton1Click:Connect(function()
    local rawCode = InputBox.Text
    if rawCode == "" then 
        OutputBox.Text = "-- Lỗi: Chưa nhập code vào khung!"
        return 
    end

    -- Giả lập quá trình "bắt" và xử lý giải mã code
    -- Bạn có thể thay thế logic giải mã (như loadstring hook, base64 decode, v.v.) vào đây tùy theo định dạng mã hóa của bạn.
    local decodedCode = "-- Code đã được bắt và giải mã thành công:\n"
    
    -- Kiểm tra nếu người dùng nhập dạng loadstring HttpGet
    if string.find(rawCode, "HttpGet") then
        decodedCode = decodedCode .. "-- Phát hiện Loadstring mạng. Nội dung:\n" .. rawCode
    else
        -- Xử lý giải mã cơ bản hoặc chạy trực tiếp
        decodedCode = decodedCode .. rawCode
    end

    OutputBox.Text = decodedCode
    
    -- Thực thi đoạn code sau khi đã xử lý xong
    local success, err = pcall(function()
        local func = loadstring(rawCode)
        if func then
            func()
        else
            -- Nếu không phải dạng loadstring trực tiếp, thử chạy chuỗi đã giải mã
            local funcDecoded = loadstring(decodedCode)
            if funcDecoded then funcDecoded() end
        end
    end)

    if not success then
        OutputBox.Text = OutputBox.Text .. "\n\n-- Lỗi thực thi: " .. tostring(err)
    end
end)

