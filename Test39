-- Hàm xử lý bóc tách và giải mã (Xử lý đa tầng loadstring & giải mã chuỗi)
local function recursiveDecode(inputCode)
	local currentCode = inputCode
	local maxIterations = 10
	local iteration = 0

	-- Vòng lặp bóc tách nhiều tầng loadstring
	while iteration < maxIterations do
		iteration = iteration + 1
		local decodedSomething = false

		-- 1. Xử lý các dạng loadstring(game:HttpGet(...)) hoặc loadstring(string.dump(...)) hoặc các biến chứa mã hóa cơ bản
		-- Bóc tách các dạng loadstring chứa chuỗi bên trong
		local loadstringPattern = "loadstring%s*%(%s*(['\"])(.-)%1%s*%)"
		local matchFound = string.match(currentCode, loadstringPattern)
		if matchFound then
			-- Nếu tìm thấy chuỗi thuần bên trong loadstring
			currentCode = matchFound
			decodedSomething = true
		end

		-- 2. Giải mã các chuỗi dạng thập phân/hex byte (ví dụ: \104\101\108\108\111 hoặc \x68\x65...)
		-- Chuyển đổi các escape sequence dạng số thành ký tự thực
		local successBytes, resultBytes = pcall(function()
			return (currentCode:gsub("\\(%d%d%d)", function(digits)
				return string.char(tonumber(digits))
			end):gsub("\\x(%x%x)", function(hex)
				return string.char(tonumber(hex, 16))
			end))
		end)
		
		if successBytes and resultBytes ~= currentCode then
			currentCode = resultBytes
			decodedSomething = true
		end

		-- 3. Giải mã các hàm giải mã chuỗi đơn giản thường gặp trong mã hóa cơ bản (như unescape/base64 tự chế nếu có)
		-- (Phần này có thể mở rộng tùy thuộc vào cấu trúc obfuscator cụ thể mà bạn hay gặp)

		-- Nếu sau một vòng lặp mà không có gì thay đổi nghĩa là đã bóc tách xong tầng cuối cùng
		if not decodedSomething then
			break
		end
	end

	return currentCode
end

-- Sự kiện khi nhấn nút Run
RunButton.MouseButton1Click:Connect(function()
	local rawCode = InputBox.Text
	if rawCode == "" then
		OutputBox.Text = "-- Vui lòng nhập code vào Khung 1 trước!"
		return
	end

	-- Thực hiện quá trình giải mã và bóc tách
	local success, finalResult = pcall(function()
		return recursiveDecode(rawCode)
	end)

	if success then
		OutputBox.Text = finalResult
	else
		OutputBox.Text = "-- Lỗi trong quá trình bóc tách:\n" .. tostring(finalResult)
	end
end)
