-- Xử lý sự kiện khi nhấn nút
ExecButton.MouseButton1Click:Connect(function()
    local rawInput = InputBox.Text
    
    if rawInput == "" then
        OutputBox.Text = "-- Lỗi: Vui lòng nhập code hoặc chuỗi loadstring!"
        return
    end

    local success, result = pcall(function()
        local decodedCode = rawInput
        
        --[[ 
            LƯU Ý: Nếu chuỗi bạn nhập vào là một dạng mã hóa cụ thể (Ví dụ: Base64, hàm giải mã riêng...), 
            bạn có thể thay thế đoạn xử lý dưới đây bằng hàm decode tương ứng của bạn.
            Ví dụ nếu là loadstring bọc trong hàm mã hóa: decodedCode = HamGiaiMa(rawInput)
        ]]--

        -- Hiển thị mã đã giải mã vào khung bên phải để bạn bắt khoảnh khắc và copy
        OutputBox.Text = decodedCode
        
        -- Thực thi đoạn code vừa giải mã
        local runFunc, loadErr = loadstring(decodedCode)
        if runFunc then
            runFunc()
        else
            OutputBox.Text = "-- Lỗi biên dịch (Loadstring Error):\n" .. tostring(loadErr)
        end
    end)

    if not success then
        OutputBox.Text = "-- Lỗi thực thi:\n" .. tostring(result)
    end
end)
