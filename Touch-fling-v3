-- Phần 2: Logic Xử lý (Fling Nhấp Nhả & Target TP Kèm Fling Không Trả Vận Tốc)
local isFlinging = false
local flingConn = nil
local isMinimized = false
local neonBox = nil

-- Biến logic quản lý Target & Chế độ
local currentMode = 1 -- 1: Đơn, 2: Đa
local listType = "White" -- "White" hoặc "Black"
local targetType = "Trước" -- "Trước" hoặc "Sau"

-- Lưu trữ danh sách đã chọn riêng biệt cho từng chế độ
local selectedMode1 = nil
local selectedMode2 = {}

local isTPRunning = false
local tpThread = nil
local savedCollideStates = {}

-- Thông số bù độ trễ & lực fling
local PING_COMPENSATION = 0.16 -- Bù hướng chạy theo vận tốc mục tiêu (giây)
local JITTER_RADIUS = 1.25    -- Quét nhẹ quanh điểm dự đoán khi bật Target TP (studs)
local FLY_HOLD_TIME = 0.45    -- Thời gian bám ép liên tục trên mỗi mục tiêu ở Chế độ 2 (giây)

local function getRoot(char)
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
end

local function resetVelocity(char)
	local root = getRoot(char)
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end

local function toggleNeonVisual(char, root, state)
	if state then
		if char and root and not char:FindFirstChild("NeonFlingVisual") then
			neonBox = Instance.new("SelectionBox")
			neonBox.Name = "NeonFlingVisual"
			neonBox.Adornee = root
			neonBox.Color3 = Color3.fromRGB(0, 255, 100)
			neonBox.LineThickness = 0.05
			neonBox.SurfaceColor3 = Color3.fromRGB(0, 255, 100)
			neonBox.SurfaceTransparency = 0.8
			neonBox.Parent = char
		end
	else
		if neonBox then
			neonBox:Destroy()
			neonBox = nil
		end
		if char then
			local oldVisual = char:FindFirstChild("NeonFlingVisual")
			if oldVisual then oldVisual:Destroy() end
		end
	end
end

local function applyNoclip(char, enable)
	if not char then return end
	if enable then
		table.clear(savedCollideStates)
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				savedCollideStates[part] = part.CanCollide
				part.CanCollide = false
			end
		end
	else
		for part, oldState in pairs(savedCollideStates) do
			if part and part.Parent then
				part.CanCollide = oldState
			end
		end
		table.clear(savedCollideStates)
	end
end

local function getPredictedCFrame(targetRoot, dist, side, t)
	local vel = targetRoot.AssemblyLinearVelocity
	local horizontalVel = Vector3.new(vel.X, 0, vel.Z)
	local predictedPos = targetRoot.Position + (horizontalVel * PING_COMPENSATION)

	if math.abs(vel.Y) > 15 then
		predictedPos += Vector3.new(0, math.clamp(vel.Y * (PING_COMPENSATION * 0.5), -6, 6), 0)
	end

	local lookDir = targetRoot.CFrame.LookVector
	local flatLook = Vector3.new(lookDir.X, 0, lookDir.Z)
	if flatLook.Magnitude < 0.01 then
		flatLook = Vector3.new(0, 0, -1)
	else
		flatLook = flatLook.Unit
	end

	local sideDir = (side == "Trước") and flatLook or -flatLook
	local finalPos = predictedPos + (sideDir * dist)

	-- Quét vi-dao động nhẹ quanh mục tiêu để bắt kịp độ trễ replication
	local jx = math.sin(t * 47) * JITTER_RADIUS
	local jy = math.cos(t * 39) * (JITTER_RADIUS * 0.6)
	local jz = math.cos(t * 53) * JITTER_RADIUS
	finalPos += Vector3.new(jx, jy, jz)

	return CFrame.lookAt(finalPos, predictedPos)
end

-- Fling không trả lại vận tốc từng khung hình (dùng cho Target TP)
local function applySustainedFling(root, t)
	if not root then return end
	local dirX = (math.sin(t * 31) >= 0) and 1 or -1
	local dirZ = (math.cos(t * 29) >= 0) and 1 or -1
	root.AssemblyAngularVelocity = Vector3.new(0, 9999, 0)
	root.AssemblyLinearVelocity = Vector3.new(450000 * dirX, 250000, 450000 * dirZ)
end

-- Cập nhật và vẽ lại danh sách người chơi trong ScrollingFrame
local function updatePlayerList()
	for _, child in ipairs(playerScroll:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local allPlayers = Players:GetPlayers()
	local visibleCount = 0

	for _, p in ipairs(allPlayers) do
		if p ~= plr then
			visibleCount += 1
			local pBtn = Instance.new("TextButton")
			pBtn.Size = UDim2.new(1, -4, 0, 26)
			pBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
			pBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
			pBtn.TextSize = 11
			pBtn.Font = Enum.Font.Gotham
			pBtn.TextXAlignment = Enum.TextXAlignment.Left
			pBtn.Parent = playerScroll
			Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)

			local isSelected = false
			if currentMode == 1 then
				isSelected = (selectedMode1 == p)
			else
				isSelected = (selectedMode2[p] ~= nil)
			end

			local checkMark = isSelected and " [✓] " or " [   ] "
			local displayName = p.DisplayName or p.Name
			pBtn.Text = "  " .. displayName .. " (@" .. p.Name .. ")" .. checkMark

			if isSelected then
				pBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 50)
			end

			pBtn.MouseButton1Click:Connect(function()
				if currentMode == 1 then
					selectedMode1 = (selectedMode1 == p) and nil or p
				else
					selectedMode2[p] = selectedMode2[p] and nil or p
				end
				updatePlayerList()
			end)
		end
	end

	playerScroll.CanvasSize = UDim2.new(0, 0, 0, visibleCount * 29)
end

