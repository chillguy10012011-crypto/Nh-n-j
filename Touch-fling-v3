-- Nút Bật/Tắt Fling chính (Nhấp nhả vận tốc cao & thấp từng khung hình như cũ)
btn.MouseButton1Click:Connect(function()
	isFlinging = not isFlinging
	local char = plr.Character
	local root = getRoot(char)

	if isFlinging then
		if not char or not root then
			btn.Text = "No Character!"
			isFlinging = false
			return
		end
		btn.Text = "Fling: ON (Active)"
		btnStroke.Color = Color3.fromRGB(0, 255, 100)

		toggleNeonVisual(char, root, true)
		applyNoclip(char, true)

		local busy = false
		flingConn = RunService.Heartbeat:Connect(function()
			if busy or not isFlinging then return end
			busy = true

			local currChar = plr.Character
			local currRoot = getRoot(currChar)
			if not currChar or not currRoot then
				busy = false
				return
			end

			-- Khi Target TP đang bật, nhường quyền điều khiển vận tốc cho Target TP
			if isTPRunning then
				busy = false
				return
			end

			for _, part in ipairs(currChar:GetDescendants()) do
				if part:IsA("BasePart") and part.CanCollide then
					savedCollideStates[part] = true
					part.CanCollide = false
				end
			end

			local lastVel = currRoot.AssemblyLinearVelocity
			currRoot.AssemblyLinearVelocity = Vector3.new(500000, 250000, 500000)
			RunService.RenderStepped:Wait()
			if currRoot and currRoot.Parent and isFlinging and not isTPRunning then
				currRoot.AssemblyLinearVelocity = lastVel
			end

			busy = false
		end)
	else
		btn.Text = "Status: OFF"
		btnStroke.Color = Color3.fromRGB(255, 50, 50)
		if flingConn then flingConn:Disconnect(); flingConn = nil end
		toggleNeonVisual(plr.Character, getRoot(plr.Character), false)
		if not isTPRunning then
			resetVelocity(plr.Character)
			applyNoclip(plr.Character, false)
		end
	end
end)

-- Logic Xử lý Target Teleport (Gắn fling không trả vận tốc từng khung hình)
tpBtn.MouseButton1Click:Connect(function()
	isTPRunning = not isTPRunning
	if isTPRunning then
		tpBtn.Text = "Target TP: ON"
		tpStroke.Color = Color3.fromRGB(0, 255, 100)
		applyNoclip(plr.Character, true)

		if tpThread then task.cancel(tpThread) end
		tpThread = task.spawn(function()
			local elapsed = 0
			while isTPRunning do
				local dt = RunService.Heartbeat:Wait()
				elapsed += dt

				local char = plr.Character
				local root = getRoot(char)
				local dist = tonumber(distBox.Text) or 2
				local cycleDelay = math.max(0.05, tonumber(timeBox.Text) or 1)

				if char and root then
					if currentMode == 1 then
						if selectedMode1 and selectedMode1.Character then
							local targetRoot = getRoot(selectedMode1.Character)
							if targetRoot then
								root.CFrame = getPredictedCFrame(targetRoot, dist, targetType, elapsed)
								applySustainedFling(root, elapsed)
							end
						end
					else
						local targetsToTP = {}
						if listType == "White" then
							for _, p in pairs(selectedMode2) do
								if p and p.Parent == Players then
									table.insert(targetsToTP, p)
								end
							end
						else
							for _, p in ipairs(Players:GetPlayers()) do
								if p ~= plr and not selectedMode2[p] then
									table.insert(targetsToTP, p)
								end
							end
						end

						if #targetsToTP > 0 then
							for _, targetP in ipairs(targetsToTP) do
								if not isTPRunning then break end
								local holdUntil = os.clock() + FLY_HOLD_TIME

								while isTPRunning and os.clock() < holdUntil do
									local stepDt = RunService.Heartbeat:Wait()
									elapsed += stepDt

									local currChar = plr.Character
									local currRoot = getRoot(currChar)
									local tRoot = targetP and targetP.Character and getRoot(targetP.Character)
									if currChar and currRoot and tRoot then
										currRoot.CFrame = getPredictedCFrame(tRoot, dist, targetType, elapsed)
										applySustainedFling(currRoot, elapsed)
									else
										break
									end
								end

								local remainWait = cycleDelay - FLY_HOLD_TIME
								if remainWait > 0 and isTPRunning then
									local waitEnd = os.clock() + remainWait
									while isTPRunning and os.clock() < waitEnd do
										local stepDt = RunService.Heartbeat:Wait()
										elapsed += stepDt
										local currRoot = getRoot(plr.Character)
										if currRoot then
											applySustainedFling(currRoot, elapsed)
										end
									end
								end
							end
						else
							task.wait(0.3)
						end
					end
				else
					task.wait(0.3)
				end
			end
		end)
	else
		tpBtn.Text = "Target TP: OFF"
		tpStroke.Color = Color3.fromRGB(255, 50, 50)
		if tpThread then task.cancel(tpThread); tpThread = nil end
		resetVelocity(plr.Character)
		if not isFlinging then
			applyNoclip(plr.Character, false)
		end
	end
end)

