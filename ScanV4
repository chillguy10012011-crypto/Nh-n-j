-- Logic quét script bỏ qua UI, Animation, VFX
BtnScan1.MouseButton1Click:Connect(function()
    for _, child in pairs(ListContainer:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    
    local foundCount = 0
    
    -- Duyệt qua toàn bộ game để tìm Script / LocalScript / ModuleScript
    local function scanRecursive(parent)
        for _, obj in pairs(parent:GetChildren()) do
            if obj:IsA("LuaSourceContainer") then -- Script, LocalScript, ModuleScript
                local nameLower = obj.Name:lower()
                
                -- Bỏ qua các script UI/GUI, Animation, VFX, v.v.
                local isIgnored = nameLower:find("ui") or nameLower:find("gui") or 
                                  nameLower:find("anim") or nameLower:find("vfx") or 
                                  nameLower:find("effect") or nameLower:find("particle") or
                                  nameLower:find("clientcontrol")
                                  
                if not isIgnored then
                    foundCount = foundCount + 1
                    
                    local row = Instance.new("Frame")
                    row.Size = UDim2.new(1, -5, 0, 30)
                    row.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                    row.BorderSizePixel = 0
                    row.Parent = ListContainer
                    
                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.new(0.7, 0, 1, 0)
                    lbl.Position = UDim2.new(0.02, 0, 0, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.Text = "⚠️ [" .. obj.ClassName .. "] " .. obj:GetFullName()
                    lbl.TextColor3 = Color3.fromRGB(255, 100, 100)
                    lbl.Font = Enum.Font.SourceSans
                    lbl.TextSize = 12
                    lbl.TextXAlignment = Enum.TextXAlignment.Left
                    lbl.Parent = row
                    
                    local statusBtn = Instance.new("TextButton")
                    statusBtn.Size = UDim2.new(0.25, 0, 0.8, 0)
                    statusBtn.Position = UDim2.new(0.73, 0, 0.1, 0)
                    statusBtn.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
                    statusBtn.Text = "Nghi vấn lỗi"
                    statusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    statusBtn.Font = Enum.Font.SourceSansBold
                    statusBtn.TextSize = 11
                    statusBtn.Parent = row
                end
            end
            
            -- Tránh quét vào CoreGui hoặc các thành phần hệ thống không cần thiết
            if obj ~= CoreGui and obj ~= Players then
                pcall(function()
                    scanRecursive(obj)
                end)
            end
        end
    end
    
    scanRecursive(Workspace)
    pcall(function() scanRecursive(game:GetService("ReplicatedStorage")) end)
    pcall(function() scanRecursive(game:GetService("ServerScriptService")) end)
    pcall(function() scanRecursive(game:GetService("ServerStorage")) end)
    
    if foundCount == 0 then
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 0, 30)
        lbl.BackgroundTransparency = 1
        lbl.Text = " Không tìm thấy script đáng ngờ nào!"
        lbl.TextColor3 = Color3.fromRGB(100, 255, 100)
        lbl.Font = Enum.Font.SourceSansBold
        lbl.TextSize = 13
        lbl.Parent = ListContainer
    end
end)


