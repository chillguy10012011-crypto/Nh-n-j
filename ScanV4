-- Xử lý logic khi nhấn Scan (2) -> Phân tích lỗ hổng phổ biến và đẩy kết quả sang Khung Output
BtnScan2.MouseButton1Click:Connect(function()
    local codeContent = InputBox.Text
    local analysisResult = "=== KẾT QUẢ QUÉT LỖ HỔNG CODE (SCAN 2) ===\n\n"
    
    if codeContent == "" then
        analysisResult = analysisResult .. "⚠️ Cảnh báo: Khung input đang trống! Vui lòng nhập code để hệ thống phân tích.\n"
    else
        local hasVulnerability = false
        
        -- Kiểm tra lỗi chỉnh sửa thông số Local (Dame, Máu, Tiền, v.v)
        if codeContent:lower():find("health") or codeContent:lower():find("dame") or codeContent:lower():find("damage") or codeContent:lower():find("walkspeed") or codeContent:lower():find("jumppower") then
            analysisResult = analysisResult .. "🔴 [LỖ HỔNG CLIENT-SIDE STATS]: Phát hiện đoạn code can thiệp trực tiếp chỉ số nhân vật ở Client (Máu/Dame/Tốc độ). Hacker có thể dễ dàng sửa đổi các giá trị này nếu không kiểm tra xác thực từ Server.\n\n"
            hasVulnerability = true
        end
        
        -- Kiểm tra lỗ hổng RemoteEvent (Thiếu kiểm tra bảo mật từ Server / FireServer bừa bãi)
        if codeContent:lower():find("fireserver") or codeContent:lower():find("remoteevent") or codeContent:lower():find("onserverevent") then
            analysisResult = analysisResult .. "🔴 [LỖ HỔNG REMOTEEVENT]: Phát hiện gọi hoặc nhận RemoteEvent. Cần kiểm tra xem Server có validate (xác thực) dữ liệu gửi từ Client hay không, tránh việc kẻ xấu gửi gói tin giả mạo để cộng tiền, cộng máu hoặc thực thi lệnh trái phép.\n\n"
            hasVulnerability = true
        end
        
        -- Kiểm tra lỗ hổng Teleport / Dịch chuyển người chơi khác (Hacker dịch chuyển người chơi)
        if codeContent:lower():find("cframe") or codeContent:lower():find("position") or codeContent:lower():find("teleport") then
            analysisResult = analysisResult .. "🟡 [CẢNH BÁO VỊ TRÍ/TELEPORT]: Mã nguồn có can thiệp đến tọa độ (CFrame/Position). Nếu logic này đặt lỏng lẻo ở Client, hacker có thể dịch chuyển (teleport) người chơi khác hoặc dịch chuyển xuyên tường.\n\n"
            hasVulnerability = true
        end
        
        -- Kiểm tra thao tác với LocalScript hoặc thay đổi môi trường người khác
        if codeContent:lower():find("localscript") or codeContent:lower():find("playergui") or codeContent:lower():find("backpack") then
            analysisResult = analysisResult .. "🟡 [THAO TÁC GUI/LOCAL]: Có sự can thiệp vào PlayerGui hoặc Backpack. Kẻ tấn công có thể sửa đổi LocalScript của người khác nếu phân quyền không chặt chẽ.\n\n"
            hasVulnerability = true
        end
        
        if not hasVulnerability then
            analysisResult = analysisResult .. "🟢 Không phát hiện mẫu mã độc hoặc lỗ hổng cơ bản rõ ràng nào trong đoạn code này. Tuy nhiên, hãy luôn kiểm tra cẩn thận các logic liên quan đến Server-Client.\n"
        else
            analysisResult = analysisResult .. "💡 Khuyến nghị: Hãy chuyển các tính toán quan trọng (như trừ máu, cộng tiền, sát thương) về phía Server (Server-Script) thay vì xử lý hoàn toàn ở Client.\n"
        end
    end
    
    -- Cập nhật kết quả vào Khung Output và tự động chuyển sang tab Output
    OutputBox.Text = analysisResult
    for _, s in pairs(slides) do s.Visible = false end
    SlideOutput.Visible = true
end)

