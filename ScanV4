--// =========================
--// ANALYZER
--// =========================

local function has(code, pattern)
    return string.find(code, pattern) ~= nil
end

local function analyze(code)

    local findings = {}
    local summary = {}

    if code == "" or code:match("^%s*$") then
        return "⚠ Bạn chưa nhập code."
    end

    -- Input

    if has(code, "UserInputService") or has(code, "InputBegan") then
        table.insert(findings, "• Có xử lý thao tác bàn phím / chuột / input.")
    end

    if has(code, "MouseButton1Click") or has(code, "MouseButton2Click") then
        table.insert(findings, "• Có xử lý nút GUI bằng chuột.")
    end

    if has(code, "KeyCode") then
        table.insert(findings, "• Có kiểm tra phím được nhấn.")
    end

    -- Character

    if has(code, "WalkSpeed") then
        table.insert(findings, "• Có tác động đến WalkSpeed → liên quan tốc độ nhân vật.")
    end

    if has(code, "JumpPower") or has(code, "JumpHeight") then
        table.insert(findings, "• Có tác động đến khả năng nhảy của nhân vật.")
    end

    if has(code, "Humanoid") then
        table.insert(findings, "• Có tương tác với Humanoid / nhân vật.")
    end

    if has(code, "CFrame") then
        table.insert(findings, "• Có sử dụng CFrame → có thể thao tác vị trí hoặc hướng.")
    end

    if has(code, "Teleport") or has(code, "PivotTo") then
        table.insert(findings, "• Có dấu hiệu di chuyển / teleport nhân vật hoặc object.")
    end

    -- Movement

    if has(code, "BodyVelocity")
        or has(code, "LinearVelocity")
        or has(code, "VectorForce") then

        table.insert(findings,
            "• Có sử dụng lực / vận tốc vật lý → có thể dùng cho bay hoặc di chuyển."
        )
    end

    -- Camera

    if has(code, "CurrentCamera") then
        table.insert(findings,
            "• Có thao tác Camera → có thể thay đổi góc nhìn hoặc camera."
        )
    end

    -- GUI

    if has(code, "ScreenGui")
        or has(code, "Instance.new(\"ScreenGui\")") then

        table.insert(findings,
            "• Có tạo hoặc sử dụng GUI."
        )
    end

    if has(code, "TextButton")
        or has(code, "TextLabel")
        or has(code, "Frame") then

        table.insert(findings,
            "• Có tạo thành phần giao diện."
        )
    end

    -- Loop

    if has(code, "RunService")
        or has(code, "Heartbeat")
        or has(code, "RenderStepped")
        or has(code, "Stepped") then

        table.insert(findings,
            "• Có vòng lặp theo thời gian / frame."
        )
    end

    if has(code, "while true")
        or has(code, "while task.wait")
        or has(code, "repeat") then

        table.insert(findings,
            "• Có vòng lặp → một phần code có thể chạy liên tục."
        )
    end

    -- Remote

    if has(code, "FireServer") then
        table.insert(findings,
            "⚠ Có FireServer → code gửi dữ liệu từ client lên server."
        )
    end

    if has(code, "InvokeServer") then
        table.insert(findings,
            "⚠ Có InvokeServer → code gọi RemoteFunction trên server."
        )
    end

    if has(code, "OnClientEvent") then
        table.insert(findings,
            "• Có nhận sự kiện từ server thông qua RemoteEvent."
        )
    end

    -- Dynamic execution

    if has(code, "loadstring") then
        table.insert(findings,
            "⚠ Có loadstring → có khả năng thực thi code động."
        )
    end

    -- HTTP

    if has(code, "HttpGet")
        or has(code, "RequestAsync")
        or has(code, "HttpService") then

        table.insert(findings,
            "⚠ Có dấu hiệu sử dụng HTTP / tải hoặc gửi dữ liệu."
        )
    end

    -- Instance manipulation

    if has(code, "Instance.new") then
        table.insert(findings,
            "• Có tạo Instance mới trong game."
        )
    end

    if has(code, ":Destroy()") then
        table.insert(findings,
            "• Có xóa / Destroy Instance."
        )
    end

    -- ESP / visual clues

    if has(code, "Highlight")
        or has(code, "BillboardGui")
        or has(code, "BoxHandleAdornment") then

        table.insert(findings,
            "• Có thành phần hiển thị thông tin / đánh dấu object."
        )
    end

    -- Targeting

    if has(code, "GetPlayers")
        or has(code, "Players:GetPlayers") then

        table.insert(findings,
            "• Có lấy danh sách người chơi."
        )
    end

    if has(code, "CharacterAdded") then
        table.insert(findings,
            "• Có theo dõi nhân vật khi người chơi spawn."
        )
    end

    -- Final summary

    if #findings == 0 then
        table.insert(findings,
            "Không phát hiện mẫu chức năng phổ biến."
        )
        table.insert(summary,
            "→ Có thể đây là code đơn giản hoặc scanner chưa nhận diện được cách hoạt động của nó."
        )
    else
        table.insert(summary,
            "→ Scanner đã tìm thấy " .. #findings .. " dấu hiệu liên quan."
        )
        table.insert(summary,
            "→ Đây là phân tích tĩnh, nên kết quả mô tả dấu hiệu trong code chứ không đảm bảo chính xác 100%."
        )
    end

    return table.concat(findings, "\n") ..
        "\n\n──────────────\n" ..
        table.concat(summary, "\n")
end

--// Scan

Scan.MouseButton1Click:Connect(function()

    Scan.Text = "SCANNING..."

    task.wait(0.25)

    Result.Text = analyze(CodeBox.Text)

    Scan.Text = "SCAN"
end)

--// =========================
--// DRAG GUI
--// =========================

local dragging = false
local dragStart
local startPos

Title.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1 then

        dragging = true
        dragStart = input.Position
        startPos = Main.Position

        input.Changed:Connect(function()

            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end

        end)
    end
end)

UIS.InputChanged:Connect(function(input)

    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then

        local delta = input.Position - dragStart

        Main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)
